diff --git a/tests/ECON02B2d11SalvageTests.cpp b/tests/ECON02B2d11SalvageTests.cpp
new file mode 100644
index 0000000..b210046
--- /dev/null
+++ b/tests/ECON02B2d11SalvageTests.cpp
@@ -0,0 +1,117 @@
+#include "galaxy/NpcConstructionCrews.hpp"
+#include <chrono>
+#include <filesystem>
+#include <iostream>
+#include <stdexcept>
+using namespace galaxy;
+namespace fs=std::filesystem;
+#define CHECK(x) do{if(!(x))throw std::runtime_error(std::string("d11 line ")+std::to_string(__LINE__)+": " #x);}while(0)
+static void action(PersistentWorld& w,EntityId ship,std::uint64_t id,Action kind,EntityId target=0,
+                   std::int64_t amt=1,int x=0,int y=0){
+ Command c{};c.id=id;c.sequence=id;c.issuer=7;c.actor=ship;c.target=target;c.amount=amt;c.thrust_x=x;c.thrust_y=y;
+ c.action=kind;c.execute_tick=w.world().tick()+1;
+ CHECK(w.submit(c));w.step();CHECK(w.world().events().back().result==Outcome::Applied);
+}
+static std::int64_t custody(const Simulation& sim,EntityId ship,EntityId site){
+ auto total=sim.colony_ship(ship)->modules;
+ if(const auto* s=sim.construction_supplies(site)){
+  total+=s->depot;
+  for(const auto& [_,n]:s->node_modules)total+=n;
+  for(const auto& [_,n]:s->reserved)total+=n.modules;
+  for(const auto& [_,n]:s->carried)total+=n;
+  for(const auto& [_,n]:s->delivered)total+=n;
+ }
+ return total;
+}
+int main(){
+ const auto folder=fs::temp_directory_path()/("sg_d11_"+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+ fs::create_directories(folder);
+ try{
+  const auto db=(folder/"world.sqlite").string();EntityId ship=0,site=0;std::uint64_t npc=0;
+  std::int64_t mass=0,all_modules=0;
+  {
+   Simulation seed(1004);ship=seed.add_colony_ship(7,{0,0},500,8);
+   seed.provision_colony_genesis(ship,1000,3000,1000,1000,1000);
+   auto rock=seed.add_asteroid({1000,0},180);seed.enable_individual_workforce();mass=seed.total_material_kg();
+   PersistentWorld w(db,std::move(seed));
+   action(w,ship,1,Action::Mine,rock,150);action(w,ship,2,Action::RefineOre,0,150);
+   action(w,ship,3,Action::FabricateModule,0,60);action(w,ship,4,Action::ConstructOutpost);
+   site=w.world().built_outposts().begin()->first;
+   action(w,ship,5,Action::ConstructHabitat,site);
+   for(int i=1;i<=3;++i)action(w,ship,5+i,Action::TransferHabitatStock,site,30,i);
+   action(w,ship,9,Action::AssignHabitatResidents,site,1);
+   for(const auto& [id,n]:w.world().npc_records())if(n.location==site&&n.role==NpcRole::Habitat)npc=id;
+   CHECK(npc);
+   action(w,ship,10,Action::ConstructStorage,site);
+   action(w,ship,11,Action::ConstructStorageNode,site,1);
+   action(w,ship,12,Action::PlaceFactoryEquipment,site,1,4,0);
+   construction::Plans plans(db,w);construction::Crews crews(db,w,plans);
+   auto supply=[&](Action a,std::int64_t n,int x=0,int y=0){CHECK(plans.supply_action(a,n,x,y,7,ship,site).result==Outcome::Applied);};
+   supply(Action::StageConstructionModules,2);
+   supply(Action::PickupConstructionModules,npc,2);
+   supply(Action::DepositConstructionNodeModules,npc,1);
+   CHECK(w.world().construction_supplies(site)->node_modules.at(1)==2);
+   const auto reserve=plans.create("sg-colony-structure-plan-v1\n2,12,0\n",7,ship,site);
+   supply(Action::ReserveConstructionModules,reserve,1,1);
+   bool denied=false;
+   try{crews.queue_salvage(npc,1,7,ship,site);}catch(const std::invalid_argument&){denied=true;}
+   CHECK(denied);CHECK(w.world().construction_supplies(site)->reserved.at(reserve).modules==1);
+   supply(Action::ReserveConstructionModules,reserve,1,-1);
+   all_modules=custody(w.world(),ship,site);
+   crews.queue_salvage(npc,1,7,ship,site);
+   CHECK(crews.list_restock(7,ship,site).size()==1 && crews.list_restock(7,ship,site)[0].salvage);
+   bool pickup=false;
+   for(int i=0;i<30;++i){crews.advance(7,ship);
+    auto* s=w.world().construction_supplies(site);
+    if(s&&s->carried.count(npc)){pickup=true;break;}
+    w.step();
+   }
+   CHECK(pickup);
+   CHECK(w.world().construction_supplies(site)->carried.at(npc)==2);
+   CHECK(w.world().construction_supplies(site)->node_modules.count(1)==0);
+   CHECK(custody(w.world(),ship,site)==all_modules);
+   CHECK(w.world().total_material_kg()==mass);
+  }
+  {
+   PersistentWorld w(db,Simulation(1));construction::Plans plans(db,w);construction::Crews crews(db,w,plans);
+   CHECK(w.world().construction_supplies(site)->carried.at(npc)==2);
+   CHECK(crews.list_restock(7,ship,site).at(0).salvage);
+   bool finished=false;
+   for(int i=0;i<40;++i){crews.advance(7,ship);
+    const auto run=crews.list_restock(7,ship,site).at(0);
+    if(!run.active){finished=true;break;}
+    w.step();
+   }
+   CHECK(finished);
+   CHECK(w.world().construction_supplies(site)->depot==2);
+   CHECK(w.world().construction_supplies(site)->carried.count(npc)==0);
+   CHECK(!w.world().construction_supplies(site)->node_modules.count(1));
+   CHECK(custody(w.world(),ship,site)==all_modules);
+   CHECK(w.world().total_material_kg()==mass);
+   // Second trip and cancellation after physical pickup.
+   CHECK(plans.supply_action(Action::PickupConstructionModules,static_cast<std::int64_t>(npc),2,0,7,ship,site).result==Outcome::Applied);
+   CHECK(plans.supply_action(Action::DepositConstructionNodeModules,static_cast<std::int64_t>(npc),1,0,7,ship,site).result==Outcome::Applied);
+   crews.queue_salvage(npc,1,7,ship,site);
+   bool collected=false;
+   for(int i=0;i<40;++i){crews.advance(7,ship);
+    if(w.world().construction_supplies(site)->carried.count(npc)){collected=true;break;}
+    w.step();
+   }
+   CHECK(collected);
+   CHECK(crews.cancel_restock(npc,7,ship,site));
+   bool cancelled=false;
+   for(int i=0;i<40;++i){crews.advance(7,ship);
+    if(!crews.list_restock(7,ship,site).at(0).active){cancelled=true;break;}
+    w.step();
+   }
+   CHECK(cancelled);
+   CHECK(w.world().construction_supplies(site)->depot==2);
+   CHECK(w.world().construction_supplies(site)->carried.count(npc)==0);
+   CHECK(custody(w.world(),ship,site)==all_modules);
+   CHECK(w.world().total_material_kg()==mass);
+  }
+  fs::remove_all(folder);
+  std::cout<<"ECON-02B2d11 PASS: physical source salvage, reservations, restart, cancellation, mass conservation\n";
+  return 0;
+ }catch(const std::exception& e){std::cerr<<"ECON-02B2d11 FAIL: "<<e.what()<<'\n';fs::remove_all(folder);return 1;}
+}
