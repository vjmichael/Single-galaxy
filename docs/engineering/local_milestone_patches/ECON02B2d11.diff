+#include "galaxy/NpcConstructionCrews.hpp"
+#include <chrono>
+#include <filesystem>
+#include <iostream>
+#include <stdexcept>
+using namespace galaxy;
+namespace fs=std::filesystem;
+#define CHECK(x) do{if(!(x))throw std::runtime_error(std::string("d11-order line ")+std::to_string(__LINE__)+": " #x);}while(0)
+static void action(PersistentWorld& w,EntityId ship,std::uint64_t id,Action kind,EntityId target=0,std::int64_t amt=1){
+ Command c{};c.id=id;c.sequence=id;c.issuer=7;c.actor=ship;c.target=target;c.amount=amt;
+ c.action=kind;c.execute_tick=w.world().tick()+1;
+ CHECK(w.submit(c));w.step();CHECK(w.world().events().back().result==Outcome::Applied);
+}
+int main(){
+ const auto folder=fs::temp_directory_path()/("sg_d11orders_"+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+ fs::create_directories(folder);const auto db=(folder/"world.sqlite").string();
+ try{
+ EntityId ship=0,site=0;std::int64_t plan=0,baseline_mass=0,baseline_refined=0;
+ {
+  Simulation seed(1010);ship=seed.add_colony_ship(7,{0,0},500,8);seed.provision_colony_genesis(ship,1000,3000,1000,1000,1000);auto rock=seed.add_asteroid({1000,0},180);seed.enable_individual_workforce();
+  baseline_mass=seed.total_material_kg();
+  PersistentWorld w(db,std::move(seed));
+  action(w,ship,1,Action::Mine,rock,150);action(w,ship,2,Action::RefineOre,0,150);
+  action(w,ship,3,Action::FabricateModule,0,20);action(w,ship,4,Action::ConstructOutpost);
+  site=w.world().built_outposts().begin()->first;
+  baseline_refined=w.world().colony_ship(ship)->refined;
+  construction::Plans plans(db,w);construction::Crews crews(db,w,plans);
+  plan=plans.create("sg-colony-structure-plan-v1\n2,9,0\n",7,ship,site);
+  // Explicitly place all existing modules in real depot to require new
+  // production from the ship's finite refined-ore supply.
+  const auto available=w.world().colony_ship(ship)->modules;
+  CHECK(available>0);
+  CHECK(plans.supply_action(Action::StageConstructionModules,available,0,0,7,ship,site).result==Outcome::Applied);
+  CHECK(w.world().colony_ship(ship)->modules==0);
+  bool denied=false;
+  try{crews.order_supply(plan,2,true,8,ship,site);}catch(const std::invalid_argument&){denied=true;}
+  CHECK(denied);
+  crews.order_supply(plan,2,true,7,ship,site);
+  denied=false;
+  try{crews.order_supply(plan,2,true,7,ship,site);}catch(const std::invalid_argument&){denied=true;}
+  CHECK(denied);
+  crews.advance(7,ship); // stores pending ID BEFORE any world command
+  CHECK(crews.list_supply(7,ship,site).at(0).staged==0);
+  CHECK(w.world().colony_ship(ship)->modules==0);
+  crews.advance(7,ship); // emits real fabrication command; SQL pending
+  CHECK(w.world().colony_ship(ship)->modules==1);
+  CHECK(w.world().colony_ship(ship)->refined==baseline_refined-2);
+  CHECK(crews.list_supply(7,ship,site).at(0).fabricated==0); // pending reconciliation
+  CHECK(w.world().total_material_kg()==baseline_mass);
+ }
+ {
+  PersistentWorld w(db,Simulation(1));construction::Plans plans(db,w);construction::Crews crews(db,w,plans);
+  CHECK(w.world().colony_ship(ship)->modules==1);
+  CHECK(w.world().colony_ship(ship)->refined==baseline_refined-2);
+  // This must reconcile already-applied world receipt, never fabricate twice.
+  crews.advance(7,ship);
+  CHECK(crews.list_supply(7,ship,site).at(0).fabricated==1);
+  bool closed=false;
+  for(int i=0;i<40;++i){
+   crews.advance(7,ship);
+   const auto o=crews.list_supply(7,ship,site).at(0);
+   if(!o.active && o.staged==2){closed=true;break;}+   w.step();
+  }
+  CHECK(closed);
+  auto order=crews.list_supply(7,ship,site).at(0);
+  CHECK(order.approved==2&&order.staged==2&&order.fabricated==2);
+  CHECK(w.world().colony_ship(ship)->modules==0);
+  CHECK(w.world().colony_ship(ship)->refined==baseline_refined-4);
+  CHECK(w.world().total_material_kg()==baseline_mass);
+  CHECK(!crews.cancel_supply(plan,7,ship,site));
+ }
+ {
+  PersistentWorld w(db,Simulation(2));construction::Plans plans(db,w);construction::Crews crews(db,w,plans);
+  for(int i=0;i<5;++i){crews.advance(7,ship);w.step();}
+  const auto o=crews.list_supply(7,ship,site).at(0);
+  CHECK(!o.active && o.approved==2 && o.staged==2 && o.fabricated==2);
+  CHECK(w.world().colony_ship(ship)->refined==baseline_refined-4);
+  CHECK(w.world().total_material_kg()==baseline_mass);
+ }
+ fs::remove_all(folder);
+ std::cout<<"ECON-02B2d11 PASS: authorized bounded ore fabrication, durable outbox, restart exactly once, mass conservation\n";
+ return 0;
+ }catch(const std::exception& e){std::cerr<<"ECON-02B2d11 ORDERS FAIL: "<<e.what()<<'\n';fs::remove_all(folder);return 1;}
+}
