@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+"""Host-authorized structural plan, step, cancel, door and restart via real HTTP."""
+import argparse, http.client, json, pathlib, socket, subprocess, sys, tempfile, time
+p=argparse.ArgumentParser()
+for x in ('host','fixture','relay'):p.add_argument('--'+x,required=True)
+a=p.parse_args()
+def port():
+    with socket.socket() as sock:
+        sock.bind(('127.0.0.1',0));return sock.getsockname()[1]
+class Game:
+    def __init__(self,world):
+        self.port=port()
+        self.p=subprocess.Popen([sys.executable,a.relay,'--colony','--host-exe',a.host,'--save',str(world),
+          '--port',str(self.port),'--tick-ms','100','--max-ticks','1200'],stdin=subprocess.DEVNULL,
+          stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+        for i in range(90):
+            if self.p.poll() is not None:raise AssertionError('Host quit early')
+            try:
+                if self.get('/healthz')[0]==200:break
+            except OSError:pass
+            time.sleep(.05)
+        else:raise AssertionError('Relay failed to start')
+    def req(self,method,path,doc=None,headers=None):
+        c=http.client.HTTPConnection('127.0.0.1',self.port,timeout=10)
+        body=json.dumps(doc,separators=(',',':')).encode() if doc is not None else None
+        h={'Host':'127.0.0.1:'+str(self.port),**(headers or {})}
+        if body is not None:
+            h.setdefault('Content-Type','application/json')
+            h.setdefault('Origin','http://127.0.0.1:'+str(self.port))
+        try:
+            c.request(method,path,body,headers=h);r=c.getresponse();data=r.read()
+            if r.getheader('Content-Type')=='application/json':return r.status,json.loads(data)
+            return r.status,data.decode('utf-8')
+        finally:c.close()
+    def get(self,path):return self.req('GET',path)
+    def post(self,path,doc,headers=None):return self.req('POST',path,doc,headers)
+    def close(self):
+        self.p.terminate()
+        try:self.p.communicate(timeout=6)
+        except subprocess.TimeoutExpired:self.p.kill();self.p.communicate(timeout=6)
+with tempfile.TemporaryDirectory(prefix='sg-structure-live-') as tmp:
+    save=pathlib.Path(tmp)/'w.sqlite'
+    r=subprocess.run([a.fixture,str(save)],capture_output=True,text=True,timeout=10)
+    assert r.returncode==0,r.stderr
+    game=Game(save)
+    try:
+        status,session=game.get('/session');assert status==200
+        status,html=game.get('/viewer/interactive.html')
+        assert status==200 and 'Colony structures' in html and 'structures.js' in html,(status,len(html))
+        status,js=game.get('/viewer/structures.js')
+        assert status==200 and 'structure_step' in js,(status,len(js))
+        token=session['token'];status,sites=game.get('/factory/api/sites');assert status==200 and len(sites['sites'])==1
+        site=sites['sites'][0]
+        layout='sg-colony-structure-plan-v1\n1,0,0\n2,0,0\n4,1,0\n'
+        doc={'token':token,'site':site,'layout':layout}
+        status,bad=game.post('/factory/api/structure_register',doc,{'Origin':'https://evil.example'})
+        assert status==403 and not bad['ok'],(status,bad)
+        status,bad=game.post('/factory/api/structure_register',dict(doc,token='forged'))
+        assert status==403,(status,bad)
+        status,bad=game.post('/factory/api/structure_register',dict(doc,site=999999))
+        assert status==400,(status,bad)
+        status,bad=game.post('/factory/api/structure_register',dict(doc,layout=layout+'2,0,0\n'))
+        assert status==400,(status,bad)
+        status,reg=game.post('/factory/api/structure_register',doc)
+        assert status==200 and reg['plan']['total']==3,(status,reg)
+        pid=reg['plan']['id']
+        for i in range(2):
+            status,ev=game.post('/factory/api/structure_step',{'token':token,'site':site,'id':pid})
+            assert status==200 and ev['event']['applied'] and ev['plan']['completed']==i+1,(status,ev)
+        status,listing=game.get('/factory/api/structures?site='+str(site))
+        assert status==200 and len(listing['structures'])==2,(status,listing)
+        assert listing['plans'][0]['completed']==2
+        status,cancel=game.post('/factory/api/structure_cancel',{'token':token,'site':site,'id':pid})
+        assert status==200 and cancel['plan']['cancelled']
+        status,denied=game.post('/factory/api/structure_step',{'token':token,'site':site,'id':pid})
+        assert status==400 and not denied['ok']
+        status,new=game.post('/factory/api/structure_register',{'token':token,'site':site,
+           'layout':'sg-colony-structure-plan-v1\n4,1,0\n'})
+        assert status==200,(status,new)
+        newpid=new['plan']['id']
+        status,last=game.post('/factory/api/structure_step',{'token':token,'site':site,'id':newpid})
+        assert status==200 and last['plan']['finished'],(status,last)
+        status,door=game.post('/factory/api/structure_door',{'token':token,'site':site,'kind':4,'x':1,'y':0,'open':True})
+        assert status==200 and door['event']['applied'],(status,door)
+    finally:game.close()
+    game=Game(save)
+    try:
+        status,found=game.get('/factory/api/structures?site='+str(site))
+        assert status==200 and len(found['structures'])==3 and len(found['plans'])==2,(status,found)
+        assert found['plans'][0]['cancelled'] and found['plans'][0]['completed']==2
+        assert found['plans'][1]['finished']
+        assert next(x for x in found['structures'] if x['kind']==4)['open']
+        status,door=game.post('/factory/api/structure_door',{'token':game.get('/session')[1]['token'],
+          'site':site,'kind':4,'x':1,'y':0,'open':False})
+        assert status==200 and door['event']['applied'],(status,door)
+    finally:game.close()
+    print('ECON02B2d5 PASS: real localhost, host identity, durable partial/cancel, door toggle and recovery')
