+"""ECON-02B2d5 offline Chromium DOM acceptance (transport API mocked).
+A separate Python HTTP-to-native test verifies real authorization, SQLite and effects.
+"""
+from pathlib import Path
+from playwright.sync_api import sync_playwright
+
+root=Path(__file__).resolve().parents[1]
+html=(root/'viewer/interactive.html').read_text()
+# Only load physical structure UI; the full replay handlers are independently
+# tested, and the native control path is exercised in StructureHostTests.py.
+import re
+html=re.sub(r'<script src="[^\"]+"></script>', '', html)
+with sync_playwright() as pw:
+    browser=pw.chromium.launch(headless=True, executable_path='/usr/bin/chromium',
+        args=['--no-sandbox','--disable-dev-shm-usage'])
+    page=browser.new_page(viewport={'width':1120,'height':900})
+    problems=[]
+    page.on('pageerror',lambda error:problems.append(str(error)))
+    page.set_content(html)
+    page.locator('#colonyPanel').evaluate('n=>n.hidden=false')
+    page.add_script_tag(content=r'''
+    window.__demo={plans:[],pieces:[],next:1};
+    window.fetch=async (path,request)=>{
+      const state=window.__demo;
+      let data={ok:true};
+      if(path==='/session')data={token:'TEST_SESSION',colony_mode:true};
+      else if(path==='/factory/api/sites')data={ok:true,sites:[21]};
+      else if(path.startsWith('/factory/api/structures?site='))
+        data={ok:true,structures:state.pieces,plans:state.plans};
+      else if(path==='/factory/api/structure_register'){
+        const req=JSON.parse(request.body),steps=req.layout.trim().split('\n').slice(1).map(s=>s.split(',').map(Number));
+        const p={id:state.next++,site:req.site,completed:0,total:steps.length,
+          modulesRemaining:steps.reduce((n,s)=>n+(s[0]===1?1:2),0),cancelled:false,conflicting:false,finished:false,reason:'',steps};
+        state.plans.push(p);data={ok:true,plan:p};
+      }else if(path==='/factory/api/structure_step'){
+        const req=JSON.parse(request.body),p=state.plans.find(x=>x.id===req.id);
+        const [kind,x,y]=p.steps[p.completed++];
+        state.pieces.push({kind,x,y,open:false,commandId:p.completed});
+        p.modulesRemaining-=kind===1?1:2;p.finished=p.completed===p.total;
+        data={ok:true,event:{applied:true},plan:p};
+      }else if(path==='/factory/api/structure_cancel'){
+        const req=JSON.parse(request.body),p=state.plans.find(x=>x.id===req.id);
+        p.cancelled=true;data={ok:true,plan:p};
+      }else if(path==='/factory/api/structure_door'){
+        const req=JSON.parse(request.body),piece=state.pieces.find(x=>x.kind===req.kind&&x.x===req.x&&x.y===req.y);
+        piece.open=req.open;data={ok:true,event:{applied:true}};
+      }else throw Error('Unexpected mock route: '+path);
+      return {ok:true,json:async()=>data};
+    };
+    ''')
+    page.add_script_tag(content=(root/'viewer/structures.js').read_text())
+    page.wait_for_function("document.querySelector('#structureSite').value==='21'")
+    assert 'No physical' in page.locator('#structureBuilt').inner_text()
+    page.locator('#structureAuthorize').click()
+    page.wait_for_function('window.__demo.plans.length===1')
+    for num in (1,2,3):
+        page.locator('#structureBuildNext').click()
+        page.wait_for_function(f'window.__demo.plans[0].completed==={num}')
+    assert 'East door (1,0)' in page.locator('#structureBuilt').inner_text()
+    page.locator('#structureOpenDoor').click()
+    page.wait_for_function('window.__demo.pieces[2].open===true')
+    page.locator('#structureCloseDoor').click()
+    page.wait_for_function('window.__demo.pieces[2].open===false')
+    page.locator('#structureLayout').fill('1,7,0\n2,7,0')
+    page.locator('#structureAuthorize').click()
+    page.wait_for_function('window.__demo.plans.length===2')
+    page.locator('#structureBuildNext').click()
+    page.wait_for_function('window.__demo.plans[1].completed===1')
+    page.locator('#structureCancel').click()
+    page.wait_for_function('window.__demo.plans[1].cancelled===true')
+    assert page.locator('#structureMap').evaluate('n=>n.getContext("2d").getImageData(4,4,1,1).data[3]')==255
