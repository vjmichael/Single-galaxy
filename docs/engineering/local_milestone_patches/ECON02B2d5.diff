+      CHECK(w.world().structure_edge_passable(site,1,0,2,0));
+      ok(w,ship,11,Action::SetColonyDoor,site,4,1,0); // close
+      CHECK(!w.world().structure_edge_passable(site,1,0,2,0));
+      CHECK(cmd(w,ship,12,Action::SetColonyDoor,site,5,1,0).result==Outcome::InvalidTarget);
+      CHECK(w.world().colony_fixtures(site).size()==3);
+      CHECK(w.world().total_material_kg()==mass);
+      snapshot=w.world().canonical_state();
+      CHECK(snapshot.rfind("galaxy-kernel-v31|",0)==0);
+      CHECK(Simulation::from_snapshot(snapshot).canonical_state()==snapshot);
+      // Tampering fixture mass without a corresponding resource transfer is rejected.
+      auto altered=snapshot;
+      auto first=altered.find("colony_fixture|");CHECK(first!=std::string::npos);
+      auto end=altered.find('\n',first);CHECK(end!=std::string::npos);
+      auto line=altered.substr(first,end-first);
+      auto last=line.rfind("|0");CHECK(last!=std::string::npos);
+      auto mass_pos=line.rfind('|',last-1);CHECK(mass_pos!=std::string::npos);
+      line.replace(mass_pos+1,last-mass_pos-1,"999");
+      altered.replace(first,end-first,line);
+      bool rejected=false;try{(void)Simulation::from_snapshot(altered);}catch(const std::exception&){rejected=true;}
+      CHECK(rejected);
+    }
+    {
+      PersistentWorld w(db,Simulation(999));
+      CHECK(w.world().canonical_state()==snapshot);
+      CHECK(w.world().colony_fixtures(site).size()==3);
+      CHECK(!w.world().structure_edge_passable(site,1,0,2,0));
+      CHECK(w.world().total_material_kg()==mass);
+      ok(w,ship,13,Action::SetColonyDoor,site,14,1,0);
+      CHECK(w.world().structure_edge_passable(site,1,0,2,0));
+      CHECK(w.world().total_material_kg()==mass);
+    }
+    {
+      PersistentWorld w(db,Simulation(999));
+      CHECK(w.world().structure_edge_passable(site,1,0,2,0));
+      CHECK(w.world().total_material_kg()==mass);
+    }
+    fs::remove_all(dir);
+    std::cout<<"ECON-02B2d5 PASS: physical floor/wall/door module costs, collision, receipts, restart\n";
+    return 0;
+  }catch(const std::exception& e){
+    std::cerr<<"ECON-02B2d5 FAIL: "<<e.what()<<'\n';fs::remove_all(dir);return 1;
+  }
+}
