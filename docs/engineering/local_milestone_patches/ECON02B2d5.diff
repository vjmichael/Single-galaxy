diff --git a/viewer/structures.js b/viewer/structures.js
new file mode 100644
index 0000000..7474af8
--- /dev/null
+++ b/viewer/structures.js
@@ -0,0 +1,127 @@
+/* ECON-02B2d5 — colony-owned structural plans, not a second world writer. */
+(function(){'use strict';
+const $=id=>document.getElementById(id);
+let site=null, token='', listing={structures:[],plans:[]}, active=false;
+function feedback(text){$('structureStatus').textContent=text;}
+async function json(path,body){
+ const response=await fetch(path,body===undefined?{cache:'no-store'}:{
+  method:'POST',headers:{'Content-Type':'application/json'},
+  body:JSON.stringify({...body,token})});
+ const result=await response.json();
+ if(!response.ok || !result.ok && path!=='/session')throw Error(result.error||'Action was not accepted');
+ return result;
+}
+function option(value,label){const n=document.createElement('option');n.value=String(value);n.textContent=label;return n;}
+function structureName(kind){return ({1:'Floor',2:'East wall',3:'North wall',4:'East door',5:'North door'})[kind]||'Unknown';}
+function draw(){
+ const canvas=$('structureMap');const ctx=canvas.getContext('2d');
+ if(!ctx)return;
+ const w=canvas.width,h=canvas.height;
+ ctx.clearRect(0,0,w,h);ctx.fillStyle='#091b2d';ctx.fillRect(0,0,w,h);
+ const structs=listing.structures;
+ // The camera is a viewport, NOT a fixed boundary on allowed construction.
+ const xs=structs.flatMap(s=>[s.x,s.x+1]);
+ const ys=structs.flatMap(s=>[s.y,s.y+1]);
+ const xMin=Math.min(0,...xs),xMax=Math.max(1,...xs);
+ const yMin=Math.min(0,...ys),yMax=Math.max(1,...ys);
+ const span=Math.max(xMax-xMin,yMax-yMin,1);
+ const pitch=Math.max(0.001,Math.min(30,(Math.min(w,h)-38)/(span+1)));
+ const ox=(w-(xMax-xMin)*pitch)/2,oy=(h-(yMax-yMin)*pitch)/2;
+ const px=x=>ox+(x-xMin)*pitch,py=y=>oy+(yMax-y)*pitch;
+ if(span<=24){
+  ctx.strokeStyle='#20334a';ctx.lineWidth=.8;
+  for(let x=xMin;x<=xMax;x++){ctx.beginPath();ctx.moveTo(px(x),0);ctx.lineTo(px(x),h);ctx.stroke();}
+  for(let y=yMin;y<=yMax;y++){ctx.beginPath();ctx.moveTo(0,py(y));ctx.lineTo(w,py(y));ctx.stroke();}
+ }
+ for(const s of structs.filter(s=>s.kind===1)){
+  ctx.fillStyle='#22566b';ctx.fillRect(px(s.x)+2,py(s.y+1)+2,Math.max(0,pitch-4),Math.max(0,pitch-4));
+ }
+ ctx.lineCap='round';
+ for(const s of structs.filter(s=>s.kind!==1)){
+  ctx.beginPath();ctx.lineWidth=Math.max(2,Math.min(5,pitch/6));
+  ctx.strokeStyle=s.kind>=4?(s.open?'#63e7a8':'#ffc16f'):'#b0c2df';
+  if(s.kind===2||s.kind===4){ctx.moveTo(px(s.x+1),py(s.y));ctx.lineTo(px(s.x+1),py(s.y+1));}
+  else{ctx.moveTo(px(s.x),py(s.y+1));ctx.lineTo(px(s.x+1),py(s.y+1));}
+  ctx.stroke();
+ }
+ ctx.font='11px system-ui';ctx.fillStyle='#a9bdd6';
+ ctx.fillText('Blue: floor  ·  White: wall',9,h-24);
+ ctx.fillText('Amber: closed door  ·  Green: open',9,h-9);
+}
+function render(){
+ draw();
+ const plans=$('structurePlan');const oldPlan=plans.value;
+ plans.replaceChildren(option('','Select plan'));
+ for(const p of listing.plans){
+  const state=p.cancelled?'cancelled':p.finished?'complete':p.conflicting?'blocked':'active';
+  plans.append(option(p.id,`#${p.id} · ${p.completed}/${p.total} · ${state}`));
+ }
+ plans.value=listing.plans.some(p=>String(p.id)===oldPlan)?oldPlan:
+  String((listing.plans.find(p=>!p.cancelled&&!p.finished&&!p.conflicting)||listing.plans.at(-1)||{}).id||'');
+ const doors=$('structureDoor');const selected=doors.value;
+ doors.replaceChildren(option('','Select built door'));
+ for(const s of listing.structures.filter(s=>s.kind===4||s.kind===5))
+  doors.append(option(`${s.kind},${s.x},${s.y}`,`${structureName(s.kind)} (${s.x},${s.y}) · ${s.open?'open':'closed'}`));
+ doors.value=listing.structures.some(s=>[4,5].includes(s.kind)&&`${s.kind},${s.x},${s.y}`===selected)?selected:
+  (doors.options.length>1?doors.options[1].value:'');
+ $('structureBuilt').textContent=listing.structures.length?
+  `Built (${listing.structures.length}):\n`+listing.structures.map(s=>
+   `${structureName(s.kind)} (${s.x},${s.y})${[4,5].includes(s.kind)?s.open?' · open':' · closed':''}`).join('\n'):
+  'No physical floors, walls or doors at this outpost.';
+}
+async function refresh(){
+ const session=await json('/session');active=!!session.colony_mode;
+ if(!active){feedback('Physical construction is only available in colony mode.');return;}
+ token=session.token;
+ const sites=await json('/factory/api/sites');const sel=$('structureSite'),old=sel.value;
+ sel.replaceChildren(option('','Select a built outpost'));
+ for(const id of sites.sites)sel.append(option(id,`Outpost #${id}`));
+ sel.value=sites.sites.some(id=>String(id)===old)?old:sites.sites.length?String(sites.sites[0]):'';
+ site=sel.value?Number(sel.value):null;
+ if(!site){listing={structures:[],plans:[]};render();feedback('Build your first colony outpost before constructing structures.');return;}
+ listing=await json('/factory/api/structures?site='+site);
+ render();
+ const activePlan=listing.plans.find(p=>!p.cancelled&&!p.finished);
+ feedback(`Outpost #${site} · ${listing.structures.length} built pieces · ${listing.plans.length} plans`+
+  (activePlan?`\nPlan #${activePlan.id}: ${activePlan.completed}/${activePlan.total}, ${activePlan.modulesRemaining} modules remaining${activePlan.conflicting?' · placement conflict':''}`:''));
+}
+async function submit(path,payload){
+ try{if(!site)throw Error('Build an outpost and select it first');
+  feedback('Submitting to authoritative colony simulation…');
+  const r=await json(path,{site,...payload});
+  await refresh();
+  if(path.endsWith('register'))$('structurePlan').value=String(r.plan.id);
+  feedback(path.endsWith('register')?`Authorized plan #${r.plan.id} for outpost #${site}.`:
+   path.endsWith('step')?`Construction ${r.event.applied?'committed':'rejected'}; ${r.plan.completed}/${r.plan.total} steps complete.`:
+   path.endsWith('cancel')?'Remaining plan steps cancelled; completed structures remain.':
+   'Door state committed in the colony simulation.');
+ }catch(err){feedback('Construction rejected: '+err.message);}
+}
+$('structureRefresh').addEventListener('click',()=>refresh().catch(e=>feedback('Refresh failed: '+e.message)));
+$('structureSite').addEventListener('change',async()=>{
+ try{site=Number($('structureSite').value)||null;
+  if(!site){listing={structures:[],plans:[]};render();return;}
+  listing=await json('/factory/api/structures?site='+site);render();feedback('Selected outpost #'+site);
+ }catch(e){feedback('Site unavailable: '+e.message);}
+});
+$('structureAuthorize').addEventListener('click',()=>{
+ const body=$('structureLayout').value.trim();
+ if(!body){feedback('Enter at least one kind,x,y line.');return;}
+ submit('/factory/api/structure_register',{layout:'sg-colony-structure-plan-v1\n'+body+'\n'});
+});
+for(const [button,path] of [['structureBuildNext','structure_step'],['structureCancel','structure_cancel']])
+ $(button).addEventListener('click',()=>{
+  const id=Number($('structurePlan').value);
+  if(!Number.isSafeInteger(id)||id<=0){feedback('Select a construction plan.');return;}
+  submit('/factory/api/'+path,{id});
+ });
+for(const [button,open] of [['structureOpenDoor',true],['structureCloseDoor',false]])
+ $(button).addEventListener('click',()=>{
+  const selected=$('structureDoor').value;
+  if(!selected){feedback('Select a built door.');return;}
+  const [kind,x,y]=selected.split(',').map(Number);
+  submit('/factory/api/structure_door',{kind,x,y,open});
+ });
+window.GalaxyColonyStructures={refresh};
+refresh().catch(e=>feedback('Structure controls unavailable: '+e.message));
+})();