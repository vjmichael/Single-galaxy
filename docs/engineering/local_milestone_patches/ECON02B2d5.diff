+#pragma once
+// ECON-02B2d5: durable, host-authorized one-piece-at-a-time structural plans.
+// Untrusted plan text never supplies session owner, ship identity, command ID,
+// world path, materials or authority. Each successful step is a real World action.
+#include "galaxy/Persistence.hpp"
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+namespace galaxy::construction {
+struct Step { FixtureKind kind=FixtureKind::Floor;int x=0,y=0; };
+struct Status {
+    std::int64_t id=0;
+    EntityId site=0;
+    std::size_t completed=0,total=0;
+    std::int64_t modules_remaining=0;
+    bool cancelled=false,conflicting=false;
+    std::string reason;
+    bool finished()const{return !cancelled && !conflicting && completed==total;}
+};
+class Plans {
+public:
+    Plans(const std::string& database,PersistentWorld& world);
+    ~Plans();
+    Plans(const Plans&)=delete;Plans& operator=(const Plans&)=delete;
+    static std::vector<Step> parse(const std::string& canonical);
+    std::int64_t create(const std::string& canonical,PlayerId owner,EntityId ship,EntityId site);
+    Status status(std::int64_t id,PlayerId owner,EntityId ship,EntityId site)const;
+    std::vector<Status> list(PlayerId owner,EntityId ship,EntityId site)const;
+    bool cancel(std::int64_t id,PlayerId owner,EntityId ship,EntityId site);
+    Event step(std::int64_t id,PlayerId owner,EntityId ship,EntityId site);
+    // Host-only door actuator, same authenticated identity and durable receipt.
+    Event set_door(PlayerId owner,EntityId ship,EntityId site,
+                   FixtureKind door,int x,int y,bool opened);
+private:
+    class Db;
+    std::unique_ptr<Db> db_;
+    PersistentWorld& world_;
+    std::int64_t fresh_id();
+    void authorize(PlayerId owner,EntityId ship,EntityId site)const;
+    Event submit(std::int64_t command_id,PlayerId owner,EntityId ship,EntityId site,
+                 Action action,std::int64_t amount,int x,int y);
+};
+} // namespace galaxy::construction
