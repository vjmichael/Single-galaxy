+constexpr std::int64_t kStructureCmdBase=600000000000000000LL;
+std::mutex lifecycle;
+void exec(sqlite3* db,const char* sql){
+    char* error=nullptr;
+    if(sqlite3_exec(db,sql,nullptr,nullptr,&error)!=SQLITE_OK){
+        std::string what=error?error:"SQLite error";sqlite3_free(error);throw std::runtime_error(what);
+    }
+}
+class Stmt {
+public:
+    Stmt(sqlite3* db,const char* sql):db_(db){
+        if(sqlite3_prepare_v2(db,sql,-1,&stmt_,nullptr)!=SQLITE_OK)throw std::runtime_error(sqlite3_errmsg(db));
+    }
+    ~Stmt(){sqlite3_finalize(stmt_);}
+    void num(int n,std::int64_t v){if(sqlite3_bind_int64(stmt_,n,v)!=SQLITE_OK)throw std::runtime_error("SQL bind failed");}
+    void str(int n,const std::string& s){if(sqlite3_bind_text(stmt_,n,s.data(),static_cast<int>(s.size()),SQLITE_TRANSIENT)!=SQLITE_OK)throw std::runtime_error("SQL text bind failed");}
+    bool row(){int r=sqlite3_step(stmt_);if(r==SQLITE_ROW)return true;if(r==SQLITE_DONE)return false;throw std::runtime_error(sqlite3_errmsg(db_));}
+    void finish(){if(row())throw std::runtime_error("Unexpected SQL result");}
+    std::int64_t num(int n)const{return sqlite3_column_int64(stmt_,n);}
+    std::string str(int n)const {const auto* p=sqlite3_column_text(stmt_,n);return p?reinterpret_cast<const char*>(p):"";}
+private:sqlite3* db_;sqlite3_stmt* stmt_=nullptr;
+};
+int signed_int(const std::string& s,int min,int max){
+    if(s.empty() || s[0]=='+')throw std::invalid_argument("Noncanonical coordinate");
+    std::size_t pos=0;auto n=std::stoll(s,&pos);
+    if(pos!=s.size() || n<min || n>max || std::to_string(n)!=s)
+        throw std::invalid_argument("Invalid construction coordinate/kind");
+    return static_cast<int>(n);
+}
+std::uint8_t layer(FixtureKind kind){
+    switch(kind){case FixtureKind::Floor:return 0;
+      case FixtureKind::WallEast:case FixtureKind::DoorEast:return 1;
+      case FixtureKind::WallNorth:case FixtureKind::DoorNorth:return 2;}
+    throw std::invalid_argument("Invalid structure kind");
+}
+std::string signature(PlayerId owner,EntityId ship,EntityId site,const std::string& text){
+    // Corruption detection; the trusted SQLite file/OS writer lease are the
+    // authority boundary. This checksum is not cryptographic authentication.
+    const auto data="sg-structure-plan-v1|"+std::to_string(owner)+"|"+
+        std::to_string(ship)+"|"+std::to_string(site)+"|"+text;
+    std::uint64_t hash=14695981039346656037ULL;
+    for(unsigned char c:data){hash^=c;hash*=1099511628211ULL;}
+    return std::to_string(hash);
+}
+struct Record {std::int64_t id=0;PlayerId owner=0;EntityId ship=0,site=0;std::string text;bool cancelled=false;};
+}
+class Plans::Db {
+public:
+    explicit Db(const std::string& path){
+        if(sqlite3_open_v2(path.c_str(),&db_,SQLITE_OPEN_READWRITE,nullptr)!=SQLITE_OK){
+            const auto why=db_?sqlite3_errmsg(db_):"Cannot open SQLite";
+            const std::string error(why);sqlite3_close(db_);db_=nullptr;throw std::runtime_error(error);
+        }
+        sqlite3_busy_timeout(db_,5000);
+        exec(db_,"PRAGMA foreign_keys=ON");
+        exec(db_,"CREATE TABLE IF NOT EXISTS sg_structure_plans("
+                 "id INTEGER PRIMARY KEY AUTOINCREMENT,owner INTEGER NOT NULL,"
+                 "ship INTEGER NOT NULL,site INTEGER NOT NULL,steps TEXT NOT NULL,"
+                 "checksum TEXT NOT NULL,cancelled INTEGER NOT NULL DEFAULT 0 CHECK(cancelled IN (0,1)))");
+        exec(db_,"CREATE TABLE IF NOT EXISTS sg_structure_attempts("
+                 "command_id INTEGER PRIMARY KEY,plan_id INTEGER NOT NULL REFERENCES sg_structure_plans(id),"
+                 "step_index INTEGER NOT NULL CHECK(step_index>=0))");
+        exec(db_,"CREATE TABLE IF NOT EXISTS sg_structure_seq("
+                 "id INTEGER PRIMARY KEY CHECK(id=1),next INTEGER NOT NULL)");
+        exec(db_,"INSERT OR IGNORE INTO sg_structure_seq(id,next) VALUES(1,600000000000000000)");
+    }
+    ~Db(){sqlite3_close(db_);}
+    sqlite3* get()const{return db_;}
+    void begin(){exec(db_,"BEGIN IMMEDIATE");}
+    void commit(){exec(db_,"COMMIT");}
+    void rollback()noexcept{sqlite3_exec(db_,"ROLLBACK",nullptr,nullptr,nullptr);}
+    Record get(std::int64_t id)const {
+        Stmt q(db_,"SELECT owner,ship,site,steps,checksum,cancelled FROM sg_structure_plans WHERE id=?");q.num(1,id);
+        if(!q.row())throw std::invalid_argument("Unknown structural plan");
+        if(q.num(0)<=0 || q.num(1)<=0 || q.num(2)<=0 || (q.num(5)!=0 && q.num(5)!=1))
+            throw std::runtime_error("Corrupt structure plan identity");
+        Record p{id,static_cast<PlayerId>(q.num(0)),static_cast<EntityId>(q.num(1)),
+                 static_cast<EntityId>(q.num(2)),q.str(3),q.num(5)==1};
+        if(q.str(4)!=signature(p.owner,p.ship,p.site,p.text))
+            throw std::runtime_error("Structure plan integrity mismatch");
+        (void)Plans::parse(p.text);
+        return p;
+    }
+private:sqlite3* db_=nullptr;
+};
+Plans::Plans(const std::string& filename,PersistentWorld& world):db_(std::make_unique<Db>(filename)),world_(world){}
+Plans::~Plans()=default;
+std::vector<Step> Plans::parse(const std::string& text){
+    constexpr const char* header="sg-colony-structure-plan-v1\n";
+    if(text.size()<std::char_traits<char>::length(header)+6 || text.size()>16384 ||
+       text.compare(0,std::char_traits<char>::length(header),header)!=0 || text.back()!='\n' ||
+       text.find('\r')!=std::string::npos || text.find('\0')!=std::string::npos)
+        throw std::invalid_argument("Invalid structural blueprint format");
+    std::istringstream in(text.substr(std::char_traits<char>::length(header)));
+    std::vector<Step> result;std::set<FixtureKey> keys;std::string line;
+    while(std::getline(in,line)){
+        if(line.empty() || result.size()>=512)throw std::invalid_argument("Invalid structure build batch");
+        const auto a=line.find(','),b=line.find(',',a==std::string::npos?a:a+1);
+        if(a==std::string::npos||b==std::string::npos||line.find(',',b+1)!=std::string::npos)
+            throw std::invalid_argument("Invalid structure step");
+        auto type=signed_int(line.substr(0,a),1,5);
+        auto x=signed_int(line.substr(a+1,b-a-1),-1000000,1000000);
+        auto y=signed_int(line.substr(b+1),-1000000,1000000);
+        const auto kind=static_cast<FixtureKind>(type);
+        if(!keys.insert({x,y,layer(kind)}).second)
+            throw std::invalid_argument("Two blueprint pieces share one physical cell/edge");
+        result.push_back({kind,x,y});
+    }
+    if(result.empty())throw std::invalid_argument("Empty structure plan");
+    return result;
+}
+void Plans::authorize(PlayerId owner,EntityId ship,EntityId site)const{
+    const auto* e=world_.world().find(ship);
+    const auto* s=world_.world().find(site);
+    const auto i=world_.world().built_outposts().find(site);
+    if(!owner || !ship || !site || !e || !s || e->owner_id!=owner ||
+       i==world_.world().built_outposts().end() || i->second.source_colony_ship!=ship ||
+       s->owner_id!=owner || !world_.world().colony_ship(ship))
+        throw std::invalid_argument("Invalid structure site or authenticated owner");
+}
+std::int64_t Plans::create(const std::string& canonical,PlayerId owner,EntityId ship,EntityId site){
+    std::lock_guard<std::mutex> guard(lifecycle);
+    authorize(owner,ship,site);(void)parse(canonical);
+    Stmt q(db_->get(),"INSERT INTO sg_structure_plans(owner,ship,site,steps,checksum) VALUES(?,?,?,?,?)");
+    q.num(1,static_cast<std::int64_t>(owner));q.num(2,static_cast<std::int64_t>(ship));
+    q.num(3,static_cast<std::int64_t>(site));q.str(4,canonical);
+    q.str(5,signature(owner,ship,site,canonical));q.finish();
+    return sqlite3_last_insert_rowid(db_->get());
+}
+Status Plans::status(std::int64_t id,PlayerId owner,EntityId ship,EntityId site)const{
+    authorize(owner,ship,site);
+    const auto p=db_->get(id);
+    if(p.owner!=owner || p.ship!=ship || p.site!=site)
+        throw std::invalid_argument("Structure plan belongs to another colony session/site");
+    Status result{};result.id=id;result.site=site;result.cancelled=p.cancelled;
+    const auto steps=parse(p.text);result.total=steps.size();
+    const auto& worldpieces=world_.world().colony_fixtures(site);
+    bool gap=false;
+    Stmt attempts(db_->get(),"SELECT step_index,command_id FROM sg_structure_attempts WHERE plan_id=?");
+    attempts.num(1,id);
+    std::map<std::size_t,std::vector<std::uint64_t>> ids;
+    while(attempts.row()){
+        auto index=attempts.num(0),cmd=attempts.num(1);
+        if(index<0 || static_cast<std::size_t>(index)>=steps.size() || cmd<kStructureCmdBase)
+            throw std::runtime_error("Corrupt plan attempt journal");
+        ids[static_cast<std::size_t>(index)].push_back(static_cast<std::uint64_t>(cmd));
+    }
+    for(std::size_t i=0;i<steps.size();++i){
+        const auto& s=steps[i];const auto key=FixtureKey{s.x,s.y,layer(s.kind)};
+        const auto it=worldpieces.find(key);
+        if(it==worldpieces.end()){
+            gap=true;result.modules_remaining+=s.kind==FixtureKind::Floor?1:2;
+            continue;
+        }
+        const auto& attempts_for_step=ids[i];
+        if(it->second.kind!=s.kind || std::find(attempts_for_step.begin(),attempts_for_step.end(),
+                                                it->second.construction_command_id)==attempts_for_step.end()){
+            result.conflicting=true;result.reason="Another command owns an installed structure at this position";
+            break;
+        }
+        if(gap){result.conflicting=true;result.reason="Out-of-order structural construction";break;}
+        ++result.completed;
+    }
+    return result;
+}
+std::vector<Status> Plans::list(PlayerId owner,EntityId ship,EntityId site)const{
+    authorize(owner,ship,site);
+    Stmt q(db_->get(),"SELECT id FROM sg_structure_plans WHERE owner=? AND ship=? AND site=? ORDER BY id LIMIT 200");
+    q.num(1,static_cast<std::int64_t>(owner));q.num(2,static_cast<std::int64_t>(ship));
+    q.num(3,static_cast<std::int64_t>(site));
+    std::vector<Status> result;
+    while(q.row())result.push_back(status(q.num(0),owner,ship,site));
+    return result;
+}
+bool Plans::cancel(std::int64_t id,PlayerId owner,EntityId ship,EntityId site){
+    std::lock_guard<std::mutex> guard(lifecycle);
+    const auto s=status(id,owner,ship,site);
+    if(s.cancelled)return false;
+    Stmt q(db_->get(),"UPDATE sg_structure_plans SET cancelled=1 WHERE id=? AND cancelled=0");
+    q.num(1,id);q.finish();return sqlite3_changes(db_->get())==1;
+}
+std::int64_t Plans::fresh_id(){
+    Stmt q(db_->get(),"SELECT next FROM sg_structure_seq WHERE id=1");
+    if(!q.row())throw std::runtime_error("Missing structure command counter");
+    const auto last=q.num(0);
+    if(last<kStructureCmdBase || last>=std::numeric_limits<std::int64_t>::max()-1)
+        throw std::overflow_error("Structure command namespace exhausted");
+    Stmt update(db_->get(),"UPDATE sg_structure_seq SET next=? WHERE id=1");
+    update.num(1,last+1);update.finish();return last+1;
+}
+Event Plans::submit(std::int64_t command_id,PlayerId owner,EntityId ship,EntityId site,
+        Action action,std::int64_t amount,int x,int y){
+    Command c{};c.id=static_cast<std::uint64_t>(command_id);c.sequence=c.id;
+    c.issuer=owner;c.actor=ship;c.target=site;c.action=action;
+    c.amount=amount;c.thrust_x=x;c.thrust_y=y;c.execute_tick=world_.world().tick()+1;
+    if(!world_.submit(c))throw std::runtime_error("Host refused new structural construction command");
+    world_.step();
+    if(world_.world().events().empty() || world_.world().events().back().command_id!=c.id)
+        throw std::runtime_error("Missing committed structural event receipt");
+    return world_.world().events().back();
+}
+Event Plans::step(std::int64_t id,PlayerId owner,EntityId ship,EntityId site){
+    std::lock_guard<std::mutex> guard(lifecycle);
+    const auto state=status(id,owner,ship,site);
+    if(state.cancelled || state.conflicting || state.finished())
+        throw std::runtime_error("Structural plan cancelled, conflicting or complete: "+state.reason);
+    const auto p=db_->get(id);const auto job=parse(p.text).at(state.completed);
+    db_->begin();std::int64_t next=0;
+    try{
+        next=fresh_id();
+        Stmt j(db_->get(),"INSERT INTO sg_structure_attempts(command_id,plan_id,step_index) VALUES(?,?,?)");
+        j.num(1,next);j.num(2,id);j.num(3,static_cast<std::int64_t>(state.completed));j.finish();
+        db_->commit();
+    }catch(...){db_->rollback();throw;}
+    return submit(next,owner,ship,site,Action::BuildColonyFixture,
+                  static_cast<std::int64_t>(job.kind),job.x,job.y);
+}
+Event Plans::set_door(PlayerId owner,EntityId ship,EntityId site,
+                      FixtureKind kind,int x,int y,bool opened){
+    std::lock_guard<std::mutex> guard(lifecycle);
+    authorize(owner,ship,site);
+    if((kind!=FixtureKind::DoorEast && kind!=FixtureKind::DoorNorth) ||
+       x< -1000000 || x>1000000 || y< -1000000 || y>1000000)
+        throw std::invalid_argument("Invalid door control");
+    db_->begin();std::int64_t id=0;
+    try{id=fresh_id();db_->commit();}catch(...){db_->rollback();throw;}
+    return submit(id,owner,ship,site,Action::SetColonyDoor,
+                  static_cast<std::int64_t>(kind)+(opened?10:0),x,y);
+}
+} // namespace galaxy::construction
