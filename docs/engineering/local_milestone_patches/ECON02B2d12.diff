+   okay(action(w,ship,32,Action::PlaceFactoryEquipment,site,3,12,0));
+   construction::Crews crews(db,w,plans);
+   crews.queue_restock(npc,3,7,ship,site);
+   colony_factory::Control host(db,w,ship,7);
+   bool busy=false;
+   try{host.handle("WAREHOUSE_MARK",site,"3");}catch(const std::invalid_argument&){busy=true;}
+   CHECK(busy);
+   CHECK(crews.cancel_restock(npc,7,ship,site));
+   const auto listed=host.handle("CREW_LIST",site,"");
+   CHECK(listed.find("\"sources\"")!=std::string::npos);
+   const auto marked=host.handle("WAREHOUSE_MARK",site,"3");
+   CHECK(marked.find("\"applied\":true")!=std::string::npos);
+   CHECK(w.world().storage(site)->decommissioned_nodes.count(3));
+   colony_factory::Control wrong(db,w,ship,8);
+   bool forbidden=false;
+   try{wrong.handle("WAREHOUSE_DEMOLISH",site,"3");}catch(const std::invalid_argument&){forbidden=true;}
+   CHECK(forbidden);
+   const auto demolished=host.handle("WAREHOUSE_DEMOLISH",site,"3");
+   CHECK(demolished.find("\"applied\":true")!=std::string::npos);
+   CHECK(!w.world().storage(site)->extra_bins.count(3));
+   CHECK(w.world().total_material_kg()==original_mass);
+  }
+  fs::remove_all(folder);
+  std::cout<<"ECON-02B2d12 PASS: staged marking, reservation & stock blockers, physical recovery, demolition, link blocker, SQL restart, conservation\n";
+  return 0;
+ }catch(const std::exception& e){std::cerr<<"ECON-02B2d12 FAIL: "<<e.what()<<'\n';fs::remove_all(folder);return 1;}
+}
