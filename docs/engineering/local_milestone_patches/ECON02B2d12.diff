+#!/usr/bin/env python3
+"""ECON-02B2d12: real authenticated warehouse lifecycle HTTP and SQLite restart."""
+import argparse, http.client, json, pathlib, socket, subprocess, sys, tempfile, time
+p=argparse.ArgumentParser()
+for n in ('host','fixture','relay'):p.add_argument('--'+n,required=True)
+a=p.parse_args()
+def random_port():
+    with socket.socket() as s:s.bind(('127.0.0.1',0));return s.getsockname()[1]
+class Game:
+    def __init__(self,save):
+        self.port=random_port()
+        self.child=subprocess.Popen([sys.executable,a.relay,'--colony','--host-exe',a.host,'--save',str(save),
+            '--port',str(self.port),'--tick-ms','100','--max-ticks','1200'],stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+        for i in range(100):
+            if self.child.poll() is not None:raise AssertionError('Relay stopped early')
+            try:
+                if self.get('/healthz')[0]==200:break
+            except (OSError,TimeoutError):pass
+            time.sleep(.05)
+        else:raise AssertionError('No health response')
+    def request(self,method,path,data=None,headers=None):
+        c=http.client.HTTPConnection('127.0.0.1',self.port,timeout=10)
+        body=json.dumps(data,separators=(',',':')).encode() if data is not None else None
+        h={'Host':'127.0.0.1:'+str(self.port),**(headers or {})}
+        if body is not None:
+            h.setdefault('Content-Type','application/json');h.setdefault('Origin','http://127.0.0.1:'+str(self.port))
+        try:
+            c.request(method,path,body,headers=h)
+            response=c.getresponse();raw=response.read()
+            return response.status,json.loads(raw) if response.getheader('Content-Type')=='application/json' else raw.decode()
+        finally:c.close()
+    def get(self,path):return self.request('GET',path)
+    def post(self,path,data,headers=None):return self.request('POST',path,data,headers)
+    def close(self):
+        self.child.terminate()
+        try:self.child.communicate(timeout=8)
+        except subprocess.TimeoutExpired:self.child.kill();self.child.communicate(timeout=5)
+with tempfile.TemporaryDirectory(prefix='sg-warehouse-lifecycle-') as temp:
+    save=pathlib.Path(temp)/'world.sqlite'
+    r=subprocess.run([a.fixture,str(save)],capture_output=True,text=True,timeout=20)
+    assert r.returncode==0,r.stderr
+    game=Game(save)
+    try:
+        status,session=game.get('/session');assert status==200,(status,session)
+        token=session['token']
+        status,sites=game.get('/factory/api/sites');assert status==200 and len(sites['sites'])==1
+        site=sites['sites'][0]
+        status,before=game.get('/factory/api/crews?site='+str(site))
+        assert status==200 and len(before['supply']['sources'])==1,(status,before)
+        assert before['supply']['sources'][0]['node']==1 and before['supply']['sources'][0]['decommissioning'] is False
+        assert before['supply']['sources'][0]['goodsLiters']==0
+        assert before['supply']['sources'][0]['connectedLinks']==0
+        status,denied=game.post('/factory/api/warehouse_mark',{'site':site,'token':'forged','node':1})
+        assert status==403,(status,denied)
+        status,denied=game.post('/factory/api/warehouse_mark',{'site':site,'token':token,'node':0})
+        assert status==400,(status,denied)
+        status,denied=game.post('/factory/api/warehouse_mark',{'site':site,'token':token,'node':1},
+                                {'Origin':'https://evil.example'})
+        assert status==403,(status,denied)
+        status,denied=game.post('/factory/api/warehouse_mark',{'site':999999,'token':token,'node':1})
+        assert status==400,(status,denied)
+        status,mark=game.post('/factory/api/warehouse_mark',{'site':site,'token':token,'node':1})
+        assert status==200 and mark['event']['applied'],(status,mark)
+        status,view=game.get('/factory/api/crews?site='+str(site))
+        assert status==200 and view['supply']['sources'][0]['decommissioning'] is True,(status,view)
+        status,refused=game.post('/factory/api/crew_restock',{'site':site,'token':token,'node':1,
+                                'npc':view['residents'][0]})
+        assert status==400,(status,refused)
+    finally:game.close()
+    game=Game(save)
+    try:
+        status,session=game.get('/session');token=session['token'];assert status==200
+        status,view=game.get('/factory/api/crews?site='+str(site))
+        assert view['supply']['sources'][0]['decommissioning'] is True,(status,view)
+        status,cancel=game.post('/factory/api/warehouse_cancel',{'site':site,'token':token,'node':1})
+        assert status==200 and cancel['event']['applied'],(status,cancel)
+        status,mark=game.post('/factory/api/warehouse_mark',{'site':site,'token':token,'node':1})
+        assert status==200 and mark['event']['applied'],(status,mark)
+        stock_before=view['supply']['depot']
+        status,demolished=game.post('/factory/api/warehouse_demolish',{'site':site,'token':token,'node':1})
+        assert status==200 and demolished['event']['applied'],(status,demolished)
+        status,view=game.get('/factory/api/crews?site='+str(site))
+        assert status==200 and not view['supply']['sources'] and view['supply']['depot']==stock_before+1,(status,view)
+        status,again=game.post('/factory/api/warehouse_demolish',{'site':site,'token':token,'node':1})
+        assert status==200 and not again['event']['applied'],(status,again)
+    finally:game.close()
+    game=Game(save)
+    try:
+        status,view=game.get('/factory/api/crews?site='+str(site))
+        assert status==200 and not view['supply']['sources'] and view['supply']['depot']==1,(status,view)
+    finally:game.close()
+    print('ECON-02B2d12 PASS: real HTTP token/site/origin checks, marking, restart, recommissioning, demolition, no double removal')
