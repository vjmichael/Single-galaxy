+bool Crews::warehouse_job_dependency(std::uint32_t node,PlayerId owner,EntityId ship,EntityId site)const{
+ validate_site(owner,ship,site);
+ Query q(db_->db,"SELECT 1 FROM sg_construction_restock WHERE site=? AND node=? AND active=1 LIMIT 1");
+ q.n(1,site);q.n(2,node);
+ if(q.row())return true;
+ // A worker on a construction job at the equipment location must clear it
+ // before demolition; this is occupancy safety, not an arbitrary floor cap.
+ const auto* st=world_.world().storage(site);
+ if(!st)return false;
+ const auto pos=st->equipment_positions.find(node);
+ if(pos==st->equipment_positions.end())return false;
+ Query people(db_->db,"SELECT 1 FROM sg_construction_workers w JOIN sg_construction_jobs j ON w.plan_id=j.plan_id "
+    "WHERE j.site=? AND j.active=1 AND w.x=? AND w.y=? LIMIT 1");
+ people.n(1,site);people.n(2,pos->second.x);people.n(3,pos->second.y);
+ return people.row();
