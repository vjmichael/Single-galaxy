+std::int64_t Simulation::construction_node_module_liters(EntityId site,std::uint32_t node)const{
+    const auto* s=construction_supplies(site);
+    if(!s || !node)return 0;
+    std::int64_t modules=0;
+    if(auto it=s->node_modules.find(node);it!=s->node_modules.end())modules+=it->second;
+    for(const auto& [plan,hold]:s->reserved){(void)plan;
+        if(hold.node==node)modules+=hold.modules;
+    }
+    if(modules<0 || modules>2)throw std::overflow_error("construction stock exceeds 4m3 installed bin");
+    return modules*2000;
+}
