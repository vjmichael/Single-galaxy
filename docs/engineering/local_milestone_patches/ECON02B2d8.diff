+#include <iostream>
+#include <stdexcept>
+#include <vector>
+using namespace galaxy;
+namespace fs=std::filesystem;
+#define CHECK(x) do{if(!(x))throw std::runtime_error(std::string("d8 line ")+std::to_string(__LINE__)+": " #x);}while(0)
+static Event cmd(PersistentWorld& w,EntityId ship,std::uint64_t id,Action a,
+                 EntityId target=0,std::int64_t n=1,int x=0,int y=0){
+    Command c{};c.id=id;c.sequence=id;c.issuer=7;c.actor=ship;c.target=target;
+    c.amount=n;c.thrust_x=x;c.thrust_y=y;c.action=a;c.execute_tick=w.world().tick()+1;
+    CHECK(w.submit(c));w.step();CHECK(w.world().events().back().command_id==id);
+    return w.world().events().back();
+}
+static void ok(PersistentWorld& w,EntityId ship,std::uint64_t id,Action a,
+               EntityId target=0,std::int64_t n=1,int x=0,int y=0){
+    CHECK(cmd(w,ship,id,a,target,n,x,y).result==Outcome::Applied);
+}
+static std::int64_t custody(const Simulation& w,EntityId site){
+    auto* stock=w.construction_supplies(site);if(!stock)return 0;
+    auto sum=stock->depot;
+    for(const auto& [id,n]:stock->node_modules){(void)id;sum+=n;}
+    for(const auto& [id,n]:stock->carried){(void)id;sum+=n;}
+    for(const auto& [id,n]:stock->delivered){(void)id;sum+=n;}
+    for(const auto& [id,r]:stock->reserved){(void)id;sum+=r.modules;}
+    return sum;
+}
+int main(){
+ const auto temp=fs::temp_directory_path()/("sg_b2d8_"+
+    std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+ fs::create_directories(temp);
+ try{
+  const auto db=(temp/"world.sqlite").string();
+  Simulation genesis(850);const auto ship=genesis.add_colony_ship(7,{0,0},500,8);
+  genesis.provision_colony_genesis(ship,1000,3000,1000,1000,1000);
+  const auto rock=genesis.add_asteroid({1000,0},180);
+  genesis.enable_individual_workforce();
+  const auto mass=genesis.total_material_kg();
+  EntityId site=0;std::int64_t p1=0,p2=0,p3=0;
+  std::vector<std::uint64_t> npc;
+  std::int64_t before=0;
+  {
+   PersistentWorld w(db,std::move(genesis));
+   ok(w,ship,1,Action::Mine,rock,120);ok(w,ship,2,Action::RefineOre,0,120);
+   ok(w,ship,3,Action::FabricateModule,0,40);ok(w,ship,4,Action::ConstructOutpost);
+   site=w.world().built_outposts().begin()->first;
+   ok(w,ship,5,Action::ConstructHabitat,site);
+   for(int i=1;i<=3;++i)ok(w,ship,5+i,Action::TransferHabitatStock,site,30,i);
+   ok(w,ship,9,Action::AssignHabitatResidents,site,2);
+   for(const auto& [id,r]:w.world().npc_records())if(r.location==site&&r.role==NpcRole::Habitat)npc.push_back(id);
+   CHECK(npc.size()>=2);
+   ok(w,ship,10,Action::ConstructStorage,site);
+   ok(w,ship,11,Action::ConstructStorageNode,site,1);
+   ok(w,ship,12,Action::ConstructStorageNode,site,2);
+   ok(w,ship,13,Action::PlaceFactoryEquipment,site,1,4,0);
+   ok(w,ship,14,Action::PlaceFactoryEquipment,site,2,8,0);
+   construction::Plans plans(db,w);construction::Crews crews(db,w,plans);
+   p1=plans.create("sg-colony-structure-plan-v1\n2,6,0\n",7,ship,site);
+   p2=plans.create("sg-colony-structure-plan-v1\n2,10,0\n",7,ship,site);
+   crews.assign(p1,npc[0],7,ship,site);
+   crews.assign(p2,npc[1],7,ship,site);
+   auto send=[&](Action a,std::int64_t n,int x=0,int y=0){
+       const auto e=plans.supply_action(a,n,x,y,7,ship,site);
+       CHECK(e.result==Outcome::Applied);
+   };
+   send(Action::StageConstructionModules,6);
+   send(Action::PickupConstructionModules,npc[0],2);
+   send(Action::DepositConstructionNodeModules,npc[0],1);
+   send(Action::PickupConstructionModules,npc[1],2);
+   send(Action::DepositConstructionNodeModules,npc[1],2);
+   CHECK(w.world().construction_supplies(site)->node_modules.at(1)==2);
+   CHECK(w.world().construction_supplies(site)->node_modules.at(2)==2);
+   // Each physical bin holds 4m3; these construction modules occupy 2m3 each.
+   send(Action::PickupConstructionModules,npc[0],1);
+   CHECK(plans.supply_action(Action::DepositConstructionNodeModules,npc[0],1,0,7,ship,site).result==Outcome::CargoFull);
+   CHECK(w.world().construction_supplies(site)->carried.at(npc[0])==1);
+   send(Action::ReturnConstructionModules,npc[0]);
+   CHECK(plans.supply_action(Action::DepositConstructionNodeModules,999999,1,0,7,ship,site).result==Outcome::InvalidTarget);
+   send(Action::ReserveConstructionModules,p1,1,2);
+   send(Action::ReserveConstructionModules,p2,2,2);
+   CHECK(w.world().construction_supplies(site)->reserved.at(p1).node==1);
+   CHECK(w.world().construction_supplies(site)->reserved.at(p2).node==2);
+   // One plan cannot claim resources already reserved by another.
+   const auto rejected=plans.supply_action(Action::ReserveConstructionModules,p2,1,2,7,ship,site);
+   CHECK(rejected.result!=Outcome::Applied);
+   CHECK(w.world().construction_supplies(site)->reserved.at(p1).modules==2);
+   CHECK(w.world().construction_supplies(site)->reserved.at(p2).modules==2);
+   CHECK(w.world().total_material_kg()==mass);
+   before=w.world().colony_ship(ship)->modules+custody(w.world(),site);
+  }
+  {
+   PersistentWorld w(db,Simulation(1));construction::Plans plans(db,w);construction::Crews crews(db,w,plans);
+   CHECK(w.world().construction_supplies(site)->reserved.at(p1).node==1);
+   CHECK(w.world().construction_supplies(site)->reserved.at(p2).node==2);
+   CHECK(w.world().total_material_kg()==mass);
+   bool completed=false;
+   for(int i=0;i<260;++i){
+    crews.advance(7,ship);w.step();
+    if(plans.status(p1,7,ship,site).finished() && plans.status(p2,7,ship,site).finished()){
+     completed=true;break;
+    }
+   }
+   CHECK(completed);
+   CHECK(w.world().colony_fixtures(site).size()==2);
+   CHECK(w.world().construction_supplies(site)->reserved.empty());
+   CHECK(w.world().colony_ship(ship)->modules+custody(w.world(),site)==before-4);
+   CHECK(w.world().total_material_kg()==mass);
+   CHECK(crews.unassign(npc[0],7,ship,site));
+   p3=plans.create("sg-colony-structure-plan-v1\n1,12,0\n",7,ship,site);
+   crews.assign(p3,npc[0],7,ship,site);
+   const auto e=plans.supply_action(Action::ReserveConstructionModules,p3,0,1,7,ship,site);
+   CHECK(e.result==Outcome::Applied);
+   const auto depot_before=w.world().construction_supplies(site)->depot;
+   CHECK(plans.cancel(p3,7,ship,site));
+   for(int i=0;i<10 && w.world().construction_supplies(site)->reserved.count(p3);++i){crews.advance(7,ship);w.step();}
+   CHECK(!w.world().construction_supplies(site)->reserved.count(p3));
+   CHECK(w.world().construction_supplies(site)->depot==depot_before+1);
+   // An abandoned delivery can be salvaged into real named-NPC cargo and
+   // returned, never materialized directly into depot stock.
+   const auto s=plans.supply_action(Action::PickupConstructionModules,npc[0],1,0,7,ship,site);
+   CHECK(s.result==Outcome::Applied);
+   CHECK(plans.supply_action(Action::DeliverConstructionModules,npc[0],12,0,7,ship,site).result==Outcome::Applied);
+   CHECK(w.world().construction_delivered(site,12,0)==1);
+   CHECK(plans.supply_action(Action::RecoverConstructionDelivery,npc[0],12,0,7,ship,site).result==Outcome::Applied);
+   CHECK(w.world().construction_delivered(site,12,0)==0);
+   CHECK(w.world().construction_supplies(site)->carried.at(npc[0])==1);
+   CHECK(plans.supply_action(Action::ReturnConstructionModules,npc[0],0,0,7,ship,site).result==Outcome::Applied);
+   CHECK(crews.unassign(npc[1],7,ship,site));
+   bool rejected=false;
+   try{crews.queue_restock(npc[1],1234,7,ship,site);}catch(const std::invalid_argument&){rejected=true;}
+   CHECK(rejected);
+   crews.queue_restock(npc[1],1,7,ship,site);
+   rejected=false;
+   try{crews.queue_restock(npc[1],1,7,ship,site);}catch(const std::invalid_argument&){rejected=true;}
+   CHECK(rejected);
+   bool picked=false;
+   for(int i=0;i<80&&!picked;++i){
+    crews.advance(7,ship);w.step();
+    const auto* stock=w.world().construction_supplies(site);
+    picked=stock&&stock->carried.count(npc[1]);
+   }
+   CHECK(picked);
+   CHECK(crews.list_restock(7,ship,site).size()==1);
+   CHECK(crews.list_restock(7,ship,site).at(0).active);
+   CHECK(w.world().total_material_kg()==mass);
+  }
+  {
+   PersistentWorld w(db,Simulation(2));construction::Plans plans(db,w);construction::Crews crews(db,w,plans);
+   CHECK(w.world().total_material_kg()==mass);
+   CHECK(w.world().construction_supplies(site)->carried.count(npc[1])>0);
+   for(int i=0;i<150&&crews.list_restock(7,ship,site).at(0).active;++i){crews.advance(7,ship);w.step();}
+   const auto runs=crews.list_restock(7,ship,site);
+   CHECK(!runs.at(0).active);
+   CHECK(runs.at(0).x==4&&runs.at(0).y==0);
+   CHECK(w.world().construction_supplies(site)->node_modules.at(1)==2);
+   CHECK(!w.world().construction_supplies(site)->carried.count(npc[1]));
+   CHECK(w.world().total_material_kg()==mass);
+   CHECK(plans.status(p1,7,ship,site).finished());
+   CHECK(plans.status(p2,7,ship,site).finished());
+   CHECK(plans.status(p3,7,ship,site).cancelled);
+   CHECK(w.world().construction_supplies(site)->reserved.empty());
+  }
+  fs::remove_all(temp);
+  std::cout<<"ECON-02B2d8 PASS: competing physical sources, reserved builds, restart, cancellation, salvage and NPC supply run\n";
+  return 0;
+ }catch(const std::exception& e){
+  std::cerr<<"ECON-02B2d8 FAIL: "<<e.what()<<'\n';fs::remove_all(temp);return 1;
+ }
+}
