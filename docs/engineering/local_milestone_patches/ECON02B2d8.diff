+std::vector<SupplyRun> Crews::list_restock(PlayerId owner,EntityId ship,EntityId site)const{
+ validate_site(owner,ship,site);
+ Query q(db_->db,"SELECT npc_id,node,x,y,active,phase,reason FROM sg_construction_restock"
+                  " WHERE owner=? AND ship=? AND site=? ORDER BY npc_id LIMIT 200");
+ q.n(1,owner);q.n(2,ship);q.n(3,site);
+ std::vector<SupplyRun> result;
+ while(q.row())result.push_back({static_cast<std::uint64_t>(q.v(0)),static_cast<std::uint32_t>(q.v(1)),
+     static_cast<int>(q.v(2)),static_cast<int>(q.v(3)),q.v(4)!=0,q.v(5)==2,q.t(6)});
+ return result;
