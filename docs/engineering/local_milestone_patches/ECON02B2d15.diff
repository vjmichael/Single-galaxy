+#include "galaxy/Persistence.hpp"
+#include "galaxy/Simulation.hpp"
+#include <iostream>
+#include <stdexcept>
+using namespace galaxy;
+static void action(PersistentWorld& w,EntityId ship,std::uint64_t id,Action kind,EntityId site=0,
+                   std::int64_t amount=1,int x=0,int y=0){
+ Command c{};c.id=id;c.sequence=id;c.issuer=7;c.actor=ship;c.target=site;c.action=kind;
+ c.amount=amount;c.thrust_x=x;c.thrust_y=y;c.execute_tick=w.world().tick()+1;
+ if(!w.submit(c))throw std::runtime_error("Failed fixture submit "+std::to_string(id));
+ w.step();
+ if(w.world().events().back().result!=Outcome::Applied)
+  throw std::runtime_error("Fixture command rejected "+std::to_string(id));
+}
+int main(int argc,char** argv){
+ if(argc!=2)return 2;
+ try{
+  Simulation seed(1216);
+  auto ship=seed.add_colony_ship(7,{0,0},500,8);
+  seed.provision_colony_genesis(ship,1000,3000,1000,1000,1000);
+  auto asteroid=seed.add_asteroid({1000,0},200);
+  const auto silicate=seed.add_geological_asteroid({2000,0},AsteroidClass::Silicate,30,2500);
+  seed.enable_individual_workforce();
+  PersistentWorld w(argv[1],std::move(seed));
+  action(w,ship,1,Action::Mine,asteroid,175);
+  action(w,ship,2,Action::RefineOre,0,175);
+  action(w,ship,3,Action::FabricateModule,0,75);
+  action(w,ship,4,Action::ConstructOutpost);
+  auto site=w.world().built_outposts().begin()->first;
+  action(w,ship,5,Action::ConstructHabitat,site);
+  for(int i=1;i<=3;++i)action(w,ship,5+i,Action::TransferHabitatStock,site,30,i);
+  action(w,ship,9,Action::AssignHabitatResidents,site,2);
+  action(w,ship,10,Action::ConstructStorage,site);
+  action(w,ship,11,Action::ConstructWorkshop,site);
+  action(w,ship,12,Action::ConstructWorkshopFinisher,site);
+  action(w,ship,13,Action::PlaceFactoryEquipment,site,-1,4,0);
+  action(w,ship,14,Action::PlaceFactoryEquipment,site,0,0,0);
+  action(w,ship,15,Action::Mine,silicate,45);
+  action(w,ship,16,Action::RefineMineral,10,18000);
+  action(w,ship,17,Action::TransferWorkshopStack,site,40,0);
+  std::cout<<"ECON-02B2d15 line goods fixture prepared\n";
+  return 0;
+ }catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}
+}
diff --git a/tests/ECON02B2d15LineShutdownHostTests.py b/tests/ECON02B2d15LineShutdownHostTests.py
new file mode 100644
index 0000000000000000000000000000000000000000..1dc5b76776beb5a341a10587147a6d9ac8f5f9b1
--- /dev/null
+++ b/tests/ECON02B2d15LineShutdownHostTests.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""d15: real colony relay/session authorization and durable world shutdown."""
+import argparse,http.client,json,pathlib,socket,subprocess,sys,tempfile,time
+p=argparse.ArgumentParser()
+for n in ('host','fixture','relay'):p.add_argument('--'+n,required=True)
+a=p.parse_args()
+def port():
+ with socket.socket() as s:s.bind(('127.0.0.1',0));return s.getsockname()[1]
+class Game:
+ def __init__(self,db):
+  self.port=port()
+  self.proc=subprocess.Popen([sys.executable,a.relay,'--colony','--host-exe',a.host,'--save',str(db),
+    '--port',str(self.port),'--tick-ms','75','--max-ticks','1200'],stdin=subprocess.DEVNULL,
+    stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+  for _ in range(100):
+   if self.proc.poll() is not None:raise AssertionError('Colony game exited early')
+   try:
+    if self.get('/healthz')[0]==200:break
+   except (OSError,TimeoutError):pass
+   time.sleep(.05)
+  else:raise AssertionError('Colony game did not start')
+ def request(self,method,path,doc=None,headers=None):
+  c=http.client.HTTPConnection('127.0.0.1',self.port,timeout=10)
+  body=json.dumps(doc).encode() if doc is not None else None
+  h={'Host':f'127.0.0.1:{self.port}',**(headers or {})}
+  if body is not None:
+   h.setdefault('Content-Type','application/json');h.setdefault('Origin',f'http://127.0.0.1:{self.port}')
+  try:
+   c.request(method,path,body,headers=h)
+   r=c.getresponse();raw=r.read()
+   return r.status,json.loads(raw) if r.getheader('Content-Type')=='application/json' else raw.decode()
+  finally:c.close()
+ def get(self,path):return self.request('GET',path)
+ def post(self,path,doc,headers=None):return self.request('POST',path,doc,headers)
+ def close(self):
+  self.proc.terminate()
+  try:self.proc.communicate(timeout=8)
+  except subprocess.TimeoutExpired:self.proc.kill();self.proc.communicate(timeout=5)
+with tempfile.TemporaryDirectory(prefix='sg-d15-http-') as tmp:
+ db=pathlib.Path(tmp)/'world.sqlite'
+ r=subprocess.run([a.fixture,str(db)],capture_output=True,text=True,timeout=20)
+ assert r.returncode==0,r.stderr
+ game=Game(db)
+ try:
+  token=game.get('/session')[1]['token']
+  status,sites=game.get('/factory/api/sites');assert status==200 and len(sites['sites'])==1
+  site=sites['sites'][0]
+  endpoint='/factory/api/line_shutdown'
+  req={'token':token,'site':site,'shutdown':True}
+  for fake in ({**req,'token':'forged'},{**req,'site':999999},{**req,'shutdown':1},{**req,'shutdown':'true'}):
+   status,_=game.post(endpoint,fake)
+   assert status in (400,403),(status,fake)
+  status,_=game.post(endpoint,req,{'Origin':'https://evil.invalid'})
+  assert status==403,status
+  status,ok=game.post(endpoint,req);assert status==200 and ok['shutdown'],(status,ok)
+  status,stock=game.get(f'/factory/api/crews?site={site}')
+  assert status==200 and stock['workshopState']['shutdown'],(status,stock)
+  status,_=game.post(endpoint,req);assert status==400
+  status,state=game.get(f'/factory/api/crews?site={site}')
+  assert status==200 and state['workshopState']['aluminum']==40
+  worker=state['residents'][0]
+  evacuation='/factory/api/line_evacuate'
+  jobreq={'token':token,'site':site,'npc':worker}
+  for fake in ({**jobreq,'token':'forged'},{**jobreq,'site':999999},
+               {**jobreq,'npc':-1},{**jobreq,'npc':'invalid'}):
+   status,_=game.post(evacuation,fake)
+   assert status in (400,403),(status,fake)
+  status,_=game.post(evacuation,jobreq,{'Origin':'https://evil.invalid'})
+  assert status==403
+  status,ok=game.post(evacuation,jobreq);assert status==200 and ok['assigned'],(status,ok)
+  carrying=False
+  for _ in range(120):
+   status,state=game.get(f'/factory/api/crews?site={site}')
+   assert status==200,(status,state)
+   if state['lineEvacuation'][0]['carryingKg']>0:carrying=True;break
+   time.sleep(.05)
+  assert carrying,'NPC did not pick up physical inventory'
+ finally:game.close()
+ game=Game(db)
+ try:
+  status,stock=game.get(f'/factory/api/crews?site={site}')
+  assert status==200 and stock['workshopState']['shutdown'] and stock['workshopState']['drained'],(status,stock)
+  assert stock['lineEvacuation'][0]['active'] and stock['lineEvacuation'][0]['carryingKg']>0,stock
+  complete=False
+  for _ in range(200):
+   status,stock=game.get(f'/factory/api/crews?site={site}')
+   assert status==200
+   if not stock['lineEvacuation'][0]['active']:
+    complete=True;break
+   time.sleep(.06)
+  assert complete and stock['workshopState']['aluminum']==0,stock
+  token=game.get('/session')[1]['token']
+  status,ok=game.post('/factory/api/line_shutdown',{'token':token,'site':site,'shutdown':False})
+  assert status==200 and not ok['shutdown'],(status,ok)
+ finally:game.close()
+ game=Game(db)
+ try:
+  status,stock=game.get(f'/factory/api/crews?site={site}')
+  assert status==200 and not stock['workshopState']['shutdown'],(status,stock)
+ finally:game.close()
+ print('ECON-02B2d15 PASS: shutdown, authenticated evacuation, in-transit restart')
diff --git a/tests/ECON02B2d15LineShutdownTests.cpp b/tests/ECON02B2d15LineShutdownTests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..26caa25457df880a5688401335f1ba999c3aec48
--- /dev/null
+++ b/tests/ECON02B2d15LineShutdownTests.cpp
@@ -0,0 +1,170 @@
+#include "galaxy/NpcConstructionCrews.hpp"
+#include "../src/factory_colony_protocol.hpp"
+#include <chrono>
+#include <filesystem>
+#include <iostream>
+#include <stdexcept>
+#include <sqlite3.h>
+using namespace galaxy;
+namespace fs=std::filesystem;
+#define CHECK(x) do{if(!(x))throw std::runtime_error("d15 line "+std::to_string(__LINE__)+": " #x);}while(0)
+static Event send(PersistentWorld& w,EntityId ship,std::uint64_t id,Action kind,
+                  EntityId target=0,std::int64_t amt=1,int x=0,PlayerId owner=7){
+ Command c{};c.id=id;c.sequence=id;c.issuer=owner;c.actor=ship;c.target=target;
+ c.amount=amt;c.thrust_x=x;c.action=kind;c.execute_tick=w.world().tick()+1;
+ CHECK(w.submit(c));w.step();CHECK(w.world().events().back().command_id==id);
+ return w.world().events().back();
+}
+static void ok(const Event& e){CHECK(e.result==Outcome::Applied);}
+int main(){
+ const auto dir=fs::temp_directory_path()/("sg_line_d15_"+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+ fs::create_directories(dir);const auto db=(dir/"world.sqlite").string();
+ try{
+  Simulation init(1515);const auto ship=init.add_colony_ship(7,{0,0},300,8);
+  init.provision_colony_genesis(ship,1000,3000,1000,1000,1000);
+  const auto rock=init.add_asteroid({2000,0},150);
+  const auto silicate=init.add_geological_asteroid({1000,0},AsteroidClass::Silicate,30,2500);
+  init.enable_individual_workforce();const auto mass=init.total_material_kg();EntityId site=0;
+  {
+   PersistentWorld w(db,std::move(init));
+   ok(send(w,ship,1,Action::Mine,rock,100));
+   ok(send(w,ship,2,Action::RefineOre,0,100));
+   ok(send(w,ship,3,Action::FabricateModule,0,50));
+   ok(send(w,ship,4,Action::ConstructOutpost));site=w.world().built_outposts().begin()->first;
+   ok(send(w,ship,5,Action::ConstructWorkshop,site));
+   ok(send(w,ship,6,Action::ConstructWorkshopFinisher,site));
+   ok(send(w,ship,7,Action::ConstructUtility,site));
+   ok(send(w,ship,8,Action::ConstructHabitat,site));
+   for(int i=1;i<=3;++i)ok(send(w,ship,8+i,Action::TransferHabitatStock,site,500,i));
+   ok(send(w,ship,12,Action::AssignHabitatResidents,site,2));
+   ok(send(w,ship,13,Action::AssignUtilityTechnicians,site,1));
+   ok(send(w,ship,14,Action::TransferUtilitySpares,site,25));
+   ok(send(w,ship,15,Action::SetUtilityMaintenance,site,1));
+   std::uint64_t a=0,b=0;
+   for(const auto& [id,n]:w.world().npc_records())if(n.location==site&&n.role==NpcRole::Habitat){if(!a)a=id;else if(!b)b=id;}
+   CHECK(a&&b);
+   ok(send(w,ship,16,Action::AssignWorkshopOperator,site,a));
+   ok(send(w,ship,17,Action::AssignWorkshopFinisher,site,b));
+   ok(send(w,ship,18,Action::Mine,silicate,45));
+   ok(send(w,ship,19,Action::RefineMineral,10,18000));
+   ok(send(w,ship,20,Action::TransferWorkshopFeed,site,1000));
+   CHECK(w.world().workshop(site)->reserved_aluminum_kg==20);
+   // A false issuer cannot grant or revoke production authority.
+   CHECK(send(w,ship,21,Action::SetWorkshopShutdown,site,1,0,8).result==Outcome::Unauthorized);
+   colony_factory::Control api(db,w,ship,7);
+   CHECK(api.handle("LINE_SHUTDOWN",site,"1").find("true")!=std::string::npos);
+   CHECK(w.world().workshop(site)->shutdown_requested);
+   CHECK(w.world().canonical_state().rfind("galaxy-kernel-v38|",0)==0);
+   CHECK(Simulation::from_snapshot(w.world().canonical_state()).canonical_state()==w.world().canonical_state());
+   // Previously authorized inputs cannot be replenished or transferred into
+   // a line under decommission; existing WIP must finish honestly.
+   CHECK(send(w,ship,22,Action::TransferWorkshopFeed,site,1000).result==Outcome::InvalidTarget);
+   // Request line stoppage DOES NOT instantly throw away WIP.
+   CHECK(w.world().workshop(site)->reserved_aluminum_kg>0);
+   construction::Plans plans(db,w);construction::Crews crew(db,w,plans);
+   for(int i=0;i<30;++i){w.step();crew.advance(7,ship);CHECK(w.world().total_material_kg()==mass);}
+   const auto stopped=*w.world().workshop(site);
+   CHECK(stopped.shutdown_requested && stopped.reserved_aluminum_kg==0 && stopped.reserved_panels_kg==0);
+   CHECK(stopped.operator_npc_id==0 && stopped.finisher_npc_id==0);
+   CHECK(stopped.aluminum_kg>0); // still physical, not fabricated or cleared
+   const auto done_batches=stopped.completed_batches;
+   for(int i=0;i<5;++i){w.step();crew.advance(7,ship);}
+   CHECK(w.world().workshop(site)->completed_batches==done_batches);
+   CHECK(w.world().total_material_kg()==mass);
+  }
+  {
+   PersistentWorld w(db,Simulation(1));construction::Plans plans(db,w);construction::Crews crew(db,w,plans);
+   const auto before=*w.world().workshop(site);CHECK(before.shutdown_requested);
+   CHECK(before.reserved_aluminum_kg==0 && before.operator_npc_id==0);
+   // Outbound to the original built storage bin is a real inventory transfer.
+   // Shutdown does not erase stock or invent cargo custody.
+   ok(send(w,ship,30,Action::ConstructStorage,site));
+   const auto take=std::min<std::int64_t>(before.aluminum_kg,100);
+   CHECK(take>0);
+   // Transfer from workshop to store: thrust_y=2.
+   Command c{};c.id=31;c.sequence=31;c.issuer=7;c.actor=ship;c.target=site;
+   c.action=Action::TransferStorageStack;c.amount=take;c.thrust_x=0;c.thrust_y=2;c.execute_tick=w.world().tick()+1;
+   CHECK(w.submit(c));w.step();CHECK(w.world().events().back().result==Outcome::Applied);
+   CHECK(w.world().storage(site)->goods_kg.at("aluminum")==take);
+   CHECK(w.world().workshop(site)->aluminum_kg==before.aluminum_kg-take);
+   CHECK(w.world().total_material_kg()==mass);
+   ok(send(w,ship,32,Action::PlaceFactoryEquipment,site,0,0));
+   ok(send(w,ship,33,Action::PlaceFactoryEquipment,site,-1,4));
+   // Keep the last few kilograms local to make the physical-haul test bounded;
+   // removing stock here is a real ship transfer, never resource deletion.
+   const auto aluminum=w.world().workshop(site)->aluminum_kg;
+   if(aluminum>42){
+    Command out{};out.id=34;out.sequence=34;out.issuer=7;out.actor=ship;out.target=site;
+    out.action=Action::TransferWorkshopStack;out.amount=-(aluminum-42);out.thrust_x=0;out.execute_tick=w.world().tick()+1;
+    CHECK(w.submit(out));w.step();CHECK(w.world().events().back().result==Outcome::Applied);
+   }
+   CHECK(w.world().total_material_kg()==mass);
+   std::uint64_t worker=0;
+   for(const auto& [id,n]:w.world().npc_records())
+    if(n.location==site && n.role==NpcRole::Habitat)worker=id;
+   CHECK(worker);
+   crew.queue_line_evacuation(worker,7,ship,site);
+   CHECK(!crew.list_line_evacuation(7,ship,site).empty());
+   bool picked=false;
+   for(int i=0;i<80 && !picked;++i){
+    w.step();crew.advance(7,ship);
+    const auto* stock=w.world().construction_supplies(site);
+    picked=stock && stock->evacuation_cargo.count(worker);
+    CHECK(w.world().total_material_kg()==mass);
+   }
+   CHECK(picked);
+   CHECK(w.world().canonical_state().rfind("galaxy-kernel-v39|",0)==0);
+   CHECK(Simulation::from_snapshot(w.world().canonical_state()).canonical_state()==w.world().canonical_state());
+   CHECK(crew.cancel_line_evacuation(worker,7,ship,site));
+   for(int i=0;i<80;++i){
+    w.step();crew.advance(7,ship);
+    CHECK(w.world().total_material_kg()==mass);
+    if(!crew.list_line_evacuation(7,ship,site).at(0).active)break;
+   }
+   CHECK(!crew.list_line_evacuation(7,ship,site).at(0).active);
+   CHECK(!w.world().construction_supplies(site)->evacuation_cargo.count(worker));
+   // Reassign and deliberately close the database while physical goods travel.
+   crew.queue_line_evacuation(worker,7,ship,site);
+   bool picked_again=false;
+   for(int i=0;i<80 && !picked_again;++i){
+    w.step();crew.advance(7,ship);
+    const auto* stock=w.world().construction_supplies(site);
+    picked_again=stock && stock->evacuation_cargo.count(worker);
+    CHECK(w.world().total_material_kg()==mass);
+   }
+   CHECK(picked_again);
+  }
+  {
+   PersistentWorld w(db,Simulation(1));construction::Plans plans(db,w);construction::Crews crew(db,w,plans);
+   CHECK(w.world().workshop(site)->shutdown_requested);
+   std::uint64_t worker=0;
+   for(const auto& j:crew.list_line_evacuation(7,ship,site))if(j.active)worker=j.npc;
+   CHECK(worker && w.world().construction_supplies(site)->evacuation_cargo.count(worker));
+   bool completed=false;
+   for(int i=0;i<1200;++i){
+    w.step();crew.advance(7,ship);
+    CHECK(w.world().total_material_kg()==mass);
+    if(!crew.list_line_evacuation(7,ship,site).at(0).active){completed=true;break;}
+   }
+   CHECK(completed);
+   CHECK(!w.world().construction_supplies(site)->evacuation_cargo.count(worker));
+   CHECK(w.world().workshop(site)->aluminum_kg==0);
+   CHECK(w.world().total_material_kg()==mass);
+   CHECK(colony_factory::Control(db,w,ship,7).handle("LINE_SHUTDOWN",site,"0").find("false")!=std::string::npos);
+   CHECK(!w.world().workshop(site)->shutdown_requested);
+  }
+  // A forged physical-custody receipt must not survive replay auditing.
+  sqlite3* sql=nullptr;
+  CHECK(sqlite3_open_v2(db.c_str(),&sql,SQLITE_OPEN_READWRITE,nullptr)==SQLITE_OK);
+  CHECK(sqlite3_exec(sql,"UPDATE resource_ledger SET source_id='forged-inventory' "
+     "WHERE reason='npc_workshop_inventory_transfer_kg' AND command_id=(SELECT MIN(command_id) "
+     "FROM resource_ledger WHERE reason='npc_workshop_inventory_transfer_kg')",nullptr,nullptr,nullptr)==SQLITE_OK);
+  CHECK(sqlite3_changes(sql)>0);
+  sqlite3_close(sql);
+  bool refused=false;
+  try{PersistentWorld tampered(db,Simulation(1));(void)tampered;}
+  catch(const std::exception&){refused=true;}
+  CHECK(refused);
+ }catch(const std::exception& e){fs::remove_all(dir);std::cerr<<e.what()<<'\n';return 1;}
+ fs::remove_all(dir);std::cout<<"d15 shutdown/restart/conservation passed\n";return 0;
+}
