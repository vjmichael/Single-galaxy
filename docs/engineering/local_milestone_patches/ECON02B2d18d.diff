new file mode 100644
index 0000000..c33a847
--- /dev/null
+++ b/tests/ECON02B2d18dSharedStaffingHostTests.py
@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Real colony HTTP test: one named resident cannot hold generic + crew duties."""
+import argparse
+import http.client
+import json
+import pathlib
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+
+args=argparse.ArgumentParser()
+for field in ('host','fixture','relay'):
+    args.add_argument('--'+field,required=True)
+a=args.parse_args()
+
+def free_port():
+    with socket.socket() as s:
+        s.bind(('127.0.0.1',0))
+        return s.getsockname()[1]
+
+class Game:
+    def __init__(self,save):
+        self.port=free_port()
+        self.proc=subprocess.Popen([sys.executable,a.relay,'--colony','--host-exe',a.host,
+             '--save',str(save),'--port',str(self.port),'--tick-ms','75','--max-ticks','1200'],
+             stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+        for _ in range(100):
+            if self.proc.poll() is not None:
+                raise AssertionError('game host exited before health check')
+            try:
+                if self.get('/healthz')[0]==200:break
+            except OSError:pass
+            time.sleep(.05)
+        else:raise AssertionError('game host did not become healthy')
+    def request(self,verb,path,doc=None):
+        c=http.client.HTTPConnection('127.0.0.1',self.port,timeout=12)
+        body=json.dumps(doc).encode() if doc is not None else None
+        h={'Host':'127.0.0.1:'+str(self.port)}
+        if doc is not None:h.update({'Content-Type':'application/json','Origin':'http://127.0.0.1:'+str(self.port)})
+        try:
+            c.request(verb,path,body,headers=h)
+            r=c.getresponse();data=r.read()
+            return r.status,json.loads(data) if 'application/json' in r.getheader('Content-Type','') else data
+        finally:c.close()
+    def get(self,path):return self.request('GET',path)
+    def post(self,path,doc):return self.request('POST',path,doc)
+    def close(self):
+        self.proc.terminate()
+        try:self.proc.communicate(timeout=8)
+        except subprocess.TimeoutExpired:self.proc.kill();self.proc.communicate(timeout=5)
+
+with tempfile.TemporaryDirectory(prefix='sg-d18d-staff-') as temp:
+    save=pathlib.Path(temp)/'world.sqlite'
+    fixture=subprocess.run([a.fixture,str(save)],text=True,capture_output=True,timeout=30)
+    assert fixture.returncode==0,fixture.stderr
+    game=Game(save)
+    try:
+        site=game.get('/factory/api/sites')[1]['sites'][0]
+        token=game.get('/session')[1]['token']
+        def post(route,**fields):return game.post('/factory/api/'+route,{'token':token,'site':site,**fields})
+        worker=game.get(f'/factory/api/crews?site={site}')[1]['residents'][0]
+        assert post('generic_init')[0]==200
+        assert post('generic_machine',id=100)[0]==200
+        code,plan=post('structure_register',layout='sg-colony-structure-plan-v1\n1,70,70\n')
+        assert code==200,(code,plan)
+        planid=plan['plan']['id']
+        # A machine operator must not also be registered on a crew plan.
+        assert post('generic_operator',device=100,npc=worker)[0]==200
+        code,denied=post('crew_assign',plan=planid,npc=worker)
+        assert code==400,(code,denied)
+        assert post('generic_operator',device=100,npc=0)[0]==200
+        # Once released, the same named resident may take a construction job.
+        assert post('crew_assign',plan=planid,npc=worker)[0]==200
+        code,denied=post('generic_operator',device=100,npc=worker)
+        assert code==400,(code,denied)
+        assert not game.get(f'/factory/api/generic_status?site={site}')[1]['machines'][0]['staffed']
+        # Leave construction assignment intact to verify recovery after restart.
+        # A separate custody gate prevents removal while this worker carries modules.
+    finally:game.close()
+    # Crew reservations remain durable across restarts; not just RAM flags.
+    game=Game(save)
+    try:
+        token=game.get('/session')[1]['token']
+        code,denied=game.post('/factory/api/generic_operator',{'token':token,'site':site,'device':100,'npc':worker})
+        assert code==400,(code,denied)
+        # Assignment persists through restart; releasing real cargo requires
+        # completing or safely cancelling the underlying crew job first.
+        code,denied=game.post('/factory/api/generic_operator',{'token':'forged','site':site,'device':100,'npc':0})
+        assert code==403,(code,denied)
+    finally:game.close()
+print('ECON02B2d18d PASS: named NPC cannot serve two duties; released workers can switch; persists across restart')