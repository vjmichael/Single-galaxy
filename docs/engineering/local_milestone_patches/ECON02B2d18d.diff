+bool Crews::worker_has_duty(std::uint64_t npc,PlayerId owner,EntityId ship,EntityId site)const{
+ validate_site(owner,ship,site);
+ if(!npc||npc>static_cast<std::uint64_t>(std::numeric_limits<std::int64_t>::max()))
+   throw std::invalid_argument("Invalid crew worker identifier");
+ for(const char* table:{"sg_construction_workers","sg_construction_restock",
+                        "sg_dismantle_jobs","sg_machine_dismantle_jobs",
+                        "sg_line_evacuation_jobs","sg_line_retirements"}){
+   const std::string query=std::string("SELECT 1 FROM ")+table+" WHERE npc_id=?"+
+       (std::string(table)=="sg_construction_workers"?"":" AND active=1")+" LIMIT 1";
+   Query q(db_->db,query.c_str());q.n(1,static_cast<std::int64_t>(npc));
+   if(q.row())return true;
+ }
+ const auto* stock=world_.world().construction_supplies(site);
+ return stock && (stock->carried.count(npc)||stock->evacuation_cargo.count(npc));
+}
 void Crews::validate_worker(std::uint64_t npc,PlayerId owner,EntityId ship,EntityId site)const{
  validate_site(owner,ship,site);
  const auto& w=world_.world();const auto it=w.npc_records().find(npc);
  if(it==w.npc_records().end()||it->second.home_ship!=ship||it->second.location!=site||it->second.role!=NpcRole::Habitat)
   throw std::invalid_argument("NPC must be an existing on-site habitat resident");
+ if(w.generic_operator_assigned(site,npc))
+  throw std::invalid_argument("NPC is already operating generic factory equipment");
  const auto* h=w.habitat(site);if(!h||h->residents<1)throw std::invalid_argument("No staffed local habitat");
  // Aggregate roles already reserve residents; never count those as construction
  // labor. Individual workshop operators have named reservations too.
