+#pragma once
+// ECON-02B2d18a: deterministic, material-accounted generic factory execution.
+// NOT a second world writer: the colony host must provide authorized stocks,
+// named-worker identity, and durable commit/journal before using this at runtime.
+#include "galaxy/FactoryLayout.hpp"
+#include "galaxy/FactoryRetirementPlanner.hpp"
+#include "galaxy/QuantifiedProduction.hpp"
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace galaxy::industry {
+struct RuntimeMachine {
+    Recipe recipe;
+    Machine machine;
+    State state;
+    std::uint64_t installation_receipt=0;
+    bool shutdown=false;
+};
+struct RuntimeConveyor {
+    std::uint64_t installation_receipt=0;
+    // Tail-first removal. No transfers once dismantling has started.
+    std::size_t remaining_cells=0;
+};
+class FactoryExecution {
+public:
+    FactoryExecution(FactoryLayout layout,std::map<DeviceId,Recipe> recipes);
+    const FactoryLayout& layout()const noexcept{return layout_;}
+    const std::map<DeviceId,RuntimeMachine>& machines()const noexcept{return machines_;}
+    const std::map<ConveyorId,RuntimeConveyor>& conveyors()const noexcept{return conveyors_;}
+    std::uint64_t tick_count()const noexcept{return tick_;}
+    // The caller supplies actual module custody; it is debited only on success.
+    // Receipt IDs are unique and durable, never silently reused.
+    void install_machine(DeviceId id,std::int64_t& modules,std::uint64_t receipt);
+    void install_conveyor(ConveyorId id,std::int64_t& modules,std::uint64_t receipt);
+    // Both accounts must be site-local, physically accessible and authorized
+    // by the primary colony host; no nonlocal or automatic teleport is implied.
+    void load(DeviceId id,Store& source,const std::string& item,std::int64_t grams);
+    void unload(DeviceId id,Store& destination,const std::string& item,std::int64_t grams);
+    void set_operator(DeviceId id,bool present);
+    void set_shutdown(DeviceId id,bool requested);
+    // One tick moves through explicitly installed links and advances recipes.
+    // Even offline/background execution obeys all inventory limits.
+    void step();
+    void steps(std::uint64_t n);
+    std::vector<RetirementNode> retirement_order()const;
+    // Dismantling is a worker-action adapter target: the world must separately
+    // verify a named NPC and its position before calling either operation.
+    // An NPC has at most two module cargo slots; rejects full cargo atomically.
+    bool remove_conveyor_piece(ConveyorId id,std::int64_t& worker_cargo);
+    void dismantle_machine(DeviceId id,std::int64_t& worker_cargo);
+    std::int64_t internal_mass_grams()const;
+    std::int64_t embodied_modules()const;
+    std::string checkpoint()const;
+    static FactoryExecution restore(FactoryLayout layout,std::map<DeviceId,Recipe> recipes,
+                                    const std::string& bytes);
+private:
+    void check_recipe_catalog()const;
+    RuntimeMachine& machine_at(DeviceId id);
+    const RuntimeMachine& machine_at(DeviceId id)const;
+    void transfer_link(ConveyorId id);
+    std::string config_signature()const;
+    FactoryLayout layout_;
+    std::map<DeviceId,Recipe> recipes_;
+    std::map<DeviceId,RuntimeMachine> machines_;
+    std::map<ConveyorId,RuntimeConveyor> conveyors_;
+    std::set<std::uint64_t> receipts_;
+    std::uint64_t tick_=0;
+};
+} // namespace galaxy::industry
diff --git a/src/FactoryExecution.cpp b/src/FactoryExecution.cpp
