+static void rejects(const std::function<void()>& fn){bool threw=false;try{fn();}catch(const std::exception&){threw=true;}CHECK(threw);}
+static FactoryLayout blueprint(){
+ FactoryLayout b;
+ b.place_machine(100,{0,0},1,{"good/aluminum"},{"good/aluminum_panels","good/aluminum_scrap"});
+ b.place_machine(200,{5,0},1,{"good/aluminum_panels"},{"good/aluminum_frames","good/aluminum_scrap"});
+ b.add_conveyor(800,100,200,"good/aluminum_panels",1000,{{2,0},{3,0},{4,0}});
+ return b;
+}
+static std::map<DeviceId,Recipe> recipes(){return {
+ {100,{"panel_cut","cut",{{"good/aluminum",20000}},
+     {"good/aluminum_panels",19000},{"good/aluminum_scrap",1000}}},
+ {200,{"frame_shape","shape",{{"good/aluminum_panels",20000}},
+     {"good/aluminum_frames",19000},{"good/aluminum_scrap",1000}}}
+};}
+static std::int64_t tally(const FactoryExecution& factory,const Store& ship,
+                          const Store& depot,std::int64_t available_modules,
+                          std::int64_t worker_modules){
+ return ship.used()+depot.used()+factory.internal_mass_grams()+
+        (available_modules+worker_modules+factory.embodied_modules())*2000000;
+}
+static void evacuate(FactoryExecution& f,DeviceId id,Store& warehouse){
+ f.set_shutdown(id,true);
+ const auto m=f.machines().at(id);
+ for(const auto& [code,qty]:m.state.feed.grams)f.unload(id,warehouse,code,qty);
+ for(const auto& [code,qty]:m.state.finished.grams)f.unload(id,warehouse,code,qty);
+ for(const auto& [code,qty]:m.state.scrap.grams)f.unload(id,warehouse,code,qty);
+}
+int main(){try{
+ // A ghost layout cannot perform production without real installation.
+ FactoryExecution f(blueprint(),recipes());
+ Store ship{2000000,{}},warehouse{2000000,{}};
+ ship.deposit("good/aluminum",60000);
+ std::int64_t modules=8,carrier=0;
+ auto conserved=tally(f,ship,warehouse,modules,carrier);
+ rejects([&]{f.load(100,ship,"good/aluminum",20000);});
+ rejects([&]{f.install_conveyor(800,modules,9);});
+ rejects([&]{f.install_machine(100,modules,0);});
+ f.install_machine(100,modules,1);f.install_machine(200,modules,2);
+ CHECK(modules==6 && f.embodied_modules()==2);
+ rejects([&]{f.install_machine(100,modules,3);});
+ rejects([&]{f.install_machine(200,modules,1);});
+ f.install_conveyor(800,modules,3);
+ CHECK(modules==2 && f.embodied_modules()==6);
+ CHECK(tally(f,ship,warehouse,modules,carrier)==conserved);
+ rejects([&]{f.install_conveyor(800,modules,4);});
+ const auto retire=f.retirement_order();
+ CHECK(retire.size()==3);
+ CHECK((retire.at(0)==RetirementNode{RetirementKind::Conveyor,800}));
+ CHECK((retire.at(1)==RetirementNode{RetirementKind::Machine,200}));
+ CHECK((retire.at(2)==RetirementNode{RetirementKind::Machine,100}));
+ rejects([&]{f.load(100,ship,"good/aluminum",70000);});
+ f.load(100,ship,"good/aluminum",40000);
+ CHECK(ship.amount("good/aluminum")==20000);
+ rejects([&]{f.load(200,ship,"good/aluminum",100);});
+ f.set_operator(100,true);f.set_operator(200,true);
+ f.steps(2);
+ CHECK(f.machines().at(100).state.has_work_in_progress);
+ CHECK(tally(f,ship,warehouse,modules,carrier)==conserved);
