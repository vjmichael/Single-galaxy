--- /dev/null
+++ b/src/FactoryExecution.cpp
@@ -0,0 +1,294 @@
+#include "galaxy/FactoryExecution.hpp"
+#include <algorithm>
+#include <cctype>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+#include <utility>
+
+namespace galaxy::industry {
+namespace {
+using I=std::int64_t;
+I sum(I a,I b){if(a<0||b<0||a>std::numeric_limits<I>::max()-b)throw std::overflow_error("factory inventory overflow");return a+b;}
+void valid_code(const std::string& x){
+ if(x.empty()||x.size()>80||!std::all_of(x.begin(),x.end(),[](unsigned char c){return std::isalnum(c)||c=='_'||c=='-'||c=='/';}))
+  throw std::invalid_argument("invalid factory material code");
+}
+void transfer(Store& from,Store& to,const std::string& code,I grams){
+ valid_code(code);
+ if(grams<=0||from.amount(code)<grams||to.free_space()<grams)
+  throw std::invalid_argument("factory transfer lacks real source or capacity");
+ // Deposit first: if map allocation throws, the physical source remains intact.
+ to.deposit(code,grams);from.withdraw(code,grams);
+}
+std::string as_string(const Recipe& r){
+ std::ostringstream s;s<<r.name<<'|'<<r.operation<<'|'<<r.product.code<<':'<<r.product.grams
+ <<'|'<<r.scrap.code<<':'<<r.scrap.grams;
+ for(const auto& x:r.inputs)s<<'|'<<x.code<<':'<<x.grams;
+ return s.str();
+}
+std::vector<std::string> split(const std::string& in,char separator='|'){
+ std::vector<std::string> p;std::size_t from=0;
+ for(std::size_t i=0;i<=in.size();++i)if(i==in.size()||in[i]==separator){p.push_back(in.substr(from,i-from));from=i+1;}
+ return p;
+}
+std::uint64_t number(const std::string& s){
+ if(s.empty()||s[0]=='+'||s[0]=='-'||s.find_first_not_of("0123456789")!=std::string::npos)
+  throw std::invalid_argument("invalid factory checkpoint number");
+ std::size_t used=0;auto x=std::stoull(s,&used);if(used!=s.size())throw std::invalid_argument("factory checkpoint integer suffix");return x;
+}
+I signed_number(const std::string& s){
+ if(s.empty()||s[0]=='+')throw std::invalid_argument("invalid checkpoint integer");
+ std::size_t used=0;auto x=std::stoll(s,&used);if(used!=s.size())throw std::invalid_argument("checkpoint integer suffix");return x;
+}
+// v1 is bound to the caller's immutable configuration. Not cryptographic;
+// the host's durable journal must additionally establish authorization.
+std::uint64_t fingerprint(const std::string& data){
+ std::uint64_t h=14695981039346656037ull;
+ for(unsigned char c:data){h^=c;h*=1099511628211ull;}return h;
+}
+I buffer_capacity(std::uint8_t tier){
+ if(tier<1||tier>5)throw std::invalid_argument("invalid machinery tier");
+ return static_cast<I>(1000000) << (tier-1); // each tier has a physically larger buffer
+}
+void store_out(std::ostringstream& out,const char* label,DeviceId id,const Store& s){
+ for(const auto& [name,grams]:s.grams)if(grams>0)out<<label<<'|'<<id<<'|'<<name<<'|'<<grams<<'\n';
+}
+}
+FactoryExecution::FactoryExecution(FactoryLayout layout,std::map<DeviceId,Recipe> recipes)
+ :layout_(std::move(layout)),recipes_(std::move(recipes)){check_recipe_catalog();}
+void FactoryExecution::check_recipe_catalog()const{
+ for(const auto& [id,recipe]:recipes_){
+  const auto it=layout_.devices().find(id);
+  if(it==layout_.devices().end()||it->second.kind!=DeviceKind::Machine)
+   throw std::invalid_argument("recipe has no corresponding machine blueprint");
+  valid_code(recipe.name);valid_code(recipe.operation);
+  Machine m{it->second.tier,recipe.operation,true,true,true};
+  State state;state.feed.capacity_grams=buffer_capacity(it->second.tier);state.finished.capacity_grams=buffer_capacity(it->second.tier);state.scrap.capacity_grams=buffer_capacity(it->second.tier);
+  (void)QuantifiedLine(recipe,m,state); // checks balanced recipe and all tier multipliers
+  for(const auto& input:recipe.inputs){valid_code(input.code);
+   if(std::find(it->second.inputs.begin(),it->second.inputs.end(),input.code)==it->second.inputs.end())
+    throw std::invalid_argument("recipe input absent from machine port");
+  }
+  valid_code(recipe.product.code);valid_code(recipe.scrap.code);
+  if(std::find(it->second.outputs.begin(),it->second.outputs.end(),recipe.product.code)==it->second.outputs.end()||
+     std::find(it->second.outputs.begin(),it->second.outputs.end(),recipe.scrap.code)==it->second.outputs.end())
+   throw std::invalid_argument("recipe output absent from machine port");
+ }
+ for(const auto& [id,d]:layout_.devices())if(d.kind==DeviceKind::Machine&&!recipes_.count(id))
+  throw std::invalid_argument("machine blueprint lacks declared recipe");
+}
+RuntimeMachine& FactoryExecution::machine_at(DeviceId id){
+ auto it=machines_.find(id);if(it==machines_.end())throw std::invalid_argument("factory machine is not installed");return it->second;
+}
+const RuntimeMachine& FactoryExecution::machine_at(DeviceId id)const{
+ auto it=machines_.find(id);if(it==machines_.end())throw std::invalid_argument("factory machine is not installed");return it->second;
+}
+void FactoryExecution::install_machine(DeviceId id,I& modules,std::uint64_t receipt){
+ const auto d=layout_.devices().find(id);
+ if(d==layout_.devices().end()||d->second.kind!=DeviceKind::Machine||!recipes_.count(id)||machines_.count(id)||!receipt||receipts_.count(receipt)||modules<1)
+  throw std::invalid_argument("invalid material-backed machine installation");
+ RuntimeMachine machine;machine.recipe=recipes_.at(id);
+ machine.machine={d->second.tier,machine.recipe.operation,true,false,true};
+ machine.state.feed.capacity_grams=buffer_capacity(d->second.tier);machine.state.finished.capacity_grams=buffer_capacity(d->second.tier);machine.state.scrap.capacity_grams=buffer_capacity(d->second.tier);
+ machine.installation_receipt=receipt;
+// Install atomically with respect to a failed container allocation.
+ receipts_.insert(receipt);
+ try{machines_.emplace(id,std::move(machine));}
+ catch(...){receipts_.erase(receipt);throw;}
+ --modules;
+}
+void FactoryExecution::install_conveyor(ConveyorId id,I& modules,std::uint64_t receipt){
+ const auto it=layout_.conveyors().find(id);
+ if(it==layout_.conveyors().end()||conveyors_.count(id)||!receipt||receipts_.count(receipt)||
+    !machines_.count(it->second.from)||!machines_.count(it->second.to))
+  throw std::invalid_argument("conveyor endpoints not physically installed");
+ const auto cells=it->second.path.size();
+ if(cells>=static_cast<std::size_t>(std::numeric_limits<I>::max())||modules<static_cast<I>(cells+1))
+  throw std::invalid_argument("insufficient modules to build real conveyor route");
+ receipts_.insert(receipt);
+ try{conveyors_.emplace(id,RuntimeConveyor{receipt,cells});}
+ catch(...){receipts_.erase(receipt);throw;}
+ modules-=static_cast<I>(cells+1);
+}
+void FactoryExecution::load(DeviceId id,Store& source,const std::string& item,I grams){
+ auto& m=machine_at(id);
+ if(m.shutdown)throw std::invalid_argument("factory intake shut down");
+ if(std::find_if(m.recipe.inputs.begin(),m.recipe.inputs.end(),[&](const Material& x){return x.code==item;})==m.recipe.inputs.end())
+  throw std::invalid_argument("item not a declared input");
+ if(QuantifiedLine(m.recipe,m.machine,m.state).total_mass_grams()>buffer_capacity(m.machine.tier)-grams)
+  throw std::invalid_argument("physical machine buffer is full");
+ transfer(source,m.state.feed,item,grams);
+}
+void FactoryExecution::unload(DeviceId id,Store& dest,const std::string& item,I grams){
+ auto& m=machine_at(id);
+ if(m.recipe.product.code==item)transfer(m.state.finished,dest,item,grams);
+ else if(m.recipe.scrap.code==item)transfer(m.state.scrap,dest,item,grams);
+ else if(m.shutdown)transfer(m.state.feed,dest,item,grams);
+ else throw std::invalid_argument("cannot evacuate operating machine input");
+}
+void FactoryExecution::set_operator(DeviceId id,bool present){machine_at(id).machine.staffed=present;}
+void FactoryExecution::set_shutdown(DeviceId id,bool requested){machine_at(id).shutdown=requested;}
+void FactoryExecution::transfer_link(ConveyorId id){
+ const auto link=conveyors_.find(id);if(link==conveyors_.end())return;
+ const auto& spec=layout_.conveyors().at(id);
+ if(link->second.remaining_cells!=spec.path.size())return;
+ auto& src=machine_at(spec.from);auto& dst=machine_at(spec.to);
+ if(src.shutdown||dst.shutdown)return;
+ const auto goods=src.state.finished.amount(spec.item_code);
+ if(goods<=0)return;
+ // Site goods use the v1 industrial game abstraction: 1 volume unit = 1000g.
+ // Installed conveyor throughput is specified in volume units per tick.
+ const auto available=buffer_capacity(dst.machine.tier)-QuantifiedLine(dst.recipe,dst.machine,dst.state).total_mass_grams();
+ auto count=std::min({goods,dst.state.feed.free_space(),spec.units_per_tick*1000,available});
+ if(count<=0)return;
+ transfer(src.state.finished,dst.state.feed,spec.item_code,count);
+}
+void FactoryExecution::step(){
+ if(tick_==std::numeric_limits<std::uint64_t>::max())throw std::overflow_error("factory tick overflow");
+ // Stable one-tick order; material travels only through installed physical links.
+ for(const auto& [id,link]:conveyors_){(void)link;transfer_link(id);}
+ for(auto& [id,m]:machines_){(void)id;
+  if(m.shutdown&&!m.state.has_work_in_progress)continue;
+  QuantifiedLine q(m.recipe,m.machine,m.state);
+  q.advance(1);m.state=q.state();
+ }
+ ++tick_;
+}
+void FactoryExecution::steps(std::uint64_t n){for(std::uint64_t i=0;i<n;++i)step();}
+std::vector<RetirementNode> FactoryExecution::retirement_order()const{
+ std::vector<RetirementNode> nodes;std::vector<RetirementDependency> edges;
+ for(const auto& [id,m]:machines_){(void)m;nodes.push_back({RetirementKind::Machine,id});}
+ for(const auto& [id,conveyor]:conveyors_){(void)conveyor;
+  const auto& route=layout_.conveyors().at(id);
+  const RetirementNode l{RetirementKind::Conveyor,id},src{RetirementKind::Machine,route.from},dst{RetirementKind::Machine,route.to};
+  nodes.push_back(l);edges.push_back({l,src});edges.push_back({l,dst});
+  // Downstream machines retire before their suppliers.
+  edges.push_back({dst,src});
+ }
+ return plan_factory_retirement(nodes,edges);
+}
+bool FactoryExecution::remove_conveyor_piece(ConveyorId id,I& cargo){
+ const auto it=conveyors_.find(id);if(it==conveyors_.end()||cargo<0||cargo>=2)
+  throw std::invalid_argument("invalid conveyor dismantling cargo");
+ const auto& route=layout_.conveyors().at(id);
+ const auto& src=machine_at(route.from);const auto& dst=machine_at(route.to);
+ if(!src.shutdown||!dst.shutdown||src.state.has_work_in_progress||dst.state.has_work_in_progress)
+  throw std::invalid_argument("production must drain before conveyor demolition");
+ ++cargo;
+ if(it->second.remaining_cells){--it->second.remaining_cells;return false;}
+ conveyors_.erase(it);return true;
+}
+void FactoryExecution::dismantle_machine(DeviceId id,I& cargo){
+ const auto& m=machine_at(id);
+ if(cargo<0||cargo>=2||!m.shutdown||m.machine.staffed||m.state.has_work_in_progress||
+    m.state.feed.used()||m.state.finished.used()||m.state.scrap.used())
+  throw std::invalid_argument("machine still occupied, working or stocked");
+ for(const auto& [link_id,route]:conveyors_){(void)route;
+  const auto& spec=layout_.conveyors().at(link_id);
+  if(spec.from==id||spec.to==id)throw std::invalid_argument("machine has installed conveyor dependencies");
+ }
+ ++cargo;machines_.erase(id);
+}
+I FactoryExecution::internal_mass_grams()const{
+ I mass=0;
+ for(const auto& [id,m]:machines_){(void)id;mass=sum(mass,QuantifiedLine(m.recipe,m.machine,m.state).total_mass_grams());}
+ return mass;
+}
+I FactoryExecution::embodied_modules()const{
+ I qty=static_cast<I>(machines_.size());
+ for(const auto& [id,r]:conveyors_){(void)id;qty=sum(qty,static_cast<I>(r.remaining_cells+1));}
+ return qty;
+}
+std::string FactoryExecution::config_signature()const{
+ std::ostringstream s;s<<layout_.canonical_blueprint();
+ for(const auto& [id,r]:recipes_)s<<id<<'|'<<as_string(r)<<'\n';
+ return std::to_string(fingerprint(s.str()));
+}
+std::string FactoryExecution::checkpoint()const{
+ std::ostringstream out;
+ out<<"sg-factory-execution-v1|"<<config_signature()<<'|'<<tick_<<'\n';
+ for(const auto& [id,m]:machines_){
+  out<<"M|"<<id<<'|'<<m.installation_receipt<<'|'<<(m.shutdown?1:0)<<'|'
+    <<(m.machine.powered?1:0)<<'|'<<(m.machine.staffed?1:0)<<'|'
+    <<(m.machine.maintained?1:0)<<'|'<<(m.state.has_work_in_progress?1:0)<<'|'
+    <<m.state.ticks_remaining<<'|'<<m.state.elapsed_ticks<<'|'<<m.state.completed_batches<<'\n';
+  store_out(out,"F",id,m.state.feed);store_out(out,"O",id,m.state.finished);
+  store_out(out,"S",id,m.state.scrap);
+  for(const auto& r:m.state.reserved_inputs)out<<"W|"<<id<<'|'<<r.code<<'|'<<r.grams<<'\n';
+ }
+ for(const auto& [id,link]:conveyors_)
+  out<<"C|"<<id<<'|'<<link.installation_receipt<<'|'<<link.remaining_cells<<'\n';
+ for(const auto receipt:receipts_)out<<"R|"<<receipt<<'\n';
+ return out.str();
+}
+FactoryExecution FactoryExecution::restore(FactoryLayout layout,std::map<DeviceId,Recipe> recipes,const std::string& bytes){
+ if(bytes.empty()||bytes.size()>8*1024*1024||bytes.back()!='\n'||bytes.find('\r')!=std::string::npos||bytes.find('\0')!=std::string::npos)
+  throw std::invalid_argument("invalid factory checkpoint framing");
+ FactoryExecution result(std::move(layout),std::move(recipes));
+ std::istringstream input(bytes);std::string line;
+ std::getline(input,line);auto head=split(line);
+ if(head.size()!=3||head[0]!="sg-factory-execution-v1"||head[1]!=result.config_signature())
+  throw std::invalid_argument("factory checkpoint configuration mismatch");
+ result.tick_=number(head[2]);
+ std::set<std::uint64_t> instances;
+ while(std::getline(input,line)){
+  const auto p=split(line);
+  if(p.empty())throw std::invalid_argument("empty checkpoint row");
+  if(p[0]=="M"&&p.size()==11){
+   const auto id=number(p[1]),receipt=number(p[2]);
+   if(!id||!receipt||result.machines_.count(id)||!result.recipes_.count(id))throw std::invalid_argument("invalid machine record");
+   const auto& d=result.layout_.devices().at(id);
+   RuntimeMachine m;m.recipe=result.recipes_.at(id);
+   m.machine={d.tier,m.recipe.operation,number(p[4])==1,number(p[5])==1,number(p[6])==1};
+   if(number(p[4])>1||number(p[5])>1||number(p[6])>1||number(p[3])>1||number(p[7])>1)throw std::invalid_argument("invalid machine flag");
+   m.shutdown=number(p[3])==1;m.installation_receipt=receipt;
+   m.state.feed.capacity_grams=buffer_capacity(d.tier);m.state.finished.capacity_grams=buffer_capacity(d.tier);m.state.scrap.capacity_grams=buffer_capacity(d.tier);
+   m.state.has_work_in_progress=number(p[7])==1;
+   const auto remain=number(p[8]);if(remain>6)throw std::invalid_argument("invalid unfinished cycle");
+   m.state.ticks_remaining=static_cast<std::uint32_t>(remain);
+   m.state.elapsed_ticks=number(p[9]);m.state.completed_batches=number(p[10]);
+   result.machines_.emplace(id,std::move(m));
+   if(!instances.insert(receipt).second)throw std::invalid_argument("duplicate installation receipt");
+  }else if((p[0]=="F"||p[0]=="O"||p[0]=="S"||p[0]=="W")&&p.size()==4){
+   const auto id=number(p[1]);auto& m=result.machine_at(id);valid_code(p[2]);
+   const auto amount=signed_number(p[3]);if(amount<=0)throw std::invalid_argument("invalid inventory mass");
+   if(p[0]=="W")m.state.reserved_inputs.push_back({p[2],amount});
+   else {
+    auto& store=p[0]=="F"?m.state.feed:p[0]=="O"?m.state.finished:m.state.scrap;
+    if(store.amount(p[2]))throw std::invalid_argument("duplicate material stock");
+    store.deposit(p[2],amount);
+   }
+  }else if(p[0]=="C"&&p.size()==4){
+   const auto id=number(p[1]),receipt=number(p[2]),remaining=number(p[3]);
+   const auto it=result.layout_.conveyors().find(id);
+   if(!id||!receipt||it==result.layout_.conveyors().end()||result.conveyors_.count(id)||
+      remaining>it->second.path.size()||!result.machines_.count(it->second.from)||!result.machines_.count(it->second.to))
+    throw std::invalid_argument("invalid installed conveyor");
+   if(!instances.insert(receipt).second)throw std::invalid_argument("duplicate installation receipt");
+   result.conveyors_.emplace(id,RuntimeConveyor{receipt,static_cast<std::size_t>(remaining)});
+  }else if(p[0]=="R"&&p.size()==2){
+   auto receipt=number(p[1]);if(!receipt||!result.receipts_.insert(receipt).second)
+    throw std::invalid_argument("invalid receipt history");
+  }else throw std::invalid_argument("unsupported factory checkpoint row");
+ }
+ for(const auto receipt:instances)if(!result.receipts_.count(receipt))
+  throw std::invalid_argument("installed machinery lacks durable purchase receipt");
+ for(const auto& [id,m]:result.machines_){(void)id;
+  const auto mass=QuantifiedLine(m.recipe,m.machine,m.state).total_mass_grams();
+  if(mass>buffer_capacity(m.machine.tier))throw std::invalid_argument("factory machine exceeds physical buffer");
+  for(const auto& [item,grams]:m.state.feed.grams){(void)grams;
+   if(std::none_of(m.recipe.inputs.begin(),m.recipe.inputs.end(),[&](const Material& r){return r.code==item;}))
+    throw std::invalid_argument("undeclared feed inventory");
+  }
+  for(const auto& [name,grams]:m.state.finished.grams){(void)grams;
+   if(name!=m.recipe.product.code)throw std::invalid_argument("undeclared output inventory");
+  }
+  for(const auto& [name,grams]:m.state.scrap.grams){(void)grams;
+   if(name!=m.recipe.scrap.code)throw std::invalid_argument("undeclared scrap inventory");
+  }
+ }
+ if(result.checkpoint()!=bytes)throw std::invalid_argument("noncanonical factory checkpoint");
+ return result;
+}
