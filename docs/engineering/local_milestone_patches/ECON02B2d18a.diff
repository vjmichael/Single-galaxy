+ CHECK(!recovered.remove_conveyor_piece(800,carrier));
+ CHECK(!recovered.remove_conveyor_piece(800,carrier));
+ CHECK(carrier==2);
+ rejects([&]{recovered.remove_conveyor_piece(800,carrier);});
