+ // Production and dismantling leave a fully reproducible checkpoint.
+ CHECK(FactoryExecution::restore(blueprint(),recipes(),recovered.checkpoint()).checkpoint()==recovered.checkpoint());
+ // Tier 5 remains executable: batch size scales 256x, with the larger
