+ CHECK(recovered.checkpoint()==mid);
+ CHECK(recovered.tick_count()==2);
+ rejects([&]{auto changed=mid;changed[0]='X';(void)FactoryExecution::restore(blueprint(),recipes(),changed);});
+ rejects([&]{auto changed=mid;changed.insert(changed.find("M|"),"F|100|phantom|1000\n");
+         (void)FactoryExecution::restore(blueprint(),recipes(),changed);});
+ rejects([&]{auto changed=mid;changed+="R|3\n";(void)FactoryExecution::restore(blueprint(),recipes(),changed);});
+ // Real production and directed link transfer, driven by fixed simulation ticks.
+ recovered.steps(75);
