+++ b/tests/ECON02B2d18bFactoryHostTests.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+"""Real localhost colony API + SQLite persistence for approved generic factory."""
+import argparse, http.client, json, pathlib, socket, subprocess, sys, tempfile, time
+p=argparse.ArgumentParser()
+for name in ('host','fixture','relay'):p.add_argument('--'+name,required=True)
+a=p.parse_args()
+def port():
+ with socket.socket() as s:
+  s.bind(('127.0.0.1',0));return s.getsockname()[1]
+class Game:
+ def __init__(self,db):
+  self.port=port()
+  self.proc=subprocess.Popen([sys.executable,a.relay,'--colony','--host-exe',a.host,'--save',str(db),
+    '--port',str(self.port),'--tick-ms','75','--max-ticks','1200'],stdin=subprocess.DEVNULL,
+    stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+  for _ in range(120):
+   if self.proc.poll() is not None:raise AssertionError('host exited unexpectedly')
+   try:
+    if self.get('/healthz')[0]==200:break
+   except (OSError,TimeoutError):pass
+   time.sleep(.05)
+  else:raise AssertionError('host start timeout')
+ def request(self,method,path,doc=None,origin=None):
+  c=http.client.HTTPConnection('127.0.0.1',self.port,timeout=12)
+  body=json.dumps(doc).encode('utf-8') if doc is not None else None
+  headers={'Host':f'127.0.0.1:{self.port}'}
+  if body is not None:
+   headers.update({'Content-Type':'application/json','Origin':origin or f'http://127.0.0.1:{self.port}'})
+  try:
+   c.request(method,path,body,headers)
+   resp=c.getresponse();raw=resp.read();ct=resp.getheader('Content-Type','')
+   return resp.status,json.loads(raw) if 'application/json' in ct else raw
+  finally:c.close()
+ def get(self,path):return self.request('GET',path)
+ def post(self,path,doc,origin=None):return self.request('POST',path,doc,origin)
+ def close(self):
+  self.proc.terminate()
+  try:self.proc.communicate(timeout=8)
+  except subprocess.TimeoutExpired:self.proc.kill();self.proc.communicate(timeout=5)
+with tempfile.TemporaryDirectory(prefix='sg-d18b-http-') as d:
+ db=pathlib.Path(d)/'factory.sqlite'
+ fixture=subprocess.run([a.fixture,str(db)],capture_output=True,text=True,timeout=20)
+ assert fixture.returncode==0,(fixture.stdout,fixture.stderr)
+ game=Game(db)
+ try:
+  status,s=game.get('/factory/api/sites');assert status==200 and len(s['sites'])==1,(status,s)
+  site=s['sites'][0]
+  token=game.get('/session')[1]['token']
+  post=lambda endpoint,doc:game.post('/factory/api/'+endpoint,{'token':token,'site':site,**doc})
+  status,state=game.get(f'/factory/api/generic_status?site={site}')
+  assert status==200 and state['installed'] is False,(status,state)
+  for bad in ({'token':'fake','site':site}, {'token':token,'site':site+123}, {'token':token,'site':str(site)}):
+   status,_=game.post('/factory/api/generic_init',bad);assert status in (400,403),(status,bad)
+  status,_=game.post('/factory/api/generic_init',{'token':token,'site':site},origin='http://evil.invalid')
+  assert status==403
+  status,_=post('generic_machine',{'id':True});assert status==400
+  status,_=post('generic_transfer',{'amount':True,'device':100,'item':0});assert status==400
+  status,_=post('generic_init',{});assert status==200
+  status,_=post('generic_init',{});assert status==400
+  status,_=post('generic_link',{'id':800});assert status==400 # cannot install link before machines
+  for device in (100,200):
+   status,r=post('generic_machine',{'id':device});assert status==200,(device,status,r)
+  status,r=post('generic_link',{'id':800});assert status==200,(status,r)
+  status,r=post('generic_transfer',{'amount':10,'device':100,'item':0})
+  assert status==400,(status,r) # empty local warehouse, never free material
+  status,state=game.get(f'/factory/api/generic_status?site={site}')
+  assert status==200 and state['installed'] and state['modules']==6 and len(state['machines'])==2,state
+  status,crews=game.get(f'/factory/api/crews?site={site}')
+  assert status==200 and crews['residents'],crews
+  worker=crews['residents'][0]
+  status,r=post('generic_operator',{'device':100,'npc':worker});assert status==200,(status,r)
+  status,r=post('generic_shutdown',{'device':100,'shutdown':True});assert status==200,(status,r)
+  status,state=game.get(f'/factory/api/generic_status?site={site}')
+  assert state['machines'][0]['staffed'] and state['machines'][0]['shutdown'],state
+ finally:game.close()
+ game=Game(db)
+ try:
+  status,state=game.get(f'/factory/api/generic_status?site={site}')
+  assert status==200 and state['modules']==6 and state['machines'][0]['shutdown'] and state['machines'][0]['staffed'],state+ finally:game.close()
+print('ECON-d18b host PASS: localhost auth, inventory denial, material-backed installation, operator/shutdown and restart')
