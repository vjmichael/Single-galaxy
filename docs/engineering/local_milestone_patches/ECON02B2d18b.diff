+Event Plans::generic_factory_action(Action action,std::int64_t amount,int device,int item,
+                                   PlayerId owner,EntityId ship,EntityId site){
+ if(action!=Action::InitializeGenericFactory && action!=Action::InstallGenericMachine &&
+    action!=Action::InstallGenericConveyor && action!=Action::TransferGenericMaterial &&
+    action!=Action::SetGenericOperator && action!=Action::SetGenericShutdown)
+    throw std::invalid_argument("Unsupported generic factory action");
+ if((action==Action::InitializeGenericFactory && (amount!=1||device||item)) ||
+    ((action==Action::InstallGenericMachine||action==Action::InstallGenericConveyor) &&
+       ((action==Action::InstallGenericMachine && amount!=100 && amount!=200) ||
+        (action==Action::InstallGenericConveyor && amount!=800) || device||item)) ||
+    (action==Action::TransferGenericMaterial && (!amount||amount < -1000||amount>1000 ||
+         (device!=100&&device!=200)||item<0||item>3)) ||
+    (action==Action::SetGenericOperator && (amount<0||amount>std::numeric_limits<int>::max()/4 ||
+         (device!=100&&device!=200)||item)) ||
+    (action==Action::SetGenericShutdown && ((amount!=0&&amount!=1)||
+         (device!=100&&device!=200)||item)))
+     throw std::invalid_argument("Invalid generic factory command");
+ std::lock_guard<std::mutex> guard(lifecycle);
+ authorize(owner,ship,site);
+ db_->begin();std::int64_t id=0;
+ try{id=fresh_id();db_->commit();}catch(...){db_->rollback();throw;}
+ return submit(id,owner,ship,site,action,amount,device,item);
+}
