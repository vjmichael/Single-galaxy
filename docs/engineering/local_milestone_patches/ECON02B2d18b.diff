+FactoryExecution FactoryExecution::from_configuration(const std::string& config,
+                                                      const std::string& checkpoint){
+ if(config.size()>1024*1024 || config.find('\r')!=std::string::npos ||
+    config.find('\0')!=std::string::npos ||
+    config.compare(0,28,"sg-factory-configuration-v1\n")!=0)
+    throw std::invalid_argument("factory configuration framing");
+ const auto newline=config.find('\n',28);
+ if(newline==std::string::npos)throw std::invalid_argument("factory configuration missing size");
+ const auto length=number(config.substr(28,newline-28));
+ if(length>512*1024 || newline+1+length>config.size())
+    throw std::invalid_argument("factory blueprint length invalid");
+ const auto layout_text=config.substr(newline+1,static_cast<std::size_t>(length));
+ auto layout=FactoryLayout::from_blueprint(layout_text);
+ std::map<DeviceId,Recipe> recipes;
+ std::istringstream lines(config.substr(newline+1+static_cast<std::size_t>(length)));
+ std::string record;
+ while(std::getline(lines,record)){
+  const auto f=split(record);
+  if(f.size()<7||f[0]!="R")throw std::invalid_argument("invalid factory recipe record");
+  const auto id=number(f[1]);
+  Recipe r;r.name=f[2];r.operation=f[3];
+  auto parse_material=[](const std::string& v){
+   const auto at=v.find(':');
+   if(at==std::string::npos||v.find(':',at+1)!=std::string::npos)
+    throw std::invalid_argument("invalid factory material");
+   const auto grams=number(v.substr(at+1));
+   if(grams>static_cast<std::uint64_t>(std::numeric_limits<I>::max()))
+    throw std::invalid_argument("invalid factory material amount");
+   return Material{v.substr(0,at),static_cast<I>(grams)};
+  };
+  r.product=parse_material(f[4]);r.scrap=parse_material(f[5]);
+  for(std::size_t i=6;i<f.size();++i)r.inputs.push_back(parse_material(f[i]));
+  if(!recipes.emplace(id,std::move(r)).second)throw std::invalid_argument("duplicate factory recipe");
+ }
+ FactoryExecution result=FactoryExecution::restore(std::move(layout),std::move(recipes),checkpoint);
+ if(result.configuration()!=config)throw std::invalid_argument("noncanonical factory configuration");
