+   ok(action(w,ship,2,Action::RefineOre,0,120));
+   ok(action(w,ship,3,Action::FabricateModule,0,45));
+   ok(action(w,ship,4,Action::ConstructOutpost));site=w.world().built_outposts().begin()->first;
+   ok(action(w,ship,5,Action::ConstructStorage,site));
+   ok(action(w,ship,6,Action::ConstructHabitat,site));
+   for(int i=1;i<=3;++i)ok(action(w,ship,6+i,Action::TransferHabitatStock,site,100,i));
+   ok(action(w,ship,10,Action::AssignHabitatResidents,site,1));
+   ok(action(w,ship,11,Action::StageConstructionModules,site,8));
+   CHECK(w.world().total_material_kg()==base_mass);
+   if(argc==2)return 0; // World fixture for the real authenticated HTTP host test.
+   CHECK(action(w,ship,12,Action::InitializeGenericFactory,site,1,0,0,8).result==Outcome::Unauthorized);
+   ok(action(w,ship,13,Action::InitializeGenericFactory,site));
+   CHECK(w.world().generic_factory(site));
+   CHECK(w.world().generic_factory(site)->machines().empty());
+   CHECK(w.world().canonical_state().rfind("galaxy-kernel-v41|",0)==0);
+   const auto saved=w.world().canonical_state();
+   CHECK(Simulation::from_snapshot(saved).canonical_state()==saved);
+   CHECK(action(w,ship,14,Action::InitializeGenericFactory,site).result==Outcome::InvalidTarget);
+   CHECK(action(w,ship,15,Action::InstallGenericConveyor,site,800).result!=Outcome::Applied);
+   ok(action(w,ship,16,Action::InstallGenericMachine,site,100));
+   ok(action(w,ship,17,Action::InstallGenericMachine,site,200));
+   ok(action(w,ship,18,Action::InstallGenericConveyor,site,800));
+   CHECK(w.world().generic_factory(site)->embodied_modules()==6);
+   CHECK(w.world().construction_supplies(site)->depot==2);
+   CHECK(w.world().total_material_kg()==base_mass);
+   std::uint64_t worker=0;
+   for(const auto& [id,n]:w.world().npc_records())if(n.location==site&&n.role==NpcRole::Habitat)worker=id;
+   CHECK(worker);
+   CHECK(action(w,ship,19,Action::SetGenericOperator,site,worker,100,0,8).result==Outcome::Unauthorized);
+   ok(action(w,ship,20,Action::SetGenericOperator,site,worker,100));
+   CHECK(w.world().generic_factory(site)->machines().at(100).machine.staffed);
+   CHECK(action(w,ship,21,Action::SetGenericOperator,site,worker,200).result==Outcome::Unauthorized);
+   ok(action(w,ship,22,Action::Mine,mineral,45));
+   ok(action(w,ship,23,Action::RefineMineral,10,18000));
+   ok(action(w,ship,24,Action::TransferStorageStack,site,50,0,0));
+   CHECK(w.world().storage(site)->goods_kg.at("aluminum")>=50);
+   ok(action(w,ship,25,Action::TransferGenericMaterial,site,40,100,0));
+   CHECK(w.world().storage(site)->goods_kg.at("aluminum")>=10);
+   CHECK(w.world().generic_factory(site)->internal_mass_grams()==40000);
+   CHECK(w.world().total_material_kg()==base_mass);
+   const auto snapshot=w.world().canonical_state();
+   CHECK(Simulation::from_snapshot(snapshot).canonical_state()==snapshot);
+   for(int t=0;t<20;++t){w.step();CHECK(w.world().total_material_kg()==base_mass);}
