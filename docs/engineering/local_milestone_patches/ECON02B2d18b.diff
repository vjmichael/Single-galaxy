+++ b/scripts/generic_factory_browser_smoke.py
@@ -0,0 +1,54 @@
+"""d18b offline Chromium UI interaction; real HTTP and SQLite tested independently."""
+from pathlib import Path
+from playwright.sync_api import sync_playwright
+import re
+root=Path(__file__).resolve().parents[1]
+html=re.sub(r'<script src="[^"]+"></script>','',(root/'viewer/interactive.html').read_text())
+with sync_playwright() as p:
+ browser=p.chromium.launch(headless=True,executable_path='/usr/bin/chromium',args=['--no-sandbox','--disable-dev-shm-usage'])
+ page=browser.new_page(viewport={'width':1250,'height':980});errors=[]
+ page.on('pageerror',lambda e:errors.append(str(e)))
+ page.set_content(html);page.locator('#colonyPanel').evaluate('e=>e.hidden=false')
+ page.add_script_tag(content=r'''
+ window.confirm=()=>true;
+ window.__generic={installed:false,modules:0,inventoryKg:0,machines:[],calls:[]};
+ window.fetch=async (path,init)=>{
+   let d={ok:true},q=init?.body?JSON.parse(init.body):{},g=window.__generic;
+   if(path==='/session')d={token:'SESSION',colony_mode:true};
+   else if(path==='/factory/api/sites')d={ok:true,sites:[42]};
+   else if(path.startsWith('/factory/api/structures?'))d={ok:true,structures:[],plans:[]};
+   else if(path.startsWith('/factory/api/crews?'))d={ok:true,residents:[101],jobs:[],supply:{sources:[],depot:9},links:[]};
+   else if(path.startsWith('/factory/api/generic_status?'))d={ok:true,installed:g.installed,modules:g.modules,inventoryKg:g.inventoryKg,machines:g.machines};
+   else if(path.startsWith('/factory/api/generic_')){
+     if(q.site!==42||q.token!=='SESSION')throw Error('invalid mock session');
+     g.calls.push({path,body:q});
+     if(path.endsWith('init'))g.installed=true;
+     if(path.endsWith('machine')){g.modules++;g.machines.push({id:q.id,staffed:false,shutdown:false,batches:0});}
+     if(path.endsWith('link'))g.modules+=4;
+     if(path.endsWith('operator'))g.machines.find(m=>m.id===q.device).staffed=!!q.npc;
+     if(path.endsWith('shutdown'))g.machines.find(m=>m.id===q.device).shutdown=q.shutdown;
+     if(path.endsWith('transfer'))g.inventoryKg+=q.amount;
+     d={ok:true,event:{applied:true}};
+   }
+   return {ok:true,status:200,json:async()=>d};
+ };''')
+ page.add_script_tag(content=(root/'viewer/structures.js').read_text())
+ page.wait_for_function("document.querySelector('#structureStatus').textContent.includes('Outpost #42')")
+ for id in ['genericInit','genericProcessor','genericFinisher','genericLink']:
+  page.locator('#'+id).click()
+  page.wait_for_function('window.__generic.calls.length >= '+str(['genericInit','genericProcessor','genericFinisher','genericLink'].index(id)+1))
+ page.locator('#genericAssign').click()
+ page.wait_for_function('window.__generic.calls.length >= 5')
+ page.locator('#genericStop').click()
+ page.wait_for_function('window.__generic.calls.length >= 6')
+ page.locator('#genericKg').fill('10')
+ page.locator('#genericTransfer').click()
+ page.wait_for_function('window.__generic.calls.length >= 7')
+ page.wait_for_function('document.querySelector("#genericStatus").textContent.includes("10 kg")')
+ g=page.evaluate('window.__generic')
+ assert [q['path'].rsplit('/',1)[-1] for q in g['calls']]==['generic_init','generic_machine','generic_machine','generic_link','generic_operator','generic_shutdown','generic_transfer']
+ assert g['calls'][-1]['body']['amount']==10
+ assert g['machines'][0]['staffed'] and g['machines'][0]['shutdown']
+ assert not errors,errors
+ browser.close()
+print('ECON-d18b Chromium PASS: authorize, material-backed installation buttons, operator, stop, transfer, live status')
