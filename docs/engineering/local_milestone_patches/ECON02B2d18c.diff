+namespace {
+bool valid_site_color(const std::string& color){
+    return color=="white" || color=="slate" || color=="sand" ||
+           color=="red" || color=="blue" || color=="green" ||
+           color=="yellow" || color=="violet";
+}
+}
+std::string Plans::site_color(PlayerId owner,EntityId ship,EntityId site)const{
+    std::lock_guard<std::mutex> guard(lifecycle);
+    authorize(owner,ship,site);
+    Stmt q(db_->get(),"SELECT color FROM sg_site_appearance WHERE site=? AND owner=? AND ship=?");
+    q.num(1,static_cast<std::int64_t>(site));q.num(2,static_cast<std::int64_t>(owner));
+    q.num(3,static_cast<std::int64_t>(ship));
+    if(!q.row())return "white";
+    auto color=q.str(0);
+    if(!valid_site_color(color))throw std::runtime_error("Invalid stored site color");
+    return color;
+}
+void Plans::set_site_color(const std::string& color,PlayerId owner,EntityId ship,EntityId site){
+    if(!valid_site_color(color))throw std::invalid_argument("Unsupported building color");
+    std::lock_guard<std::mutex> guard(lifecycle);
+    authorize(owner,ship,site);
+    Stmt q(db_->get(),"INSERT INTO sg_site_appearance(site,owner,ship,color) VALUES(?,?,?,?) "
+                      "ON CONFLICT(site) DO UPDATE SET owner=excluded.owner,ship=excluded.ship,color=excluded.color");
+    q.num(1,static_cast<std::int64_t>(site));q.num(2,static_cast<std::int64_t>(owner));
+    q.num(3,static_cast<std::int64_t>(ship));q.str(4,color);q.finish();
+}
 std::int64_t Plans::create(const std::string& canonical,PlayerId owner,EntityId ship,EntityId site){
