+  s.bind(('127.0.0.1',0));return s.getsockname()[1]
+class Game:
+ def __init__(self,db):
+  self.port=port()
+  self.proc=subprocess.Popen([sys.executable,a.relay,'--colony','--host-exe',a.host,'--save',str(db),
+    '--port',str(self.port),'--tick-ms','90','--max-ticks','1200'],stdin=subprocess.DEVNULL,
+    stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+  for _ in range(120):
+   if self.proc.poll() is not None:raise AssertionError('host exited unexpectedly')
+   try:
+    if self.req('GET','/healthz')[0]==200:break
+   except (OSError,TimeoutError):pass
+   time.sleep(.05)
+  else:raise AssertionError('host failed to start')
+ def req(self,method,path,doc=None):
+  c=http.client.HTTPConnection('127.0.0.1',self.port,timeout=12)
+  body=json.dumps(doc).encode() if doc is not None else None
+  headers={'Host':f'127.0.0.1:{self.port}'}
+  if body is not None:headers.update({'Content-Type':'application/json','Origin':f'http://127.0.0.1:{self.port}'})
+  try:
+   c.request(method,path,body,headers);r=c.getresponse();data=r.read()
+   return r.status,json.loads(data) if r.getheader('Content-Type','').startswith('application/json') else data
+  finally:c.close()
+ def get(self,path):return self.req('GET',path)
+ def post(self,path,doc):return self.req('POST','/factory/api/'+path,doc)
+ def close(self):
+  self.proc.terminate()
+  try:self.proc.communicate(timeout=8)
+  except subprocess.TimeoutExpired:self.proc.kill();self.proc.communicate(timeout=5)
+with tempfile.TemporaryDirectory(prefix='sg-d18c-spatial-') as temp:
+ for phase in ('fixture-first','factory-first'):
+  db=pathlib.Path(temp)/(phase+'.sqlite')
+  f=subprocess.run([a.fixture,str(db)],capture_output=True,text=True,timeout=20)
+  assert f.returncode==0,(f.stdout,f.stderr)
+  game=Game(db)
+  try:
+   status,sites=game.get('/factory/api/sites');assert status==200 and len(sites['sites'])==1
+   site=sites['sites'][0];token=game.get('/session')[1]['token']
+   def send(op,**payload):return game.post(op,{'token':token,'site':site,**payload})
+   def wall(x,y):
+    status,p=send('structure_register',layout=f'sg-colony-structure-plan-v1\n2,{x},{y}\n')
+    assert status==200,(status,p)
+    return send('structure_step',id=p['plan']['id'])
+   if phase=='fixture-first':
+    status,r=wall(100,100);assert status==200,(status,r)
+    assert send('generic_init')[0]==200
+    status,r=send('generic_machine',id=100);assert status==400,(status,r)
+    status,g=game.get(f'/factory/api/generic_status?site={site}')
+    assert status==200 and g['modules']==0,(status,g)
+    status,r=send('generic_machine',id=200);assert status==200,(status,r)
+   else:
+    assert send('generic_init')[0]==200
+    assert send('generic_machine',id=100)[0]==200
+    status,r=wall(100,100);assert status==200 and not r['event']['applied'],(status,r)
+    assert send('generic_machine',id=200)[0]==200
+    assert send('generic_link',id=800)[0]==200
+    status,r=wall(102,100);assert status==200 and not r['event']['applied'],(status,r)
+  finally:game.close()
+print('ECON-d18c PASS: installed physical structures block generic equipment, installed machine/link block new walls; no phantom module charges')
