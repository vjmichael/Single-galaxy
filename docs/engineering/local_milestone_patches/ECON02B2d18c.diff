+// ECON-d18c: generic machines/conveyors share the SAME grid as colony
+// structures and legacy positioned factory equipment. This is only a
+// placement constraint; it never allocates or creates construction materials.
+bool cell_in_device(std::int64_t x,std::int64_t y,const industry::Device& d){
+ return x>=d.origin.x && x<d.origin.x+d.width &&
+        y>=d.origin.y && y<d.origin.y+d.height;
+}
+bool old_equipment_at(const OutpostStorage* st,std::int64_t x,std::int64_t y){
+ if(!st)return false;
+ for(const auto& [node,position]:st->equipment_positions){
+  const int side=node==kWorkshopConveyorNode?2:1;
+  if(x>=position.x && x<position.x+side && y>=position.y && y<position.y+side)return true;
+ }
+ for(const auto& [id,link]:st->links){(void)id;
+  for(const auto& cell:link.route_cells)if(cell.x==x&&cell.y==y)return true;
+ }
+ return false;
+}
+bool installed_generic_at(const industry::FactoryExecution* f,std::int64_t x,std::int64_t y){
+ if(!f)return false;
+ for(const auto& [id,machine]:f->machines()){
+  (void)machine;
+  if(cell_in_device(x,y,f->layout().devices().at(id)))return true;
+ }
+ for(const auto& [id,link]:f->conveyors()){
+  (void)link;
+  for(const auto& cell:f->layout().conveyors().at(id).path)
+   if(cell.x==x&&cell.y==y)return true;
+ }
+ return false;
+}
+bool generic_edge_conflicts(const industry::FactoryExecution* f,const FixtureKey& key){
+ if(!f||key.layer==0)return false;
+ const auto nx=key.x+(key.layer==1),ny=key.y+(key.layer==2);
+ for(const auto& [id,machine]:f->machines()){
+  (void)machine;const auto& d=f->layout().devices().at(id);
+  if(cell_in_device(key.x,key.y,d)&&cell_in_device(nx,ny,d))return true;
+ }
+ for(const auto& [id,link]:f->conveyors()){
+  (void)link;const auto& path=f->layout().conveyors().at(id).path;
+  for(std::size_t i=1;i<path.size();++i){
+   const auto& a=path[i-1];const auto& b=path[i];
+   if((a.x==key.x&&a.y==key.y&&b.x==nx&&b.y==ny)||
+      (b.x==key.x&&b.y==key.y&&a.x==nx&&a.y==ny))return true;
+  }
+ }
+ return false;
+}
+bool generic_install_conflicts(const industry::FactoryExecution& f,
+                               std::uint64_t id,bool machine,
+                               const OutpostStorage* storage,
+                               const std::map<FixtureKey,ColonyFixture>& fixtures){
+ if(machine){
+  const auto found=f.layout().devices().find(id);
+  if(found==f.layout().devices().end())return true;
+  const auto& d=found->second;
+  for(std::int64_t x=d.origin.x;x<d.origin.x+d.width;++x)
+   for(std::int64_t y=d.origin.y;y<d.origin.y+d.height;++y)
+    if(old_equipment_at(storage,x,y))return true;
+  for(const auto& [key,piece]:fixtures){
+   (void)piece;
+   if(key.layer && cell_in_device(key.x,key.y,d) &&
+      cell_in_device(key.x+(key.layer==1),key.y+(key.layer==2),d))return true;
+  }
+ }else{
+  const auto found=f.layout().conveyors().find(id);
+  if(found==f.layout().conveyors().end())return true;
+  const auto& path=found->second.path;
+  for(const auto& cell:path)if(old_equipment_at(storage,cell.x,cell.y))return true;
+  for(std::size_t i=1;i<path.size();++i){
+   const auto& a=path[i-1];const auto& b=path[i];
+   if(edge_installed(fixtures,static_cast<int>(a.x),static_cast<int>(a.y),
+                             static_cast<int>(b.x),static_cast<int>(b.y)))return true;
+  }
+ }
+ return false;
+}
