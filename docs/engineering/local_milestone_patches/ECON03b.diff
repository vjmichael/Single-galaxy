+#pragma once
+// ECON-03b: read-only, resource-only colony market discovery. All quantities
+// come from the authoritative Simulation, never from a UI-supplied market bid.
+// A listing or opportunity is NOT a transfer, a reservation or a promise of
+// cargo delivery. Only a future journaled, authorized transport can do that.
+#include "galaxy/Simulation.hpp"
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace galaxy::resource_market {
+enum class Scope { Local, System, Regional, Interregional };
+struct Geography {
+    EntityId site=0;
+    std::uint32_t region=0; // server-trusted region identifier, not client input
+};
+struct Balance {
+    std::int64_t stock_kg=0;
+    std::int64_t demand_per_20_ticks_kg=0;
+    std::int64_t reserve_target_kg=0;
+    std::int64_t unmet_reserve_kg=0;
+    std::int64_t potential_surplus_kg=0;
+};
+struct SiteView {
+    EntityId site=0;
+    std::uint32_t system=0,region=0;
+    std::map<std::string,Balance> resources;
+    // Potentially reclaimable local waste, not a guaranteed output or offer.
+    std::map<std::string,std::int64_t> waste_kg;
+};
+struct Opportunity {
+    EntityId from_site=0,to_site=0;
+    std::string resource;
+    Scope scope=Scope::Local;
+    std::int64_t potential_kg=0;
+    bool transport_required=true;
+};
+struct Summary {
+    Scope scope=Scope::Local;
+    std::uint32_t region=0,system=0;
+    EntityId site=0;
+    std::map<std::string,Balance> resources;
+};
+struct Snapshot {
+    std::vector<SiteView> sites;
+    std::vector<Summary> summaries;
+    std::vector<Opportunity> opportunities;
+};
+Scope classify(const SiteView& source,const SiteView& destination);
+// Validates site ownership and geography; 3 needs periods of food, water and
+// oxygen are kept as indicative reserve targets. No local stock is teleported.
+Snapshot survey(const Simulation& world,const std::vector<Geography>& locations);
+} // namespace galaxy::resource_market
