+#include "galaxy/ResourceMarket.hpp"
+#include <algorithm>
+#include <limits>
+#include <set>
+#include <stdexcept>
+#include <tuple>
+
+namespace galaxy::resource_market {
+namespace {
+constexpr std::int64_t max_kg=1000000000000LL;
+void add(std::int64_t& stock,std::int64_t quantity){
+    if(quantity<0 || quantity>max_kg || stock>max_kg-quantity)
+        throw std::overflow_error("invalid or oversized resource market quantity");
+    stock+=quantity;
+}
+void stock(SiteView& s,const std::string& name,std::int64_t quantity){
+    if(quantity) add(s.resources[name].stock_kg,quantity);
+}
+void waste(SiteView& s,const std::string& name,std::int64_t quantity){
+    if(quantity)add(s.waste_kg[name],quantity);
+}
+void needs(SiteView& s,const std::string& name,std::int64_t quantity){
+    add(s.resources[name].demand_per_20_ticks_kg,quantity);
+}
+void life(SiteView& s,const ColonyLifeSupport& l){
+    stock(s,"food",l.food_kg);stock(s,"water",l.water_kg);stock(s,"oxygen",l.oxygen_kg);
+    stock(s,"nutrients",l.nutrients_kg);stock(s,"compost",l.compost_kg);
+    waste(s,"wastewater",l.wastewater_kg);waste(s,"organic",l.organic_waste_kg);
+    waste(s,"sludge",l.sludge_kg);
+    waste(s,"co2",l.co2_kg);
+}
+void merge(Summary& t,const SiteView& s){
+    for(const auto& [commodity,b]:s.resources){
+        auto& dst=t.resources[commodity];
+        add(dst.stock_kg,b.stock_kg);
+        add(dst.demand_per_20_ticks_kg,b.demand_per_20_ticks_kg);
+        add(dst.reserve_target_kg,b.reserve_target_kg);
+        add(dst.unmet_reserve_kg,b.unmet_reserve_kg);
+        add(dst.potential_surplus_kg,b.potential_surplus_kg);
+    }
+}
+} // namespace
+Scope classify(const SiteView& a,const SiteView& b){
+    if(a.site==b.site)return Scope::Local;
+    if(a.system==b.system)return Scope::System;
+    if(a.region==b.region)return Scope::Regional;
+    return Scope::Interregional;
+}
+Snapshot survey(const Simulation& w,const std::vector<Geography>& locations){
+    Snapshot out;
+    std::set<EntityId> seen;
+    for(const auto& g:locations){
+        if(!g.site || !g.region || !seen.insert(g.site).second ||
+           !w.built_outposts().count(g.site))
+            throw std::invalid_argument("market geography must name distinct built outposts");
+        const auto* entity=w.find(g.site);
+        if(!entity)throw std::invalid_argument("market outpost has no authoritative system");
+        SiteView s; s.site=g.site;s.system=entity->system_id;s.region=g.region;
+        const auto* hi=w.habitat(g.site);
+        const auto* fi=w.farm(g.site);
+        const auto residents=hi?hi->residents:0;
+        const auto workers=fi?fi->workers:0;
+        if(hi)life(s,hi->life);
+        if(fi)life(s,fi->life);
+        // Utility and clinic stock remain at their respective facilities, not
+        // pooled for free resident consumption. No fabricated availability.
+        if(const auto ci=w.communities().find(g.site);ci!=w.communities().end()){
+            stock(s,"food",ci->second.food_kg);stock(s,"water",ci->second.water_kg);
+            waste(s,"wastewater",ci->second.wastewater_kg);
+            waste(s,"organic",ci->second.organic_waste_kg);
+        }
+        if(const auto cl=w.clinic(g.site)){
+            stock(s,"water",cl->water_kg);stock(s,"medical_substrate",cl->substrate_kg);
+            waste(s,"medical_waste",cl->medical_waste_kg);
+            waste(s,"medical_wastewater",cl->wastewater_kg);
+        }
+        if(const auto st=w.storage(g.site)){
+            for(const auto& [n,q]:st->goods_kg)stock(s,n,q);
+            for(const auto& [node,goods]:st->extra_bins){
+                (void)node;for(const auto& [n,q]:goods)stock(s,n,q);
+            }
+        }
+        if(const auto shop=w.workshop(g.site)){
+            stock(s,"aluminum",shop->aluminum_kg);
+            stock(s,"aluminum_panels",shop->panels_kg);
+            stock(s,"aluminum_frames",shop->frames_kg);
+            stock(s,"aluminum_scrap",shop->scrap_kg);
+        }
+        if(const auto re=w.reclaimer(g.site)){
+            waste(s,"sludge",re->sludge_kg);
+            waste(s,"carbon_residue",re->carbon_residue_kg);
+        }
+        if(const auto plant=w.waterworks(g.site)){
+            stock(s,"raw_water_feed",plant->raw_feed_kg);
+            waste(s,"brine",plant->brine_kg);
+        }
+        // NPC consumption creates ongoing demand, not just ship/factory demand.
+        // This is a site-level estimate, NOT a claim that stores are plumbed together.
+        for(const auto* name:{"food","water","oxygen"})needs(s,name,residents+workers);
+        for(auto& [name,b]:s.resources){
+            (void)name;
+            if(b.demand_per_20_ticks_kg>max_kg/3)
+                throw std::overflow_error("market reserve overflow");
+            b.reserve_target_kg=3*b.demand_per_20_ticks_kg;
+            b.unmet_reserve_kg=std::max<std::int64_t>(0,b.reserve_target_kg-b.stock_kg);
+            b.potential_surplus_kg=std::max<std::int64_t>(0,b.stock_kg-b.reserve_target_kg);
+        }
+        out.sites.push_back(std::move(s));
+    }
+    std::sort(out.sites.begin(),out.sites.end(),[](const auto& a,const auto& b){return a.site<b.site;});
+    // Aggregates share the same underlying stock. Never sum the levels together.
+    using Key=std::tuple<int,std::uint32_t,std::uint32_t,EntityId>;
+    std::map<Key,Summary> aggregates;
+    for(const auto& s:out.sites){
+        const Key keys[]={
+            {0,s.region,s.system,s.site}, // local
+            {1,s.region,s.system,0},      // per system (unique within region)
+            {2,s.region,0,0},             // per region
+            {3,0,0,0}                    // cross-region overall view
+        };
+        for(const auto& key:keys){
+            auto& a=aggregates[key];
+            a.scope=static_cast<Scope>(std::get<0>(key));
+            a.region=std::get<1>(key);a.system=std::get<2>(key);
+            a.site=std::get<3>(key);
+            merge(a,s);
+        }
+    }
+    for(auto& [key,val]:aggregates){(void)key;out.summaries.push_back(std::move(val));}
+    // Opportunities describe a possible resource deficit/surplus pairing.
+    // Do not mutate stocks, infer cargo routes or complete transactions.
+    std::map<std::pair<EntityId,std::string>,std::int64_t> uncommitted;
+    for(const auto& source:out.sites)
+        for(const auto& [name,b]:source.resources)
+            uncommitted[{source.site,name}]=b.potential_surplus_kg;
+    for(const auto& dest:out.sites){
+        for(const auto& [commodity,need]:dest.resources){
+            std::int64_t remaining=need.unmet_reserve_kg;
+            if(!remaining)continue;
+            for(const auto& source:out.sites){
+                if(source.site==dest.site || !remaining)continue;
+                const auto it=source.resources.find(commodity);
+                if(it==source.resources.end())continue;
+                auto& available=uncommitted.at({source.site,commodity});
+                const auto candidate=std::min(remaining,available);
+                if(!candidate)continue;
+                out.opportunities.push_back({source.site,dest.site,commodity,
+                    classify(source,dest),candidate,true});
+                remaining-=candidate;
+                available-=candidate;
+            }
+        }
+    }
+    std::sort(out.opportunities.begin(),out.opportunities.end(),[](const auto& a,const auto& b){
+        return std::tie(a.scope,a.to_site,a.resource,a.from_site)<
+               std::tie(b.scope,b.to_site,b.resource,b.from_site);
+    });
+    return out;
+}
+} // namespace galaxy::resource_market
