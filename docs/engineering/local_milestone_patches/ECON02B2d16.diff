+   CHECK(w.world().construction_supplies(site)->evacuation_cargo.count(npc));
+   for(int i=0;i<100 && crew.retirement_active(7,ship,site);++i){
+    w.step();crew.advance(7,ship);CHECK(w.world().total_material_kg()==mass);
+   }
+   CHECK(!crew.retirement_active(7,ship,site));
+   CHECK(crew.list_line_retirement(7,ship,site)[0].phase==8);
+   CHECK(!w.world().construction_supplies(site)->evacuation_cargo.count(npc));
+   CHECK(w.world().workshop(site)!=nullptr);
+   CHECK(w.world().workshop(site)->aluminum_kg==40);
+   CHECK(w.world().workshop(site)->shutdown_requested);
+  }
+  fs::remove_all(folder);
+  std::cout<<"ECON-02B2d16 PASS: line retirement, real NPC work, conveyor teardown, restart, cancellation and conservation\n";
+  return 0;
+ }catch(const std::exception& e){std::cerr<<"ECON-02B2d16 FAIL: "<<e.what()<<'\n';fs::remove_all(folder);return 1;}
+}
