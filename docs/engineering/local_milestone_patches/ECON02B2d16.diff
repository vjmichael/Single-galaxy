+using namespace galaxy;
+static void action(PersistentWorld& w,EntityId ship,std::uint64_t id,Action kind,EntityId site=0,
+                   std::int64_t amount=1,int x=0,int y=0){
+ Command c{};c.id=id;c.sequence=id;c.issuer=7;c.actor=ship;c.target=site;c.action=kind;
+ c.amount=amount;c.thrust_x=x;c.thrust_y=y;c.execute_tick=w.world().tick()+1;
+ if(!w.submit(c))throw std::runtime_error("Failed fixture submit "+std::to_string(id));
+ w.step();
+ if(w.world().events().back().result!=Outcome::Applied)
+  throw std::runtime_error("Fixture command rejected "+std::to_string(id));
+}
+int main(int argc,char** argv){
+ if(argc!=2)return 2;
+ try{
+  Simulation seed(1216);
+  auto ship=seed.add_colony_ship(7,{0,0},500,8);
+  seed.provision_colony_genesis(ship,1000,3000,1000,1000,1000);
+  auto asteroid=seed.add_asteroid({1000,0},200);
+  const auto silicate=seed.add_geological_asteroid({2000,0},AsteroidClass::Silicate,30,2500);
+  seed.enable_individual_workforce();
+  PersistentWorld w(argv[1],std::move(seed));
+  action(w,ship,1,Action::Mine,asteroid,175);
+  action(w,ship,2,Action::RefineOre,0,175);
+  action(w,ship,3,Action::FabricateModule,0,75);
+  action(w,ship,4,Action::ConstructOutpost);
+  auto site=w.world().built_outposts().begin()->first;
+  action(w,ship,5,Action::ConstructHabitat,site);
+  for(int i=1;i<=3;++i)action(w,ship,5+i,Action::TransferHabitatStock,site,30,i);
+  action(w,ship,9,Action::AssignHabitatResidents,site,2);
+  action(w,ship,10,Action::ConstructStorage,site);
+  action(w,ship,11,Action::ConstructWorkshop,site);
+  action(w,ship,12,Action::ConstructWorkshopFinisher,site);
+  action(w,ship,13,Action::PlaceFactoryEquipment,site,-1,4,0);
+  action(w,ship,14,Action::PlaceFactoryEquipment,site,0,0,0);
+  action(w,ship,15,Action::Mine,silicate,45);
+  action(w,ship,16,Action::RefineMineral,10,18000);
+  action(w,ship,17,Action::TransferWorkshopStack,site,40,0);
+  // Attach a *real* workshop conveyor; retirement must remove every segment.
+  action(w,ship,18,Action::ConstructWorkshopLink,site,4,0,0);
+  action(w,ship,19,Action::PlaceConveyorCell,site,18,1,0);
+  action(w,ship,20,Action::PlaceConveyorCell,site,18,2,0);
+  action(w,ship,21,Action::PlaceConveyorCell,site,18,3,0);
