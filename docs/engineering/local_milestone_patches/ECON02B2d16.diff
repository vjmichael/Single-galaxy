+// ECON-02B2d16: one owner-authorized, named on-site resident coordinates
+// existing physical line jobs. The coordinator is durable intent, not a new
+// resource owner. World commits remain authoritative; SQL phases are replayable.
+void Crews::begin_line_retirement(std::uint64_t npc,PlayerId owner,EntityId ship,EntityId site){
+ validate_worker(npc,owner,ship,site);
+ const auto* w=world_.world().workshop(site);
+ const auto* st=world_.world().storage(site);
+ if(!w || !st || !st->equipment_positions.count(0) ||
+    !st->equipment_positions.count(kWorkshopConveyorNode))
+  throw std::invalid_argument("Line retirement requires installed workshop and storage");
+ Query existing(db_->db,"SELECT active FROM sg_line_retirements WHERE site=?");
+ existing.n(1,site);
+ if(existing.row() && existing.v(0))throw std::invalid_argument("Line retirement already active");
+ Query construction(db_->db,"SELECT 1 FROM sg_construction_workers WHERE npc_id=? LIMIT 1");
+ construction.n(1,npc);if(construction.row())throw std::invalid_argument("Selected NPC already building");
+ Query restock(db_->db,"SELECT 1 FROM sg_construction_restock WHERE npc_id=? AND active=1 LIMIT 1");
+ restock.n(1,npc);if(restock.row())throw std::invalid_argument("Selected NPC already hauling");
+ Query evac(db_->db,"SELECT 1 FROM sg_line_evacuation_jobs WHERE npc_id=? AND active=1 LIMIT 1");
+ evac.n(1,npc);if(evac.row())throw std::invalid_argument("Selected NPC already evacuating");
+ Query dismantle(db_->db,"SELECT 1 FROM sg_dismantle_jobs WHERE npc_id=? AND active=1 LIMIT 1");
+ dismantle.n(1,npc);if(dismantle.row())throw std::invalid_argument("Selected NPC already dismantling");
+ Query machine(db_->db,"SELECT 1 FROM sg_machine_dismantle_jobs WHERE npc_id=? AND active=1 LIMIT 1");
+ machine.n(1,npc);if(machine.row())throw std::invalid_argument("Selected NPC already dismantling machine");
+ const auto* supplies=world_.world().construction_supplies(site);
+ if(supplies && (supplies->carried.count(npc) || supplies->evacuation_cargo.count(npc)))
+  throw std::invalid_argument("Unload worker cargo before retirement assignment");
+ Query save(db_->db,"INSERT INTO sg_line_retirements(site,owner,ship,npc_id,phase,active,cancelling,last_tick,reason)"
+                     " VALUES(?,?,?,?,0,1,0,-1,'Authorized: stopping new production')"
+                     " ON CONFLICT(site) DO UPDATE SET owner=excluded.owner,ship=excluded.ship,"
+                     " npc_id=excluded.npc_id,phase=0,active=1,cancelling=0,last_tick=-1,reason=excluded.reason"
+                     " WHERE sg_line_retirements.active=0");
+ save.n(1,site);save.n(2,owner);save.n(3,ship);save.n(4,npc);save.done();
+ if(sqlite3_changes(db_->db)!=1)throw std::runtime_error("Failed to authorize retirement");
+}
+bool Crews::cancel_line_retirement(PlayerId owner,EntityId ship,EntityId site){
+ validate_site(owner,ship,site);
+ Query q(db_->db,"UPDATE sg_line_retirements SET cancelling=1,reason='Cancel requested: returning physical cargo'"
+                 " WHERE owner=? AND ship=? AND site=? AND active=1 AND cancelling=0");
+ q.n(1,owner);q.n(2,ship);q.n(3,site);q.done();return sqlite3_changes(db_->db)==1;
+}
+bool Crews::retirement_active(PlayerId owner,EntityId ship,EntityId site)const{
+ validate_site(owner,ship,site);
+ Query q(db_->db,"SELECT 1 FROM sg_line_retirements WHERE owner=? AND ship=? AND site=? AND active=1");
+ q.n(1,owner);q.n(2,ship);q.n(3,site);return q.row();
+}
+std::vector<LineRetirement> Crews::list_line_retirement(PlayerId owner,EntityId ship,EntityId site)const{
+ validate_site(owner,ship,site);
+ Query q(db_->db,"SELECT npc_id,phase,active,cancelling,reason FROM sg_line_retirements"
+                  " WHERE owner=? AND ship=? AND site=? LIMIT 1");
+ q.n(1,owner);q.n(2,ship);q.n(3,site);
+ std::vector<LineRetirement> out;
+ if(q.row())out.push_back({static_cast<std::uint64_t>(q.v(0)),static_cast<int>(q.v(1)),q.v(2)!=0,q.v(3)!=0,q.t(4)});
+ return out;
+}
+// Return true only when advancing the retirement commits a world action and
+// changes the authoritative tick. This prevents double-ticking other jobs.
+bool Crews::advance_retirement(PlayerId owner,EntityId ship,std::uint64_t tick){
+ struct R {EntityId site;std::uint64_t npc;int phase;bool cancelling;std::int64_t last;};
+ std::vector<R> records;
+ {
+  Query q(db_->db,"SELECT site,npc_id,phase,cancelling,last_tick FROM sg_line_retirements"
+                   " WHERE owner=? AND ship=? AND active=1 ORDER BY site LIMIT 64");
+  q.n(1,owner);q.n(2,ship);
