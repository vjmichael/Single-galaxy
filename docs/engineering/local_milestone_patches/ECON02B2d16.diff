+#!/usr/bin/env python3
+"""d16: owner-scoped HTTP retirement, mid-haul restart and no-op replay."""
+import argparse,http.client,json,pathlib,socket,subprocess,sys,tempfile,time
+p=argparse.ArgumentParser()
+for x in ('host','fixture','relay'):p.add_argument('--'+x,required=True)
+a=p.parse_args()
+def free_port():
+ with socket.socket() as s:s.bind(('127.0.0.1',0));return s.getsockname()[1]
+class Game:
+ def __init__(self,db):
+  self.port=free_port()
+  self.proc=subprocess.Popen([sys.executable,a.relay,'--colony','--host-exe',a.host,'--save',str(db),
+    '--port',str(self.port),'--tick-ms','65','--max-ticks','1200'],stdin=subprocess.DEVNULL,
+    stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+  for i in range(120):
+   if self.proc.poll() is not None:raise AssertionError(self.proc.stderr.read().decode())
+   try:
+    if self.get('/healthz')[0]==200:break
+   except (OSError,TimeoutError):pass
+   time.sleep(.05)
+  else:raise AssertionError('Colony host never opened')
+ def request(self,method,path,doc=None,headers=None):
+  c=http.client.HTTPConnection('127.0.0.1',self.port,timeout=8)
+  raw=json.dumps(doc).encode() if doc is not None else None
+  h={'Host':f'127.0.0.1:{self.port}',**(headers or {})}
+  if raw is not None:
+   h.setdefault('Content-Type','application/json');h.setdefault('Origin',f'http://127.0.0.1:{self.port}')
+  try:
+   c.request(method,path,raw,headers=h);r=c.getresponse();content=r.read()
+   return r.status,json.loads(content) if r.getheader('Content-Type')=='application/json' else content.decode()
+  finally:c.close()
+ def get(self,path):return self.request('GET',path)
+ def post(self,path,data,headers=None):return self.request('POST',path,data,headers)
+ def close(self):
+  self.proc.terminate()
+  try:self.proc.communicate(timeout=8)
+  except subprocess.TimeoutExpired:self.proc.kill();self.proc.communicate(timeout=5)
+with tempfile.TemporaryDirectory(prefix='sg-d16-http-') as tmp:
+ db=pathlib.Path(tmp)/'world.sqlite'
+ r=subprocess.run([a.fixture,str(db)],capture_output=True,text=True,timeout=25)
+ assert r.returncode==0,r.stderr
+ game=Game(db)
+ try:
+  token=game.get('/session')[1]['token']
+  status,sites=game.get('/factory/api/sites');assert status==200 and len(sites['sites'])==1
+  site=sites['sites'][0]
+  status,crews=game.get(f'/factory/api/crews?site={site}')
+  assert status==200 and len(crews['residents'])>=1
+  npc=crews['residents'][0]
+  req={'token':token,'site':site,'npc':npc}
+  route='/factory/api/line_retire_begin'
+  for fake in ({**req,'token':'invalid'}, {**req,'site':1234567}, {**req,'npc':'5'}, {**req,'npc':True}):
+   status,_=game.post(route,fake);assert status in (400,403),(status,fake)
+  status,_=game.post(route,req,{'Origin':'https://forged.invalid'});assert status==403
+  status,ok=game.post(route,req);assert status==200 and ok['authorized'],(status,ok)
+  status,_=game.post(route,req);assert status==400
+  status,_=game.post('/factory/api/line_shutdown',{'token':token,'site':site,'shutdown':False});assert status==400
+  carrying=False
+  for _ in range(200):
+   status,crews=game.get(f'/factory/api/crews?site={site}')
+   assert status==200,(status,crews)
+   if crews['lineEvacuation'] and crews['lineEvacuation'][0]['carryingKg']>0:
+    carrying=True;break
+   time.sleep(.035)
+  assert carrying,crews
+ finally:game.close()
+ game=Game(db)
+ try:
+  status,crews=game.get(f'/factory/api/crews?site={site}')
+  assert status==200 and crews['lineRetirement'][0]['active'],crews
+  assert crews['lineEvacuation'][0]['carryingKg']>0,crews
+  terminal=False
+  for _ in range(850):
+   status,crews=game.get(f'/factory/api/crews?site={site}')
+   assert status==200,crews
+   if crews['lineRetirement'][0]['phase']==6 and not crews['lineRetirement'][0]['active']:
+    terminal=True;break
+   time.sleep(.04)
+  assert terminal,crews
+  assert not crews['workshopState']['installed'],crews
+  assert not any(l['id']=='18' for l in crews['links']),crews
+  assert crews['supply']['depot']>=6,crews
+  token=game.get('/session')[1]['token']
