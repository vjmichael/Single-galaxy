diff --git a/src/world_owner_lock.hpp b/src/world_owner_lock.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..ef1495f5c247dbefeb2c8f04456b7b270a5fc7fa
--- /dev/null
+++ b/src/world_owner_lock.hpp
@@ -0,0 +1,73 @@
+#pragma once
+// ECON-02B2d4c4: OS-scoped single-authority lease for a local persistent world.
+// Both native factory and colony entry points must hold this before opening
+// SQLite for mutation. This lock is NOT multiplayer identity/authentication.
+#include <filesystem>
+#include <stdexcept>
+#include <string>
+#ifdef _WIN32
+#  define WIN32_LEAN_AND_MEAN
+#  define NOMINMAX
+#  include <winsock2.h>  // must precede windows.h in the native HTTP host
+#  include <windows.h>
+#else
+#  include <cerrno>
+#  include <fcntl.h>
+#  include <sys/file.h>
+#  include <sys/stat.h>
+#  include <unistd.h>
+#endif
+
+namespace galaxy {
+class WorldOwnerLock {
+public:
+    explicit WorldOwnerLock(const std::filesystem::path& db) {
+        // Canonicalize the existing parent, not the DB (new colony saves do not
+        // exist yet). Resolve an existing DB to avoid pathname aliases.
+        const auto file=std::filesystem::absolute(db);
+        const auto parent=std::filesystem::canonical(file.parent_path());
+        const auto world=std::filesystem::exists(file)?std::filesystem::canonical(file):parent/file.filename();
+        lock_path_=world;
+        lock_path_ += ".sgwriter.lock";
+#ifdef _WIN32
+        handle_=CreateFileW(lock_path_.wstring().c_str(),GENERIC_READ|GENERIC_WRITE,
+            FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE,nullptr,OPEN_ALWAYS,
+            FILE_ATTRIBUTE_NORMAL,nullptr);
+        if(handle_==INVALID_HANDLE_VALUE)throw std::runtime_error("World lease file could not be opened");
+        OVERLAPPED overlap{};
+        if(!LockFileEx(handle_,LOCKFILE_EXCLUSIVE_LOCK|LOCKFILE_FAIL_IMMEDIATELY,
+                       0,1,0,&overlap)) {
+            CloseHandle(handle_);handle_=INVALID_HANDLE_VALUE;
+            throw std::runtime_error("World already owned by another live game/factory host");
+        }
+#else
+        int flags=O_CREAT|O_RDWR|O_CLOEXEC;
+#ifdef O_NOFOLLOW
+        flags|=O_NOFOLLOW;
+#endif
+        fd_=::open(lock_path_.c_str(),flags,0600);
+        if(fd_<0)throw std::runtime_error("World lease file could not be opened");
+        if(::flock(fd_,LOCK_EX|LOCK_NB)!=0){
+            ::close(fd_);fd_=-1;
+            throw std::runtime_error("World already owned by another live game/factory host");
+        }
+#endif
+    }
+    WorldOwnerLock(const WorldOwnerLock&)=delete;
+    WorldOwnerLock& operator=(const WorldOwnerLock&)=delete;
+    ~WorldOwnerLock() {
+#ifdef _WIN32
+        if(handle_!=INVALID_HANDLE_VALUE){OVERLAPPED overlap{};UnlockFileEx(handle_,0,1,0,&overlap);CloseHandle(handle_);}
+#else
+        if(fd_>=0){::flock(fd_,LOCK_UN);::close(fd_);}
+#endif
+    }
+private:
+    std::filesystem::path lock_path_;
+#ifdef _WIN32
+    HANDLE handle_=INVALID_HANDLE_VALUE;
+#else
+    int fd_=-1;
+#endif
+};
+} // namespace galaxy
