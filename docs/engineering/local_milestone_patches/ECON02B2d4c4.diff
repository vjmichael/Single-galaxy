+#!/usr/bin/env python3
+"""ECON-02B2d4c4: real HTTP -> relay -> living colony -> SQLite path.
+
+No second world writer, no privileged browser identity, no Node requirement.
+"""
+import argparse
+import http.client
+import json
+import pathlib
+import socket
+import sys
+import subprocess
+import tempfile
+import time
+import urllib.parse
+
+p=argparse.ArgumentParser()
+p.add_argument('--host',required=True)
+p.add_argument('--factory',required=True)
+p.add_argument('--fixture',required=True)
+p.add_argument('--relay',required=True)
+p.add_argument('--layout',required=True)
+a=p.parse_args()
+
+def free_port():
+    with socket.socket() as sock:
+        sock.bind(('127.0.0.1',0))
+        return sock.getsockname()[1]
+
+class Game:
+    def __init__(self,save,port):
+        self.port=port
+        self.proc=subprocess.Popen([sys.executable,a.relay,'--colony','--host-exe',a.host,'--save',str(save),
+             '--port',str(port),'--tick-ms','100','--max-ticks','1200'],
+             stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+        for _ in range(80):
+            if self.proc.poll() is not None:
+                raise RuntimeError('Relay quit during startup')
+            try:
+                status,_,text=self.request('GET','/healthz')
+                if status==200:break
+            except (OSError,http.client.HTTPException):pass
+            time.sleep(.05)
+        else:raise RuntimeError('Relay startup timed out')
+    def request(self,method,path,doc=None,headers=None):
+        conn=http.client.HTTPConnection('127.0.0.1',self.port,timeout=6)
+        content=json.dumps(doc,separators=(',',':')).encode() if doc is not None else None
+        h={'Host':f'127.0.0.1:{self.port}',**(headers or {})}
+        if doc is not None:
+            h.setdefault('Content-Type','application/json')
+            h.setdefault('Origin',f'http://127.0.0.1:{self.port}')
+        try:
+            conn.request(method,path,body=content,headers=h)
+            r=conn.getresponse();status=r.status;body=r.read();ctype=r.getheader('Content-Type')
+            return status,json.loads(body) if ctype=='application/json' else body.decode(),body
+        finally:conn.close()
+    def close(self):
+        self.proc.terminate()
+        try:self.proc.communicate(timeout=5)
+        except subprocess.TimeoutExpired:self.proc.kill();self.proc.communicate(timeout=5)
+
+with tempfile.TemporaryDirectory(prefix='sg-colony-integrated-') as temp:
+    temp=pathlib.Path(temp);save=temp/'world.sqlite'
+    created=subprocess.run([a.fixture,str(save)],capture_output=True,text=True,timeout=10)
+    assert created.returncode==0,created.stderr
+    layout=pathlib.Path(a.layout).read_text()
+    game=Game(save,free_port())
+    try:
+        status,session,_=game.request('GET','/session');assert status==200 and session['colony_mode']
+        token=session['token']
+        status,static,_=game.request('GET','/viewer/factory.html')
+        assert status==200 and 'factorySite' in static and 'Authorize plan' in static
+        status,js,_=game.request('GET','/viewer/factory-live.js')
+        assert status==200 and '/factory/api/' in js
+        status,sites,_=game.request('GET','/factory/api/sites')
+        assert status==200 and sites['ok'] and len(sites['sites'])==1
+        site=sites['sites'][0]
+        status,hello,_=game.request('GET',f'/factory/api/hello?site={site}')
+        assert status==200 and hello['site']==site and hello['modulesAvailable']>=12
+        status,plans,_=game.request('GET',f'/factory/api/plans?site={site}')
+        assert status==200 and plans['plans']==[]
+        status,foreign,_=game.request('GET','/factory/api/hello?site=999999')
+        assert status==400 and not foreign['ok']
+        status,dup,_=game.request('GET',f'/factory/api/hello?site={site}&site={site}')
+        assert status==404
+        old=subprocess.run([a.factory,'--db',str(save),'--no-browser'],capture_output=True,text=True,timeout=5)
+        assert old.returncode!=0 and 'already owned' in old.stderr
+        # Requests have the same token/Origin requirement as ordinary colony commands.
+        doc={'token':token,'site':site,'layout':layout}
+        status,wrong_origin,_=game.request('POST','/factory/api/register',doc,
+            {'Origin':'https://evil.example'})
+        assert status==403 and not wrong_origin['ok']
+        status,wrong_token,_=game.request('POST','/factory/api/register',dict(doc,token='stolen'))
+        assert status==403 and not wrong_token['ok']
+        status,wrong_owner,_=game.request('POST','/factory/api/register',dict(doc,owner=9))
+        assert status==404 and not wrong_owner['ok']
+        status,wrong_site,_=game.request('POST','/factory/api/register',dict(doc,site=999999))
+        assert status==400 and not wrong_site['ok']
+        # Exercise a large write across the OS pipe; malformed blueprint must
+        # fail safely without stalling simulation or granting any new authority.
+        status,large,_=game.request('POST','/factory/api/register',dict(doc,layout='X'*300000))
+        assert status==400 and not large['ok']
+        assert game.proc.poll() is None
+        status,reg,_=game.request('POST','/factory/api/register',doc)
+        assert status==200 and reg['ok'] and reg['plan']['total']==16,reg
+        plan=reg['plan']['id']
+        status,duplicate,_=game.request('POST','/factory/api/register',doc)
+        assert status==400 and not duplicate['ok']
+        status,wrong_plan_site,_=game.request('POST','/factory/api/status',{'token':token,'site':999999,'id':plan})
+        assert status==400 and not wrong_plan_site['ok']
+        status,step,_=game.request('POST','/factory/api/step',{'token':token,'site':site,'id':plan})
+        assert status==200 and step['event']['applied'] and step['plan']['completed']==1,step
+        status,still,_=game.request('GET','/factory/api/plans?site='+str(site))
+        assert status==200 and still['plans'][0]['completed']==1
+        status,live,_=game.request('GET','/factory/api/hello?site='+str(site))
+        assert live['modulesAvailable']<hello['modulesAvailable'] and live['tick']>hello['tick']
+        assert game.proc.poll() is None,'Colony viewer must remain running after factory tick'
+        status,cancel,_=game.request('POST','/factory/api/cancel',{'token':token,'site':site,'id':plan})
+        assert status==200 and cancel['plan']['cancelled']
+        status,denied,_=game.request('POST','/factory/api/step',{'token':token,'site':site,'id':plan})
+        assert status==400 and not denied['ok']
+        status,replacement,_=game.request('POST','/factory/api/register',doc)
+        assert status==200 and replacement['plan']['completed']==1 and replacement['plan']['id']>plan
+    finally:game.close()
+    # A second colony session resumes the SAME saved world and plan journal.
+    game=Game(save,free_port())
+    try:
+        status,sites,_=game.request('GET','/factory/api/sites');assert sites['sites']==[site]
+        status,plans,_=game.request('GET',f'/factory/api/plans?site={site}')
+        assert status==200 and len(plans['plans'])==2 and plans['plans'][0]['cancelled']
+        assert plans['plans'][1]['completed']==1
+        # Post-shutdown standalone host can acquire the released OS writer lease.
+    finally:game.close()
+    # Inverse lock direction: standalone host owns the same save, so a second
+    # native colony process must refuse it without starting a competing world.
+    standalone=subprocess.Popen([a.factory,'--db',str(save),'--no-browser'],
+        stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+    try:
+        line=standalone.stdout.readline().decode()
+        assert line.startswith('SG_FACTORY_URL='),line
+        denied=subprocess.run([a.host,str(save),'100','5'],
+            capture_output=True,text=True,timeout=5)
+        assert denied.returncode!=0 and 'already owned' in denied.stderr,denied.stderr
+    finally:
+        standalone.terminate()
+        try:standalone.communicate(timeout=4)
+        except subprocess.TimeoutExpired:standalone.kill();standalone.communicate(timeout=4)
+    print('ECON-02B2d4c4 PASS: same-world live factory, two-way OS lease, Origin/token/site denial, large request, physical modules, cancellation, restart')
