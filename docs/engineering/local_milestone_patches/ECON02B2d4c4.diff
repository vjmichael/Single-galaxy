+"""Optional ECON-02B2d4c4 *real GUI* loopback gate; run on a machine whose
+browser permits navigating to 127.0.0.1. Never uses a user-owned save.
+
+SG_BUILD_DIR=/path/to/build python scripts/factory_integrated_browser_smoke.py
+Requires Playwright and a Chromium executable; NOT a game runtime dependency.
+"""
+import os
+import pathlib
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+import urllib.request
+from playwright.sync_api import sync_playwright
+
+ROOT=pathlib.Path(__file__).resolve().parents[1]
+BUILD=pathlib.Path(os.environ.get('SG_BUILD_DIR',ROOT/'build'))
+with tempfile.TemporaryDirectory(prefix='sg-colony-factory-ui-') as tmp:
+    save=pathlib.Path(tmp)/'world.sqlite'
+    fixture=subprocess.run([str(BUILD/'galaxy_econ02b2d4c2_world_fixture'),str(save)],
+        capture_output=True,text=True,timeout=10)
+    assert fixture.returncode==0,fixture.stderr
+    with socket.socket() as sock:
+        sock.bind(('127.0.0.1',0));port=sock.getsockname()[1]
+    root=f'http://127.0.0.1:{port}'
+    relay=subprocess.Popen([sys.executable,str(ROOT/'live/interactive_relay.py'),
+        '--host-exe',str(BUILD/'galaxy_colony_live_host'),'--colony','--save',str(save),
+        '--port',str(port),'--tick-ms','100','--max-ticks','1200'],
+        stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+    try:
+        for i in range(100):
+            try:
+                if urllib.request.urlopen(root+'/healthz',timeout=.5).status==200:break
+            except Exception:time.sleep(.05)
+        else:raise RuntimeError('Colony live relay unavailable')
