+#pragma once
+// ECON-02B2d4c4: exclusive in-process factory command routing.
+// Invoked only from the colony simulation loop, never from a browser thread.
+// Browser-provided site is a requested selector, NEVER owner authority.
+#include "galaxy/HostBlueprintRegistry.hpp"
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace galaxy::colony_factory {
+inline std::string json_string(const std::string& s){
+    std::string out="\"";constexpr char hex[]="0123456789abcdef";
+    for(unsigned char c:s){
+        if(c=='"'||c=='\\'){out+='\\';out+=static_cast<char>(c);}
+        else if(c=='\n')out+="\\n";
+        else if(c=='\r')out+="\\r";
+        else if(c=='\t')out+="\\t";
+        else if(c<32){out+="\\u00";out+=hex[c>>4];out+=hex[c&15];}
+        else out+=static_cast<char>(c);
+    }
+    return out+'"';
+}
+inline std::uint64_t unsigned_id(const std::string& s){
+    if(s.empty()||s.size()>19||(s.size()>1&&s[0]=='0'))throw std::invalid_argument("Invalid positive identifier");
+    std::uint64_t n=0;
+    for(char c:s){
+        if(c<'0'||c>'9'||n>(static_cast<std::uint64_t>(std::numeric_limits<std::int64_t>::max())-(c-'0'))/10)
+            throw std::invalid_argument("Invalid positive identifier");
+        n=n*10+static_cast<unsigned>(c-'0');
+    }
+    if(!n)throw std::invalid_argument("Invalid positive identifier");
+    return n;
+}
+inline std::string encode64(const std::string& s){
+    constexpr char enc[]="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    std::string out;out.reserve((s.size()+2)/3*4);
+    for(std::size_t i=0;i<s.size();i+=3){
+        const auto a=static_cast<unsigned char>(s[i]);
+        const auto b=i+1<s.size()?static_cast<unsigned char>(s[i+1]):0;
+        const auto c=i+2<s.size()?static_cast<unsigned char>(s[i+2]):0;
+        out+=enc[a>>2];out+=enc[((a&3)<<4)|(b>>4)];
+        out+=i+1<s.size()?enc[((b&15)<<2)|(c>>6)]:'=';
+        out+=i+2<s.size()?enc[c&63]:'=';
+    }
+    return out;
+}
+inline std::string decode64(const std::string& encoded){
+    if(encoded.empty()||encoded.size()>1398104||encoded.size()%4)
+        throw std::invalid_argument("Invalid blueprint payload length");
+    const auto digit=[](char c)->int{
+        if(c>='A'&&c<='Z')return c-'A';if(c>='a'&&c<='z')return c-'a'+26;
+        if(c>='0'&&c<='9')return c-'0'+52;if(c=='+')return 62;if(c=='/')return 63;return -1;
+    };
+    std::string out;out.reserve(encoded.size()/4*3);
+    for(std::size_t i=0;i<encoded.size();i+=4){
+        const bool last=i+4==encoded.size();
+        const int a=digit(encoded[i]),b=digit(encoded[i+1]);
+        const int c=encoded[i+2]=='='?-2:digit(encoded[i+2]);
+        const int d=encoded[i+3]=='='?-2:digit(encoded[i+3]);
+        if(a<0||b<0||c==-1||d==-1||(c==-2&&d!=-2)||(!last&&(c==-2||d==-2))||
+           (c==-2&&(b&15))||(d==-2&&c>=0&&(c&3)))throw std::invalid_argument("Invalid blueprint encoding");
+        const auto bits=(static_cast<unsigned>(a)<<18)|(static_cast<unsigned>(b)<<12)|
+                        (static_cast<unsigned>(std::max(c,0))<<6)|static_cast<unsigned>(std::max(d,0));
+        out+=static_cast<char>((bits>>16)&255);
+        if(c>=0)out+=static_cast<char>((bits>>8)&255);
+        if(d>=0)out+=static_cast<char>(bits&255);
+    }
+    if(out.size()>1048576)throw std::invalid_argument("Blueprint exceeds host limit");
+    return out;
+}
+inline std::string plan_json(const industry::HostedPlanStatus& p){
+    const auto& a=p.progress;
+    return "{\"id\":"+std::to_string(p.plan_id)+",\"site\":"+std::to_string(p.site)+
+           ",\"completed\":"+std::to_string(a.completed)+",\"total\":"+std::to_string(a.total)+
+           ",\"modulesRemaining\":"+std::to_string(a.modules_remaining)+
+           ",\"cancelled\":"+(a.cancelled?"true":"false")+
+           ",\"conflicting\":"+(a.conflicting?"true":"false")+
+           ",\"finished\":"+(a.finished()?"true":"false")+
+           ",\"reason\":"+json_string(a.reason)+"}";
+}
+inline std::string event_json(const Event& e){
+    return "{\"commandId\":"+std::to_string(e.command_id)+",\"tick\":"+std::to_string(e.tick)+
+           ",\"applied\":"+(e.result==Outcome::Applied?"true":"false")+
+           ",\"result\":"+std::to_string(static_cast<int>(e.result))+"}";
+}
+class Control {
+public:
+    Control(const std::string& db,PersistentWorld& world,EntityId ship,PlayerId owner)
+        :host_(db,world),world_(world),ship_(ship),owner_(owner){}
+    std::string handle(const std::string& op,std::uint64_t requested_site,const std::string& arg){
+        const auto& sites=world_.world().built_outposts();
+        if(op=="SITES"){
+            if(requested_site||!arg.empty())throw std::invalid_argument("Invalid site list command");
+            std::string out="{\"ok\":true,\"sites\":[";
+            bool first=true;
+            for(const auto& [id,p]:sites){
+                if(p.source_colony_ship!=ship_)continue;
+                if(!first)out+=',';first=false;out+=std::to_string(id);
+            }
+            return out+"]}";
+        }
+        const auto pos=sites.find(requested_site);
+        if(requested_site==0||pos==sites.end()||pos->second.source_colony_ship!=ship_||
+           !world_.world().find(ship_)||world_.world().find(ship_)->owner_id!=owner_)
+            throw std::invalid_argument("Selected site is not owned by this colony session");
+        if(op=="HELLO"){
+            if(!arg.empty())throw std::invalid_argument("Unexpected HELLO argument");
+            const auto* c=world_.world().colony_ship(ship_);
+            return "{\"ok\":true,\"site\":"+std::to_string(requested_site)+
+                   ",\"ship\":"+std::to_string(ship_)+
+                   ",\"modulesAvailable\":"+std::to_string(c?c->modules:0)+
+                   ",\"tick\":"+std::to_string(world_.world().tick())+"}";
+        }
+        if(op=="LIST"){
+            if(!arg.empty())throw std::invalid_argument("Unexpected LIST argument");
+            const auto list=host_.list(owner_);
+            std::string out="{\"ok\":true,\"plans\":[";bool first=true;
+            for(const auto& p:list)if(p.site==requested_site){
+                if(!first)out+=',';first=false;out+=plan_json(p);
+                if(out.size()>64000)throw std::length_error("Too many plans for local session");
+            }
+            return out+"]}";
+        }
+        if(op=="REGISTER"){
+            return "{\"ok\":true,\"plan\":"+
+              plan_json(host_.status(host_.register_layout(decode64(arg),owner_,ship_,requested_site),owner_))+"}";
+        }
+        const auto plan_id=static_cast<std::int64_t>(unsigned_id(arg));
+        const auto p=host_.status(plan_id,owner_);
+        if(p.site!=requested_site||p.ship!=ship_)
+            throw std::invalid_argument("Plan does not belong to selected colony site");
+        if(op=="STATUS")return "{\"ok\":true,\"plan\":"+plan_json(p)+"}";
+        if(op=="CANCEL"){
+            const bool changed=host_.cancel(plan_id,owner_);
+            return std::string("{\"ok\":true,\"changed\":")+(changed?"true":"false")+
+                   ",\"plan\":"+plan_json(host_.status(plan_id,owner_))+"}";
+        }
+        if(op=="STEP"){
+            const auto event=host_.execute_one(plan_id,owner_);
+            return "{\"ok\":true,\"event\":"+event_json(event)+
+                   ",\"plan\":"+plan_json(host_.status(plan_id,owner_))+"}";
+        }
+        throw std::invalid_argument("Invalid factory operation");
+    }
+private:
+    industry::HostBlueprintRegistry host_;
+    PersistentWorld& world_;
+    EntityId ship_;
+    PlayerId owner_;
+};
+
+// Framed ASCII result is transmitted only across the existing trusted child
+// stderr pipe, never written as colony telemetry or a playable SGVIEW frame.
+inline void dispatch(Control& control,const std::string& line,std::ostream& out){
+    const auto a=line.find('|',8),b=a==std::string::npos?a:line.find('|',a+1),
+               c=b==std::string::npos?b:line.find('|',b+1);
+    if(a==std::string::npos||b==std::string::npos||c==std::string::npos)return;
+    const auto id=line.substr(8,a-8);
+    if(id.size()>15||id.empty()||id.find_first_not_of("0123456789")!=std::string::npos)return;
+    std::string response;
+    try{
+        const std::string op=line.substr(a+1,b-a-1);
+        const auto site_text=line.substr(b+1,c-b-1);
+        std::uint64_t site=0;
+        if(site_text!="0")site=unsigned_id(site_text);
+        response=control.handle(op,site,line.substr(c+1));
+        if(response.size()>100000)throw std::length_error("Factory response too large");
+    }catch(const std::exception& e){
+        response="{\"ok\":false,\"error\":"+json_string(std::string(e.what()).substr(0,250))+"}";
+    }
+    out<<"FACTORY_REPLY|"<<id<<'|'<<encode64(response)<<'\n'<<std::flush;
+}
+} // namespace galaxy::colony_factory
