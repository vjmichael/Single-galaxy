diff --git a/src/FactoryRetirementPlanner.cpp b/src/FactoryRetirementPlanner.cpp
new file mode 100644
index 0000000..45a3c90
--- /dev/null
+++ b/src/FactoryRetirementPlanner.cpp
@@ -0,0 +1,62 @@
+#include "galaxy/FactoryRetirementPlanner.hpp"
+#include <map>
+#include <set>
+#include <stdexcept>
+#include <utility>
+namespace galaxy::industry {
+std::vector<RetirementNode> plan_factory_retirement(
+    const std::vector<RetirementNode>& installed,
+    const std::vector<RetirementDependency>& dependencies){
+    // A workload guard protects scheduling, not the physical size of a factory.
+    if(installed.size()>200000 || dependencies.size()>800000)
+        throw std::length_error("Retirement planner needs partitioned evaluation");
+    std::map<RetirementNode,std::size_t> indegree;
+    for(const auto& n:installed){
+        if(!n.id || !indegree.emplace(n,0).second)
+            throw std::invalid_argument("Duplicate or invalid retirement node");
+    }
+    std::map<RetirementNode,std::set<RetirementNode>> outgoing;
+    for(const auto& d:dependencies){
+        if(!indegree.count(d.before)||!indegree.count(d.after)||d.before==d.after)
+            throw std::invalid_argument("Missing or self-dependent retirement node");
+        if(outgoing[d.before].insert(d.after).second)++indegree[d.after];
+    }
+    std::set<RetirementNode> ready;
+    for(const auto& [node,count]:indegree)if(!count)ready.insert(node);
+    std::vector<RetirementNode> result;result.reserve(installed.size());
+    while(!ready.empty()){
+        const auto node=*ready.begin();ready.erase(ready.begin());result.push_back(node);
+        for(const auto& dest:outgoing[node]){
+            if(--indegree.at(dest)==0)ready.insert(dest);
+        }
+    }
+    if(result.size()!=installed.size())
+        throw std::invalid_argument("Retirement dependency cycle; no safe order");
+    return result;
+}
+std::vector<RetirementNode> installed_workshop_retirement(
+    const Simulation& sim,EntityId site){
+    const auto* workshop=sim.workshop(site);
+    const auto* store=sim.storage(site);
+    if(!workshop)return {};
+    if(!store)throw std::invalid_argument("Workshop lacks installed storage");
+    std::vector<RetirementNode> installed;
+    std::vector<RetirementDependency> deps;
+    const RetirementNode primary{RetirementKind::Machine,2};
+    const RetirementNode finisher{RetirementKind::Machine,1};
+    installed.push_back(primary);
+    if(workshop->finisher_installed){
+        installed.push_back(finisher);
+        deps.push_back({finisher,primary});
+    }
+    for(const auto& [id,link]:store->links){
+        if(link.source!=kWorkshopConveyorNode && link.destination!=kWorkshopConveyorNode)
+            continue; // unrelated colony infrastructure stays installed
+        const RetirementNode conveyor{RetirementKind::Conveyor,id};
+        installed.push_back(conveyor);
+        deps.push_back({conveyor,primary});
+        if(workshop->finisher_installed)deps.push_back({conveyor,finisher});
+    }
+    return plan_factory_retirement(installed,deps);
+}
+} // namespace galaxy::industry
