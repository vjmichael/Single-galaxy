diff --git a/tests/ECON02B2d17GraphPlannerTests.cpp b/tests/ECON02B2d17GraphPlannerTests.cpp
new file mode 100644
index 0000000..e5116f9
--- /dev/null
+++ b/tests/ECON02B2d17GraphPlannerTests.cpp
@@ -0,0 +1,23 @@
+#include "galaxy/FactoryRetirementPlanner.hpp"
+#include <iostream>
+#include <stdexcept>
+using namespace galaxy::industry;
+#define CHECK(x) do{if(!(x))throw std::runtime_error("d17 planner "+std::to_string(__LINE__)+": " #x);}while(0)
+int main(){
+ try{
+  const RetirementNode a{RetirementKind::Machine,100},b{RetirementKind::Machine,200},
+       c{RetirementKind::Machine,300},d{RetirementKind::Machine,400};
+  const auto actual=plan_factory_retirement({a,b,c,d},{{d,b},{c,b},{b,a},{d,a}});
+  CHECK(actual.size()==4 && actual.at(0)==c && actual.at(1)==d &&
+        actual.at(2)==b && actual.at(3)==a);
+  CHECK(plan_factory_retirement({d,b,c,a},{{d,b},{c,b},{b,a},{d,a}})==actual);
+  bool bad=false;
+  try{(void)plan_factory_retirement({a,a},{});}catch(const std::invalid_argument&){bad=true;}CHECK(bad);
+  bad=false;try{(void)plan_factory_retirement({a,b},{{a,c}});}catch(const std::invalid_argument&){bad=true;}CHECK(bad);
+  bad=false;try{(void)plan_factory_retirement({a,b},{{a,b},{b,a}});}catch(const std::invalid_argument&){bad=true;}CHECK(bad);
+  bad=false;try{(void)plan_factory_retirement({a},{{a,a}});}catch(const std::invalid_argument&){bad=true;}CHECK(bad);
+  CHECK(plan_factory_retirement({},{}).empty());
+  std::cout<<"ECON-02B2d17 PASS: deterministic graph retire order, branched DAG, missing nodes and cycles\n";
+  return 0;
+ }catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}
+}
diff --git a/tests/ECON02B2d17MultiDestinationTests.cpp b/tests/ECON02B2d17MultiDestinationTests.cpp
new file mode 100644
index 0000000..71c96d5
--- /dev/null
+++ b/tests/ECON02B2d17MultiDestinationTests.cpp
@@ -0,0 +1,167 @@
+#include "galaxy/NpcConstructionCrews.hpp"
+#include "galaxy/FactoryRetirementPlanner.hpp"
+#include <sqlite3.h>
+#include "../src/factory_colony_protocol.hpp"
+#include <chrono>
+#include <filesystem>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+using namespace galaxy;
+namespace fs=std::filesystem;
+#define CHECK(x) do{if(!(x))throw std::runtime_error("d17 line "+std::to_string(__LINE__)+": " #x);}while(0)
+static Event command(PersistentWorld& w,EntityId ship,std::uint64_t id,Action action,
+                     EntityId site,std::int64_t amount,int x=0,int y=0){
+ Command c{};c.id=id;c.sequence=id;c.issuer=7;c.actor=ship;c.target=site;
+ c.action=action;c.amount=amount;c.thrust_x=x;c.thrust_y=y;c.execute_tick=w.world().tick()+1;
+ CHECK(w.submit(c));w.step();return w.world().events().back();
+}
+static void ok(const Event& ev){if(ev.result!=Outcome::Applied)throw std::runtime_error("Rejected fixture command "+std::to_string(ev.command_id)+" outcome "+std::to_string(static_cast<int>(ev.result)));}
+static void advance(PersistentWorld& w,construction::Crews& crew,EntityId ship,std::int64_t mass){
+ w.step();crew.advance(7,ship);CHECK(w.world().total_material_kg()==mass);
+}
+int main(int argc,char** argv){
+ if(argc!=2)return 2;
+ const auto folder=fs::temp_directory_path()/("sg_d17_multi_"+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+ fs::create_directories(folder);const auto db=(folder/"world.sqlite").string();
+ try{
+  CHECK(std::system((std::string("\"")+argv[1]+"\" \""+db+"\"").c_str())==0);
+  EntityId ship=0,site=0;std::uint64_t worker=0;std::int64_t conserved=0;
+  {
+   PersistentWorld w(db,Simulation(1));
+   site=w.world().built_outposts().begin()->first;
+   ship=w.world().built_outposts().begin()->second.source_colony_ship;
+   for(const auto& [id,npc]:w.world().npc_records())
+    if(npc.location==site && npc.role==NpcRole::Habitat){worker=id;break;}
+   CHECK(worker!=0);
+   const auto retirement_plan=industry::installed_workshop_retirement(w.world(),site);
+   CHECK(retirement_plan.size()==3);
+   CHECK((retirement_plan.at(0)==industry::RetirementNode{industry::RetirementKind::Conveyor,18}));
+   CHECK((retirement_plan.at(1)==industry::RetirementNode{industry::RetirementKind::Machine,1}));
+   CHECK((retirement_plan.at(2)==industry::RetirementNode{industry::RetirementKind::Machine,2}));
+   // Two additional real module-built warehouses, each with its own position.
+   ok(command(w,ship,1101,Action::ConstructStorageNode,site,1));
+   ok(command(w,ship,1102,Action::PlaceFactoryEquipment,site,1,6,1));
+   ok(command(w,ship,1103,Action::ConstructStorageNode,site,2));
+   ok(command(w,ship,1104,Action::PlaceFactoryEquipment,site,2,8,2));
+   ok(command(w,ship,1105,Action::SetWorkshopShutdown,site,1));
+   conserved=w.world().total_material_kg();
+   construction::Plans plans(db,w);construction::Crews crew(db,w,plans);
+   crew.queue_line_evacuation(worker,7,ship,site);
+   bool picked=false;
+   for(int t=0;t<60;++t){
+    advance(w,crew,ship,conserved);
+    const auto* stock=w.world().construction_supplies(site);
+    if(stock && stock->evacuation_cargo.count(worker)){
+     picked=true;
+     const auto jobs=crew.list_line_evacuation(7,ship,site);
+     CHECK(jobs.at(0).destination_node==1); // nearer than original 0
+     break;
+    }
+   }
+   CHECK(picked);
+   CHECK(w.world().canonical_state().rfind("galaxy-kernel-v39|",0)==0);
+   // A guessed nonexistent destination must reject delivery while the
+   // *real* worker keeps every kilogram in physical custody.
+   CHECK(command(w,ship,1108,Action::DepositWorkshopGoods,site,1,
+                 static_cast<int>(worker),999*4).result==Outcome::InvalidTarget);
+   CHECK(w.world().construction_supplies(site)->evacuation_cargo.at(worker)[0]==20);
+   CHECK(w.world().total_material_kg()==conserved);
+  }
+  {
+   PersistentWorld w(db,Simulation(1));construction::Plans plans(db,w);
+   construction::Crews crew(db,w,plans);
+   CHECK(crew.list_line_evacuation(7,ship,site).at(0).destination_node==1);
+   CHECK(w.world().construction_supplies(site)->evacuation_cargo.count(worker));
+   for(int t=0;t<130;++t){
+    advance(w,crew,ship,conserved);
+    const auto* st=w.world().storage(site);
+    if(st->extra_bins.at(1).count("aluminum"))break;
+   }
+   CHECK(w.world().storage(site)->extra_bins.at(1).at("aluminum")==20);
+   CHECK(w.world().canonical_state().rfind("galaxy-kernel-v40|",0)==0);
+   CHECK(Simulation::from_snapshot(w.world().canonical_state()).canonical_state()==w.world().canonical_state());
+   // Deprecate warehouse 1 with its real cargo left in place: the next
+   // transfer MUST find another installed destination instead of writing
+   // to a retired node or teleporting stock out of it.
+   ok(command(w,ship,1106,Action::MarkStorageNodeDecommission,site,1));
+   bool done=false;
+   for(int t=0;t<250;++t){
+    advance(w,crew,ship,conserved);
+    if(!crew.list_line_evacuation(7,ship,site).at(0).active){done=true;break;}
+   }
+   CHECK(done);
+   CHECK(w.world().workshop(site)->aluminum_kg==0);
+   CHECK(w.world().storage(site)->extra_bins.at(1).at("aluminum")==20);
+   CHECK(w.world().storage(site)->goods_kg.at("aluminum")==20);
+   CHECK(w.world().total_material_kg()==conserved);
+   // A forged destination node cannot consume carried cargo or synthesize goods.
+   CHECK(command(w,ship,1107,Action::DepositWorkshopGoods,site,1,static_cast<int>(worker),401).result==Outcome::InvalidTarget ||
+         w.world().events().back().result==Outcome::NoResources);
+   CHECK(w.world().total_material_kg()==conserved);
+  }
+  {
+   PersistentWorld w(db,Simulation(1));construction::Plans plans(db,w);construction::Crews crew(db,w,plans);
+   CHECK(w.world().total_material_kg()==conserved);
+   CHECK(w.world().storage(site)->extra_bins.at(1).at("aluminum")==20);
+   CHECK(w.world().storage(site)->goods_kg.at("aluminum")==20);
+   CHECK(w.world().canonical_state().rfind("galaxy-kernel-v40|",0)==0);
+  }
+  // Separate capacity fixture: node 1 occupies its genuine 4m3 with two
+  // construction modules. The scheduler must choose node 2 without lending
+  // warehouse 1's reserved capacity to the incoming goods.
+  const auto full_db=(folder/"full.sqlite").string();
+  CHECK(std::system((std::string("\"")+argv[1]+"\" \""+full_db+"\"").c_str())==0);
+  {
+   PersistentWorld w(full_db,Simulation(1));
+   auto target=w.world().built_outposts().begin()->first;
+   auto carrier=w.world().built_outposts().begin()->second.source_colony_ship;
+   std::uint64_t hauler=0,crewman=0;
+   for(const auto& [id,npc]:w.world().npc_records())if(npc.location==target && npc.role==NpcRole::Habitat){
+    if(!hauler)hauler=id;else crewman=id;
+   }
+   CHECK(hauler && crewman);
+   ok(command(w,carrier,1201,Action::ConstructStorageNode,target,1));
+   ok(command(w,carrier,1202,Action::PlaceFactoryEquipment,target,1,6,1));
+   ok(command(w,carrier,1203,Action::ConstructStorageNode,target,2));
+   ok(command(w,carrier,1204,Action::PlaceFactoryEquipment,target,2,4,2));
+   ok(command(w,carrier,1205,Action::StageConstructionModules,target,2));
+   ok(command(w,carrier,1206,Action::PickupConstructionModules,target,hauler,2));
+   ok(command(w,carrier,1207,Action::DepositConstructionNodeModules,target,hauler,1));
+   CHECK(w.world().construction_node_module_liters(target,1)==4000);
+   const auto mass=w.world().total_material_kg();
+   ok(command(w,carrier,1208,Action::SetWorkshopShutdown,target,1));
+   construction::Plans plans(full_db,w);construction::Crews crew(full_db,w,plans);
+   crew.queue_line_evacuation(crewman,7,carrier,target);
+   bool picked=false;
+   for(int t=0;t<60;++t){
+    advance(w,crew,carrier,mass);
+    const auto* stock=w.world().construction_supplies(target);
+    if(stock && stock->evacuation_cargo.count(crewman)){picked=true;break;}
+   }
+   CHECK(picked);
+   CHECK(crew.list_line_evacuation(7,carrier,target).at(0).destination_node==2);
+   for(int t=0;t<80;++t){
+    advance(w,crew,carrier,mass);
+    if(w.world().storage(target)->extra_bins.at(2).count("aluminum"))break;
+   }
+   CHECK(w.world().storage(target)->extra_bins.at(2).at("aluminum")==20);
+   CHECK(w.world().construction_node_module_liters(target,1)==4000);
+   CHECK(w.world().total_material_kg()==mass);
+  }
+  // The replay auditor must reject a forged secondary-warehouse endpoint.
+  sqlite3* sql=nullptr;
+  CHECK(sqlite3_open_v2(db.c_str(),&sql,SQLITE_OPEN_READWRITE,nullptr)==SQLITE_OK);
+  CHECK(sqlite3_exec(sql,"UPDATE resource_ledger SET destination_id='forged-goods' "
+      "WHERE reason='npc_workshop_inventory_transfer_kg' "
+      "AND destination_id LIKE 'storage-node:%'",nullptr,nullptr,nullptr)==SQLITE_OK);
+  CHECK(sqlite3_changes(sql)>0);sqlite3_close(sql);
+  bool detected=false;
+  try{PersistentWorld corrupted(db,Simulation(1));(void)corrupted;}
+  catch(const std::exception&){detected=true;}
+  CHECK(detected);
+  fs::remove_all(folder);
+  std::cout<<"ECON-02B2d17 PASS: multiple real warehouses, deterministic selection, mid-haul restart, decommission reroute, v40 journal, conservation\n";
+  return 0;
+ }catch(const std::exception& e){std::cerr<<"ECON-02B2d17 FAIL: "<<e.what()<<'\n';fs::remove_all(folder);return 1;}
+}
