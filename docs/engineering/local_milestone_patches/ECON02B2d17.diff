+#pragma once
+#include "galaxy/Simulation.hpp"
+#include <cstdint>
+#include <vector>
+namespace galaxy::industry {
+// Read-only planning model. Edges mean "remove before"; planning never grants
+// authority, transfers cargo, or dismantles an installed component.
+enum class RetirementKind : std::uint8_t { Conveyor=0, Machine=1 };
+struct RetirementNode {
+    RetirementKind kind=RetirementKind::Machine;
+    std::uint64_t id=0;
+    bool operator<(const RetirementNode& b)const noexcept {
+        return kind==b.kind?id<b.id:kind<b.kind;
+    }
+    bool operator==(const RetirementNode& b)const noexcept {
+        return kind==b.kind && id==b.id;
+    }
+    bool operator!=(const RetirementNode& b)const noexcept {return !(*this==b);}
+};
+struct RetirementDependency {
+    RetirementNode before,after;
+};
+// Deterministic topological ordering, rejecting missing steps, duplicates and
+// cycles rather than guessing a physically unsafe sequence. No floor-size cap.
+std::vector<RetirementNode> plan_factory_retirement(
+    const std::vector<RetirementNode>& installed,
+    const std::vector<RetirementDependency>& dependencies);
+// Current real game has one 2-stage workshop; map its actual installed
+// conveyors and machines into the generic dependency planner. Arbitrary new
+// machine types can use plan_factory_retirement, but do not yet have teardown
+// actions in the world simulation.
+std::vector<RetirementNode> installed_workshop_retirement(
+    const Simulation& sim,EntityId site);
+} // namespace galaxy::industry
