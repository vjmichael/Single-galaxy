diff --git a/tests/ECON02B2d9PriorityAllocatorTests.cpp b/tests/ECON02B2d9PriorityAllocatorTests.cpp
new file mode 100644
index 0000000..388c8d5
--- /dev/null
+++ b/tests/ECON02B2d9PriorityAllocatorTests.cpp
@@ -0,0 +1,148 @@
+#include "galaxy/NpcConstructionCrews.hpp"
+#include <algorithm>
+#include <sqlite3.h>
+#include <chrono>
+#include <filesystem>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+using namespace galaxy;
+namespace fs=std::filesystem;
+#define CHECK(x) do{if(!(x))throw std::runtime_error(std::string("d9 line ")+std::to_string(__LINE__)+": " #x);}while(0)
+static void ok(PersistentWorld& w,EntityId ship,std::uint64_t id,Action a,EntityId target=0,std::int64_t n=1,int x=0,int y=0){
+ Command c{};c.id=id;c.sequence=id;c.issuer=7;c.actor=ship;c.target=target;c.amount=n;
+ c.thrust_x=x;c.thrust_y=y;c.action=a;c.execute_tick=w.world().tick()+1;
+ CHECK(w.submit(c));w.step();CHECK(w.world().events().back().result==Outcome::Applied);
+}
+static std::int64_t loose(const Simulation& w,EntityId site){
+ const auto* s=w.construction_supplies(site);if(!s)return 0;
+ std::int64_t n=s->depot;
+ for(const auto& [k,v]:s->node_modules){(void)k;n+=v;}
+ for(const auto& [k,v]:s->carried){(void)k;n+=v;}
+ for(const auto& [k,v]:s->delivered){(void)k;n+=v;}
+ for(const auto& [k,v]:s->reserved){(void)k;n+=v.modules;}
+ return n;
+}
+int main(){
+ const auto folder=fs::temp_directory_path()/("sg_d9_"+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+ fs::create_directories(folder);
+ try{
+  const auto db=(folder/"world.sqlite").string();
+  Simulation sim(900);const auto ship=sim.add_colony_ship(7,{0,0},500,8);
+  sim.provision_colony_genesis(ship,1000,3000,1000,1000,1000);
+  const auto rock=sim.add_asteroid({1000,0},180);sim.enable_individual_workforce();
+  const auto original=sim.total_material_kg();EntityId site=0;std::uint64_t npc=0;
+  std::int64_t low=0,high=0,low2=0,high2=0;
+  {
+   PersistentWorld w(db,std::move(sim));
+   ok(w,ship,1,Action::Mine,rock,100);ok(w,ship,2,Action::RefineOre,0,100);
+   ok(w,ship,3,Action::FabricateModule,0,35);ok(w,ship,4,Action::ConstructOutpost);
+   site=w.world().built_outposts().begin()->first;
+   ok(w,ship,5,Action::ConstructHabitat,site);
+   for(int i=1;i<=3;++i)ok(w,ship,5+i,Action::TransferHabitatStock,site,30,i);
+   ok(w,ship,9,Action::AssignHabitatResidents,site,1);
+   for(const auto& [id,n]:w.world().npc_records())if(n.location==site&&n.role==NpcRole::Habitat)npc=id;
+   CHECK(npc!=0);
+   construction::Plans plans(db,w);
+   // Migrate a real pre-d9 jobs table rather than only a fresh database.
+   {sqlite3* legacy=nullptr;CHECK(sqlite3_open(db.c_str(),&legacy)==SQLITE_OK);
+    const char* ddl="CREATE TABLE sg_construction_jobs(plan_id INTEGER PRIMARY KEY REFERENCES sg_structure_plans(id),"
+        "owner INTEGER NOT NULL,ship INTEGER NOT NULL,site INTEGER NOT NULL,active INTEGER NOT NULL DEFAULT 1,"
+        "completed INTEGER NOT NULL DEFAULT 0,labor INTEGER NOT NULL DEFAULT 0,last_tick INTEGER NOT NULL DEFAULT -1,"
+        "reason TEXT NOT NULL DEFAULT '')";
+    CHECK(sqlite3_exec(legacy,ddl,nullptr,nullptr,nullptr)==SQLITE_OK);sqlite3_close(legacy);
+   }
+   construction::Crews crews(db,w,plans);
+   low=plans.create("sg-colony-structure-plan-v1\n2,9,0\n",7,ship,site);
+   high=plans.create("sg-colony-structure-plan-v1\n2,2,0\n",7,ship,site);
+   crews.assign(low,npc,7,ship,site);
+   crews.set_policy(low,0,true,7,ship,site);
+   crews.set_policy(high,3,true,7,ship,site);
+   crews.set_active(low,false,7,ship,site);
+   bool rejected=false;
+   try{crews.set_policy(high,4,true,7,ship,site);}catch(const std::invalid_argument&){rejected=true;}
+   CHECK(rejected);
+   rejected=false;
+   try{crews.set_policy(high,2,true,8,ship,site);}catch(const std::invalid_argument&){rejected=true;}
+   CHECK(rejected);
+   const auto stage=plans.supply_action(Action::StageConstructionModules,2,0,0,7,ship,site);
+   CHECK(stage.result==Outcome::Applied);
+   const auto held=plans.supply_action(Action::ReserveConstructionModules,low,0,2,7,ship,site);
+   CHECK(held.result==Outcome::Applied);
+   CHECK(w.world().construction_supplies(site)->depot==0);
+   CHECK(w.world().construction_supplies(site)->reserved.at(low).modules==2);
+   const auto baseline=w.world().colony_ship(ship)->modules+loose(w.world(),site);
+   crews.advance(7,ship);
+   auto jobs=crews.list(7,ship,site);
+   CHECK(jobs.size()==2);
+   CHECK(jobs[0].plan==low&&jobs[0].workers.empty());
+   CHECK(jobs[1].plan==high&&jobs[1].workers.size()==1&&jobs[1].workers.front().npc==npc);
+   CHECK(!w.world().construction_supplies(site)->reserved.count(low));
+   CHECK(w.world().construction_supplies(site)->depot==2);
+   CHECK(w.world().colony_ship(ship)->modules+loose(w.world(),site)==baseline);
+   CHECK(w.world().total_material_kg()==original);
+  }
+  {
+   PersistentWorld w(db,Simulation(1));construction::Plans plans(db,w);construction::Crews crews(db,w,plans);
+   auto jobs=crews.list(7,ship,site);
+   CHECK(jobs.size()==2&&jobs[0].priority==0&&jobs[0].autonomy&&jobs[1].priority==3&&jobs[1].autonomy);
+   CHECK(jobs[1].workers.size()==1);
+   CHECK(w.world().construction_supplies(site)->depot==2);
+   bool high_done=false;
+   for(int i=0;i<130&&!high_done;++i){crews.advance(7,ship);w.step();high_done=plans.status(high,7,ship,site).finished();}
+   CHECK(high_done);
+   CHECK(!plans.status(low,7,ship,site).finished());
+   CHECK(w.world().total_material_kg()==original);
+   // Once critical work completes, the borrowed worker becomes available
+   // again for the lower-priority autonomous project without player clicks.
+   CHECK(crews.set_active(low,true,7,ship,site));
+   crews.advance(7,ship);
+   auto handed_back=crews.list(7,ship,site);
+   CHECK(handed_back[0].workers.size()==1&&handed_back[0].workers[0].npc==npc);
+   CHECK(handed_back[1].workers.empty());
+   CHECK(crews.set_active(low,false,7,ship,site));
+   CHECK(crews.unassign(npc,7,ship,site));
+   low2=plans.create("sg-colony-structure-plan-v1\n2,11,0\n",7,ship,site);
+   high2=plans.create("sg-colony-structure-plan-v1\n1,12,0\n",7,ship,site);
+   crews.assign(low2,npc,7,ship,site);
+   crews.set_policy(low2,0,true,7,ship,site);
+   crews.set_policy(high2,3,true,7,ship,site);
+   CHECK(crews.set_active(low2,false,7,ship,site));
+   CHECK(plans.supply_action(Action::StageConstructionModules,1,0,0,7,ship,site).result==Outcome::Applied);
+   const auto pickup=plans.supply_action(Action::PickupConstructionModules,npc,1,0,7,ship,site);
+   CHECK(pickup.result==Outcome::Applied);
+   crews.advance(7,ship);
+   jobs=crews.list(7,ship,site);
+   const auto find=[&](std::int64_t id){return std::find_if(jobs.begin(),jobs.end(),[&](const auto& j){return j.plan==id;});};
+   CHECK(find(low2)!=jobs.end()&&find(low2)->workers.size()==1);
+   CHECK(find(high2)!=jobs.end()&&find(high2)->workers.empty());
+   CHECK(w.world().construction_supplies(site)->carried.at(npc)==1);
+   CHECK(w.world().total_material_kg()==original);
+  }
+  {
+   PersistentWorld w(db,Simulation(2));construction::Plans plans(db,w);construction::Crews crews(db,w,plans);
+   const auto before=w.world().colony_ship(ship)->modules+loose(w.world(),site);
+   CHECK(w.world().construction_supplies(site)->carried.at(npc)==1);
+   const auto returned=plans.supply_action(Action::ReturnConstructionModules,npc,0,0,7,ship,site);
+   CHECK(returned.result==Outcome::Applied);
+   crews.advance(7,ship);
+   auto jobs=crews.list(7,ship,site);
+   bool reassigned=false;
+   for(const auto& j:jobs)if(j.plan==high2)reassigned=j.workers.size()==1&&j.workers.front().npc==npc;
+   CHECK(reassigned);
+   // Free, eligible idle residents can also self-assign, but only because
+   // this target plan explicitly opted into autonomous staffing.
+   CHECK(crews.unassign(npc,7,ship,site));
+   crews.advance(7,ship);
+   jobs=crews.list(7,ship,site);
+   reassigned=false;
+   for(const auto& j:jobs)if(j.plan==high2)reassigned=j.workers.size()==1&&j.workers.front().npc==npc;
+   CHECK(reassigned);
+   CHECK(w.world().colony_ship(ship)->modules+loose(w.world(),site)==before);
+   CHECK(w.world().total_material_kg()==original);
+  }
+  fs::remove_all(folder);
+  std::cout<<"ECON-02B2d9 PASS: administrative priority, durable migration, exclusive preemption, opt-in staffing, carried cargo guard and conservation\n";
+  return 0;
+ }catch(const std::exception& e){std::cerr<<"ECON-02B2d9 FAIL: "<<e.what()<<'\n';fs::remove_all(folder);return 1;}
+}
