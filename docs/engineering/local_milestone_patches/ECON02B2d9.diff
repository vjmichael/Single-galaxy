+// Priority is an administrative policy on an already authorized plan, not a
+// resource transfer. The actual preemption is a separate journaled world event.
+void Crews::set_policy(std::int64_t plan,int priority,bool autonomy,PlayerId owner,EntityId ship,EntityId site){
+ if(priority<0||priority>3)throw std::invalid_argument("Construction priority must be 0..3");
+ const auto state=structures_.status(plan,owner,ship,site);
+ if(state.cancelled||state.conflicting||state.finished())throw std::invalid_argument("Construction plan is not active");
+ validate_site(owner,ship,site);
+ Query put(db_->db,"INSERT OR IGNORE INTO sg_construction_jobs(plan_id,owner,ship,site,completed) VALUES(?,?,?,?,?)");
+ put.n(1,plan);put.n(2,owner);put.n(3,ship);put.n(4,site);put.n(5,static_cast<std::int64_t>(state.completed));put.done();
+ Query update(db_->db,"UPDATE sg_construction_jobs SET priority=?,autonomy=? WHERE plan_id=? AND owner=? AND ship=? AND site=?");
+ update.n(1,priority);update.n(2,autonomy?1:0);update.n(3,plan);update.n(4,owner);update.n(5,ship);update.n(6,site);update.done();
+ if(sqlite3_changes(db_->db)!=1)throw std::invalid_argument("Construction plan not owned by this colony");
+}
