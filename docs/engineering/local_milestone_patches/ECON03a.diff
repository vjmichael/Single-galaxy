+import urllib.request
+
+
+def check(ok, why):
+    if not ok:
+        raise AssertionError(why)
+
+
+def direct(exe, legacy=False):
+    with tempfile.TemporaryDirectory(prefix='sg-econ03a-') as folder:
+        db=pathlib.Path(folder)/'world.sqlite'
+        command=[str(exe),str(db),'25','8']
+        if legacy:
+            command+=['--legacy-market-fixture']
+        result=subprocess.run(command,input=b'SELL\n',stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=12)
+        check(result.returncode==0,'host failed '+result.stderr.decode(errors='replace'))
+        frame=result.stdout.decode('ascii')
+        check(frame.startswith('SGVIEW|1|') and '\nEND\n' in frame,'missing canonical saved world')
+        if legacy:
+            check('M|1|0|1000|2' in frame,'archived market fixture missing')
+        else:
+            check(not any(line.startswith(('W|','M|')) for line in frame.splitlines()),
+                  'resource-only host sent financial accounts or markets')
+            check(b'ECON03A REJECT' in result.stderr,'raw sell command was not rejected')
+        check(db.stat().st_size>1024,'authoritative SQLite save not created')
+
+
+def get(base,path):
+    with urllib.request.urlopen(base+path,timeout=3) as response:
+        return response.read()
+
+
+def post(base,doc):
+    req=urllib.request.Request(base+'/command',data=json.dumps(doc).encode('utf8'),
+        headers={'Origin':base,'Content-Type':'application/json'},method='POST')
+    try:
+        with urllib.request.urlopen(req,timeout=3) as response:
+            return response.status
+    except urllib.error.HTTPError as ex:
+        ex.read()
+        return ex.code
+
+
+def relay(exe,relay_path):
+    with socket.socket() as sock:
+        sock.bind(('127.0.0.1',0));port=sock.getsockname()[1]
+    base=f'http://127.0.0.1:{port}'
+    process=subprocess.Popen([sys.executable,str(relay_path),'--host-exe',str(exe),
+        '--port',str(port),'--tick-ms','30','--max-ticks','55'],
+        stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
+    try:
+        for _ in range(80):
+            try:
+                if b'alive' in get(base,'/healthz'):
+                    break
+            except (urllib.error.URLError,ConnectionError):
+                time.sleep(.04)
+        else:
+            raise AssertionError('relay did not start')
+        session=json.loads(get(base,'/session'))
+        check(session['legacy_market_fixture'] is False,'legacy fixture enabled by default')
+        check('sell' not in session['commands'],'sell capability advertised')
+        check({'load','unload','mine'}.issubset(session['commands']),'physical resources disabled')
+        html=get(base,'/viewer/interactive.html')
+        check(b'id="legacyEconomy" hidden' in html and b'id="legacySell" hidden' in html,
+              'money UI not hidden by default')
+        check(post(base,{'token':session['token'],'action':'sell'})==400,'sell allowed in resource-only game')
+        check(post(base,{'token':'invalid','action':'load'})==403,'forged token accepted')
+        check(post(base,{'token':session['token'],'action':'load'})==202,'legitimate cargo request rejected')
+        check(post(base,{'token':session['token'],'action':'unload'})==202,'legitimate cargo request rejected')
+        print('PASS ECON03a: default resource-only world, sell disabled, physical transfers and auth intact')
+    finally:
+        process.terminate()
+        try:
+            process.communicate(timeout=5)
+        except subprocess.TimeoutExpired:
+            process.kill();process.communicate()
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser()
+    parser.add_argument('--executable',required=True,type=pathlib.Path)
+    parser.add_argument('--relay',required=True,type=pathlib.Path)
+    args=parser.parse_args()
+    direct(args.executable)
+    direct(args.executable,True)
+    relay(args.executable,args.relay)
