+#!/usr/bin/env python3
+"""ECON-03a: resource-only game startup has no currency or sell capability.
+
+These tests deliberately preserve the archived opt-in financial fixture for
+old save/wire compatibility; that fixture is not the current game economy.
+"""
+import argparse
