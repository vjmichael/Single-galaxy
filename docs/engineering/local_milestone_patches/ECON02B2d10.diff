diff --git a/tests/ECON02B2d10SourceRecoveryTests.cpp b/tests/ECON02B2d10SourceRecoveryTests.cpp
new file mode 100644
index 0000000..1cf6664
--- /dev/null
+++ b/tests/ECON02B2d10SourceRecoveryTests.cpp
@@ -0,0 +1,153 @@
+#include "galaxy/NpcConstructionCrews.hpp"
+#include <algorithm>
+#include <chrono>
+#include <filesystem>
+#include <iostream>
+#include <stdexcept>
+using namespace galaxy;
+namespace fs=std::filesystem;
+#define CHECK(condition) do{if(!(condition))throw std::runtime_error(std::string("d10 line ")+std::to_string(__LINE__)+": " #condition);}while(0)
+static void action(PersistentWorld& w,EntityId ship,std::uint64_t id,Action kind,EntityId site=0,
+                   std::int64_t amount=1,int x=0,int y=0){
+ Command c{};c.id=id;c.sequence=id;c.issuer=7;c.actor=ship;c.target=site;c.amount=amount;
+ c.action=kind;c.thrust_x=x;c.thrust_y=y;c.execute_tick=w.world().tick()+1;
+ CHECK(w.submit(c));w.step();CHECK(w.world().events().back().result==Outcome::Applied);
+}
+static std::int64_t source_modules(const Simulation& sim,EntityId site){
+ const auto* stock=sim.construction_supplies(site);if(!stock)return 0;
+ std::int64_t total=stock->depot;
+ for(const auto& [n,v]:stock->node_modules){(void)n;total+=v;}
+ for(const auto& [n,v]:stock->reserved){(void)n;total+=v.modules;}
+ for(const auto& [n,v]:stock->carried){(void)n;total+=v;}
+ for(const auto& [n,v]:stock->delivered){(void)n;total+=v;}
+ return total;
+}
+int main(){
+ const auto folder=fs::temp_directory_path()/("sg_d10_"+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+ fs::create_directories(folder);
+ try{
+  const auto db=(folder/"world.sqlite").string();
+  Simulation initial(1010);const auto ship=initial.add_colony_ship(7,{0,0},500,8);
+  initial.provision_colony_genesis(ship,1000,3000,1000,1000,1000);
+  const auto rock=initial.add_asteroid({1000,0},180);initial.enable_individual_workforce();
+  const auto mass=initial.total_material_kg();EntityId site=0;std::uint64_t npc=0;std::int64_t plan=0;
+  std::int64_t custody_before=0;
+  {
+   PersistentWorld w(db,std::move(initial));
+   action(w,ship,1,Action::Mine,rock,150);action(w,ship,2,Action::RefineOre,0,150);
+   action(w,ship,3,Action::FabricateModule,0,60);action(w,ship,4,Action::ConstructOutpost);
+   site=w.world().built_outposts().begin()->first;
+   action(w,ship,5,Action::ConstructHabitat,site);
+   for(int i=1;i<=3;++i)action(w,ship,5+i,Action::TransferHabitatStock,site,30,i);
+   action(w,ship,9,Action::AssignHabitatResidents,site,1);
+   for(const auto& [id,n]:w.world().npc_records())if(n.location==site&&n.role==NpcRole::Habitat)npc=id;
+   CHECK(npc!=0);
+   action(w,ship,10,Action::ConstructStorage,site);
+   action(w,ship,11,Action::ConstructStorageNode,site,1);
+   action(w,ship,12,Action::ConstructStorageNode,site,2);
+   action(w,ship,13,Action::PlaceFactoryEquipment,site,1,4,0);
+   action(w,ship,14,Action::PlaceFactoryEquipment,site,2,8,0);
+   construction::Plans plans(db,w);construction::Crews crews(db,w,plans);
+   plan=plans.create("sg-colony-structure-plan-v1\n2,10,0\n",7,ship,site);
+   crews.assign(plan,npc,7,ship,site);
+   const auto transfer=[&](Action kind,std::int64_t n,int x=0,int y=0){
+    CHECK(plans.supply_action(kind,n,x,y,7,ship,site).result==Outcome::Applied);
+   };
+   transfer(Action::StageConstructionModules,4);
+   transfer(Action::PickupConstructionModules,npc,2);
+   transfer(Action::DepositConstructionNodeModules,npc,1);
+   transfer(Action::PickupConstructionModules,npc,2);
+   transfer(Action::DepositConstructionNodeModules,npc,2);
+   transfer(Action::ReserveConstructionModules,plan,1,2);
+   auto job=crews.list(7,ship,site).at(0);
+   CHECK(job.remaining_modules==2&&job.unallocated_modules==0);
+   custody_before=w.world().colony_ship(ship)->modules+source_modules(w.world(),site);
+   // A physically closed enclosure isolates source #1. The source is still
+   // installed: its stock must remain at that source after recovery.
+   action(w,ship,15,Action::BuildColonyFixture,site,2,3,0); // west
+   action(w,ship,16,Action::BuildColonyFixture,site,2,4,0); // east
+   action(w,ship,17,Action::BuildColonyFixture,site,3,4,-1);// south
+   action(w,ship,18,Action::BuildColonyFixture,site,3,4,0); // north
+   CHECK(!w.world().structure_edge_passable(site,3,0,4,0));
+   CHECK(!w.world().structure_edge_passable(site,4,0,5,0));
+   crews.advance(7,ship);
+   const auto* stock=w.world().construction_supplies(site);
+   CHECK(!stock->reserved.count(plan));
+   CHECK(stock->node_modules.at(1)==2);
+   job=crews.list(7,ship,site).at(0);
+   CHECK(job.reason.find("SOURCE_ROUTE_BLOCKED")!=std::string::npos);
+   CHECK(job.unallocated_modules==2);
+   CHECK(w.world().total_material_kg()==mass);
+   // Custody change is exclusively four physical walls (8 modules).
+   CHECK(w.world().colony_ship(ship)->modules+source_modules(w.world(),site)==custody_before-8);
+  }
+  {
+   PersistentWorld w(db,Simulation(1));construction::Plans plans(db,w);construction::Crews crews(db,w,plans);
+   CHECK(w.world().construction_supplies(site)->node_modules.at(1)==2);
+   CHECK(!w.world().construction_supplies(site)->reserved.count(plan));
+   CHECK(w.world().total_material_kg()==mass);
+   bool success=false,alternative=false;
+   for(int i=0;i<160;++i){
+    crews.advance(7,ship);
+    const auto* stock=w.world().construction_supplies(site);
+    if(stock && stock->reserved.count(plan) && stock->reserved.at(plan).node==2)alternative=true;
+    if(plans.status(plan,7,ship,site).finished()){success=true;break;}
+    w.step();
+   }
+   CHECK(alternative);
+   CHECK(success);
+   CHECK(w.world().construction_supplies(site)->node_modules.at(1)==2);
+   CHECK(!w.world().construction_supplies(site)->reserved.count(plan));
+   CHECK(crews.list(7,ship,site).at(0).remaining_modules==0);
+   // The second work site is enclosed with new physical walls. The worker
+   // must report a blocked dependency rather than repeatedly staging ship
+   // cargo at a depot that cannot reach the site.
+   CHECK(crews.unassign(npc,7,ship,site));
+   action(w,ship,31,Action::BuildColonyFixture,site,2,14,0);
+   action(w,ship,32,Action::BuildColonyFixture,site,2,15,0);
+   action(w,ship,33,Action::BuildColonyFixture,site,3,15,-1);
+   action(w,ship,34,Action::BuildColonyFixture,site,3,15,0);
+   const auto blocked=plans.create("sg-colony-structure-plan-v1\n1,15,0\n",7,ship,site);
+   crews.assign(blocked,npc,7,ship,site);
+   const auto before_blocked=w.world().colony_ship(ship)->modules+source_modules(w.world(),site);
+   crews.advance(7,ship);
+   const auto trouble=crews.list(7,ship,site).back();
+   CHECK(trouble.plan==blocked);
+   CHECK(trouble.remaining_modules==1&&trouble.unallocated_modules==1);
+   CHECK(trouble.reason.find("SUPPLY_ROUTE_BLOCKED")!=std::string::npos);
+   CHECK(!w.world().construction_supplies(site)->reserved.count(blocked));
+   CHECK(w.world().colony_ship(ship)->modules+source_modules(w.world(),site)==before_blocked);
+   // Priority-aware planning spends each free module at most once in its
+   // forecast, but neither moves nor actually reserves anything.
+   const auto low=plans.create("sg-colony-structure-plan-v1\n2,8,3\n",7,ship,site);
+   const auto high=plans.create("sg-colony-structure-plan-v1\n2,9,3\n",7,ship,site);
+   crews.set_policy(low,0,false,7,ship,site);
+   crews.set_policy(high,3,false,7,ship,site);
+   CHECK(plans.supply_action(Action::StageConstructionModules,2,0,0,7,ship,site).result==Outcome::Applied);
+   const auto state_before=w.world().canonical_state();
+   const auto forecast=crews.list(7,ship,site);
+   auto get=[&](std::int64_t id)->const construction::CrewJob&{
+    const auto it=std::find_if(forecast.begin(),forecast.end(),[&](const auto& j){return j.plan==id;});
+    CHECK(it!=forecast.end());return *it;
+   };
+   CHECK(get(high).projected_local_funding==2&&get(high).projected_local_gap==0);
+   CHECK(get(low).projected_local_funding==0&&get(low).projected_local_gap==2);
+   CHECK(get(blocked).projected_local_funding==0&&get(blocked).projected_local_gap==1);
+   CHECK(w.world().canonical_state()==state_before);
+   CHECK(w.world().total_material_kg()==mass);
+  }
+  {
+   PersistentWorld w(db,Simulation(2));construction::Plans plans(db,w);construction::Crews crews(db,w,plans);
+   CHECK(plans.status(plan,7,ship,site).finished());
+   const auto rows=crews.list(7,ship,site);
+   CHECK(rows.size()==4);
+   CHECK(std::any_of(rows.begin(),rows.end(),[](const auto& j){return j.reason.find("SUPPLY_ROUTE_BLOCKED")!=std::string::npos;}));
+   CHECK(std::any_of(rows.begin(),rows.end(),[](const auto& j){return j.priority==3 && j.projected_local_funding==2;}));
+   CHECK(w.world().construction_supplies(site)->node_modules.at(1)==2);
+   CHECK(w.world().total_material_kg()==mass);
+  }
+  fs::remove_all(folder);
+  std::cout << "ECON-02B2d10 PASS: closed source, physical release, alternate-source build, demand and restart\n";
+  return 0;
+ }catch(const std::exception& e){std::cerr<<"ECON-02B2d10 FAIL: "<<e.what()<<'\n';fs::remove_all(folder);return 1;}
+}
