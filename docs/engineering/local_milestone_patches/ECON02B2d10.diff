+   }
+   if(reachable(world_.world(),site,worker,location)!=Route::Yes ||
+      reachable(world_.world(),site,location,goal)!=Route::Yes)continue;
+   const auto dist=std::llabs(static_cast<long long>(worker.first)-location.first)+
+                   std::llabs(static_cast<long long>(worker.second)-location.second)+
+                   std::llabs(static_cast<long long>(location.first)-goal.first)+
+                   std::llabs(static_cast<long long>(location.second)-goal.second);
+   sources.push_back({dist,node});
+  }
+  std::sort(sources.begin(),sources.end(),[](const Candidate& a,const Candidate& b){
+   return std::tie(a.distance,a.node)<std::tie(b.distance,b.node);
+  });
+  for(const auto& source:sources){
+   const auto amount=std::min(job.projected_local_gap,forecast_stock[source.node]);
+   job.projected_local_funding+=amount;
