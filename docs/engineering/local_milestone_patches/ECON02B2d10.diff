+// A route is certified blocked only if the explored connected component is
+// exhausted. Exhausting the CPU budget yields Unknown, not a false No.
+// This work budget never limits where players may construct buildings.
+enum class Route { Yes, No, Unknown };
+Route reachable(const Simulation& sim,EntityId site,Pos start,Pos target){
+ if(start==target)return Route::Yes;
+ const auto valid=[](Pos p){return std::abs(static_cast<long long>(p.first))<=1000000 &&
+                                   std::abs(static_cast<long long>(p.second))<=1000000;};
+ if(!valid(start)||!valid(target))return Route::No;
+ const auto straight=[&](bool horizontal_first){
+  Pos at=start;
+  for(int axis=0;axis<2;++axis){
+   const bool horizontal=(axis==0)==horizontal_first;
+   const int dest=horizontal?target.first:target.second;
+   while((horizontal?at.first:at.second)!=dest){
+    Pos next=at;
+    if(horizontal)next.first+=(dest>at.first?1:-1);
+    else next.second+=(dest>at.second?1:-1);
+    if(!sim.structure_edge_passable(site,at.first,at.second,next.first,next.second))return false;
+    at=next;
+   }
+  }
+  return true;
+ };
+ const auto distance=std::llabs(static_cast<long long>(start.first)-target.first)+
+                     std::llabs(static_cast<long long>(start.second)-target.second);
+ if(distance<=512 && (straight(true)||straight(false)))return Route::Yes;
+ const std::array<Pos,4> directions{{{1,0},{0,1},{-1,0},{0,-1}}};
+ std::queue<Pos> q;std::map<Pos,bool> seen;q.push(start);seen[start]=true;
+ std::size_t visited=0;
+ while(!q.empty() && visited<4096){
+  const auto at=q.front();q.pop();++visited;
+  for(const auto& d:directions){
+   Pos other{at.first+d.first,at.second+d.second};
+   if(!valid(other)||seen.count(other)||
+      !sim.structure_edge_passable(site,at.first,at.second,other.first,other.second))continue;
+   if(other==target)return Route::Yes;
+   seen[other]=true;q.push(other);
+  }
+ }
+ return q.empty()?Route::No:Route::Unknown;
+}
