+++ b/tests/ECON02B2d7MaterialHaulingTests.cpp
@@ -0,0 +1,100 @@
+#include "galaxy/NpcConstructionCrews.hpp"
+#include <chrono>
+#include <filesystem>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+using namespace galaxy;
+namespace fs=std::filesystem;
+#define REQUIRE(x) do{if(!(x))throw std::runtime_error(std::string("B2d7 line ")+std::to_string(__LINE__)+": " #x);}while(0)
+static Event action(PersistentWorld& w,EntityId ship,std::uint64_t id,Action a,EntityId target=0,std::int64_t amount=1,int x=0,int y=0){
+    Command c{};c.id=id;c.sequence=id;c.issuer=7;c.actor=ship;c.target=target;c.amount=amount;c.thrust_x=x;c.thrust_y=y;c.action=a;c.execute_tick=w.world().tick()+1;
+    REQUIRE(w.submit(c));w.step();REQUIRE(w.world().events().back().command_id==id);return w.world().events().back();
+}
+static void good(PersistentWorld& w,EntityId ship,std::uint64_t id,Action a,EntityId target=0,std::int64_t amount=1,int x=0,int y=0){REQUIRE(action(w,ship,id,a,target,amount,x,y).result==Outcome::Applied);}
+static std::int64_t in_custody(const Simulation& sim,EntityId site){
+    const auto* c=sim.construction_supplies(site);if(!c)return 0;
+    auto n=c->depot;for(const auto& [id,qty]:c->carried){(void)id;n+=qty;}
+    for(const auto& [key,qty]:c->delivered){(void)key;n+=qty;}return n;
+}
+int main(){
+ const auto root=fs::temp_directory_path()/("sg_b2d7_"+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));fs::create_directories(root);
+ try{
+  const auto path=(root/"world.sqlite").string();
+  Simulation initial(850);const auto ship=initial.add_colony_ship(7,{0,0},500,8);
+  initial.provision_colony_genesis(ship,1000,3000,1000,1000,1000);
+  const auto rock=initial.add_asteroid({1000,0},180);initial.enable_individual_workforce();
+  const auto expected_mass=initial.total_material_kg();
+  EntityId site=0;std::uint64_t npc=0;std::int64_t first=0,second=0,starting_modules=0;
+  {
+   PersistentWorld w(path,std::move(initial));
+   good(w,ship,1,Action::Mine,rock,80);good(w,ship,2,Action::RefineOre,0,80);
+   good(w,ship,3,Action::FabricateModule,0,30);good(w,ship,4,Action::ConstructOutpost);
+   site=w.world().built_outposts().begin()->first;
+   good(w,ship,5,Action::ConstructHabitat,site);
+   good(w,ship,6,Action::TransferHabitatStock,site,20,1);
+   good(w,ship,7,Action::TransferHabitatStock,site,20,2);
+   good(w,ship,8,Action::TransferHabitatStock,site,20,3);
+   good(w,ship,9,Action::AssignHabitatResidents,site,1);
+   for(const auto& [id,r]:w.world().npc_records())if(r.location==site && r.role==NpcRole::Habitat)npc=id;
+   REQUIRE(npc!=0);starting_modules=w.world().colony_ship(ship)->modules;
+   construction::Plans plans(path,w);construction::Crews crews(path,w,plans);
+   first=plans.create("sg-colony-structure-plan-v1\n1,7,0\n",7,ship,site);
+   crews.assign(first,npc,7,ship,site);
+   bool picked=false;
+   for(int i=0;i<20&&!picked;++i){crews.advance(7,ship);w.step();
+    const auto* supplies=w.world().construction_supplies(site);
+    picked=supplies && supplies->carried.count(npc)>0;
+   }
+   REQUIRE(picked);
+   REQUIRE(plans.status(first,7,ship,site).completed==0);
+   REQUIRE(w.world().total_material_kg()==expected_mass);
+   REQUIRE(w.world().colony_ship(ship)->modules+in_custody(w.world(),site)==starting_modules);
+   // An unassigned worker cannot magically destroy their carried cargo.
+   bool refused=false;try{crews.unassign(npc,7,ship,site);}catch(const std::invalid_argument&){refused=true;}REQUIRE(refused);
+  }
+  {
+   PersistentWorld w(path,Simulation(1));construction::Plans plans(path,w);construction::Crews crews(path,w,plans);
+   const auto* supplies=w.world().construction_supplies(site);
+   REQUIRE(supplies && supplies->carried.at(npc)==1);
+   REQUIRE(w.world().total_material_kg()==expected_mass);
+   // No forged worker can claim cargo; this is checked by authoritative world.
+   REQUIRE(plans.supply_action(Action::PickupConstructionModules,999999,1,0,7,ship,site).result==Outcome::InvalidTarget);
+   REQUIRE(w.world().total_material_kg()==expected_mass);
+   for(int i=0;i<100&&!plans.status(first,7,ship,site).finished();++i){crews.advance(7,ship);w.step();}
+   REQUIRE(plans.status(first,7,ship,site).finished());
+   REQUIRE(w.world().colony_fixtures(site).size()==1);
+   REQUIRE(w.world().colony_ship(ship)->modules+in_custody(w.world(),site)==starting_modules-1);
+   REQUIRE(w.world().total_material_kg()==expected_mass);
+   REQUIRE(w.world().construction_supplies(site)->carried.count(npc)==0);
+   REQUIRE(crews.unassign(npc,7,ship,site));
+   second=plans.create("sg-colony-structure-plan-v1\n2,9,0\n",7,ship,site);
+   crews.assign(second,npc,7,ship,site);
+   bool carrying=false;
+   for(int i=0;i<60&&!carrying;++i){crews.advance(7,ship);w.step();
+    const auto* s=w.world().construction_supplies(site);carrying=s&&s->carried.count(npc)>0;
+   }
+   REQUIRE(carrying);
+   REQUIRE(plans.cancel(second,7,ship,site));
+   const auto before=w.world().colony_ship(ship)->modules+in_custody(w.world(),site);
+   // No construction step can be committed after plan cancellation.
+   for(int i=0;i<65;++i){crews.advance(7,ship);w.step();}
+   REQUIRE(plans.status(second,7,ship,site).cancelled);
+   REQUIRE(w.world().colony_fixtures(site).size()==1);
+   REQUIRE(w.world().construction_supplies(site)->carried.count(npc)==0);
+   REQUIRE(w.world().colony_ship(ship)->modules+in_custody(w.world(),site)==before);
+   REQUIRE(w.world().total_material_kg()==expected_mass);
+  }
+  {
+   PersistentWorld w(path,Simulation(2));construction::Plans plans(path,w);construction::Crews crews(path,w,plans);
+   REQUIRE(plans.status(first,7,ship,site).finished());
+   REQUIRE(plans.status(second,7,ship,site).cancelled);
+   REQUIRE(w.world().total_material_kg()==expected_mass);
+   REQUIRE(w.world().construction_supplies(site)->carried.count(npc)==0);
+   REQUIRE(crews.unassign(npc,7,ship,site));
+  }
+  fs::remove_all(root);
+  std::cout<<"ECON-02B2d7 PASS: depot -> named NPC cargo -> delivery -> build; crash recovery; cancelled cargo return; no creation of modules\n";
+  return 0;
+ }catch(const std::exception& e){std::cerr<<"ECON-02B2d7 FAIL: "<<e.what()<<'\n';fs::remove_all(root);return 1;}
+}
