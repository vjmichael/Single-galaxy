@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""d13: actual localhost relay, owner token, durable assigned NPC removal."""
+import argparse, http.client, json, pathlib, socket, subprocess, sys, tempfile, time
+p=argparse.ArgumentParser()
+for n in ('host','fixture','relay'):p.add_argument('--'+n,required=True)
+a=p.parse_args()
+def free_port():
+    with socket.socket() as s:
+        s.bind(('127.0.0.1',0))
+        return s.getsockname()[1]
+class Game:
+    def __init__(self,save):
+        self.port=free_port()
+        self.child=subprocess.Popen([sys.executable,a.relay,'--colony','--host-exe',a.host,'--save',str(save),
+             '--port',str(self.port),'--tick-ms','75','--max-ticks','1200'],stdin=subprocess.DEVNULL,
+             stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+        for _ in range(100):
+            if self.child.poll() is not None:raise AssertionError('Colony relay stopped early')
+            try:
+                if self.get('/healthz')[0]==200:break
+            except (OSError,TimeoutError):pass
+            time.sleep(.05)
+        else:raise AssertionError('Colony relay not ready')
+    def request(self,method,path,data=None,headers=None):
+        c=http.client.HTTPConnection('127.0.0.1',self.port,timeout=12)
+        body=json.dumps(data,separators=(',',':')).encode() if data is not None else None
+        h={'Host':'127.0.0.1:'+str(self.port),**(headers or {})}
+        if body is not None:
+            h.setdefault('Content-Type','application/json')
+            h.setdefault('Origin','http://127.0.0.1:'+str(self.port))
+        try:
+            c.request(method,path,body,headers=h)
+            r=c.getresponse();raw=r.read()
+            return r.status,json.loads(raw) if r.getheader('Content-Type')=='application/json' else raw.decode()
+        finally:c.close()
+    def get(self,path):return self.request('GET',path)
+    def post(self,path,data,headers=None):return self.request('POST',path,data,headers)
+    def close(self):
+        self.child.terminate()
+        try:self.child.communicate(timeout=8)
+        except subprocess.TimeoutExpired:self.child.kill();self.child.communicate(timeout=5)
+with tempfile.TemporaryDirectory(prefix='sg-d13-http-') as temp:
+    save=pathlib.Path(temp)/'world.sqlite'
+    fixture=subprocess.run([a.fixture,str(save)],capture_output=True,text=True,timeout=30)
+    assert fixture.returncode==0,fixture.stderr
+    game=Game(save)
+    try:
+        status,session=game.get('/session');assert status==200,(status,session)
+        token=session['token']
+        status,sites=game.get('/factory/api/sites');assert status==200 and len(sites['sites'])==1
+        site=sites['sites'][0]
+        status,listing=game.get('/factory/api/crews?site='+str(site))
+        assert status==200 and len(listing['residents'])==2,(status,listing)
+        npc=listing['residents'][0]
+        assert len(listing['supply']['sources'])==1
+        body={'token':token,'site':site,'npc':npc,'target':1,'link':False}
+        for invalid in ({**body,'token':'forged'}, {**body,'site':999999}):
+            status,_=game.post('/factory/api/crew_dismantle',invalid);assert status in (400,403)
+        status,_=game.post('/factory/api/crew_dismantle',body)
+        assert status==400,'Cannot dismantle unmarked warehouse'
+        status,mark=game.post('/factory/api/warehouse_mark',{'token':token,'site':site,'node':1})
+        assert status==200 and mark['event']['applied'],(status,mark)
+        status,scheduled=game.post('/factory/api/crew_dismantle',body)
+        assert status==200 and scheduled['assigned'],(status,scheduled)
+        status,duplicate=game.post('/factory/api/crew_dismantle',body)
+        assert status==400,(status,duplicate)
+        status,blocked=game.post('/factory/api/warehouse_demolish',{'token':token,'site':site,'node':1})
+        assert status==400,(status,blocked)
+        status,listing=game.get('/factory/api/crews?site='+str(site))
+        assert status==200 and listing['dismantling'][0]['active'],(status,listing)
+    finally:game.close()
+    game=Game(save)
+    try:
+        status,listing=game.get('/factory/api/crews?site='+str(site))
+        assert status==200 and listing['dismantling'][0]['active'],(status,listing)
+        start=listing['supply']['depot']
+        done=False
+        for _ in range(120):
+            status,listing=game.get('/factory/api/crews?site='+str(site))
+            if status==200 and listing['dismantling'] and not listing['dismantling'][0]['active']:
+                done=True;break
+            time.sleep(.08)
+        assert done,listing
+        assert not listing['supply']['sources'],listing
+        assert listing['supply']['depot']==start+1,listing
+        status,again=game.post('/factory/api/crew_dismantle',{'token':game.get('/session')[1]['token'],
+                      'site':site,'npc':npc,'target':1,'link':False})
+        assert status==400,(status,again)
+    finally:game.close()
+    game=Game(save)
+    try:
+        status,listing=game.get('/factory/api/crews?site='+str(site))
+        assert status==200 and not listing['supply']['sources'] and listing['supply']['depot']==start+1,(status,listing)
+    finally:game.close()
+    print('ECON-02B2d13 PASS: authenticated job, no double assignment, physical NPC dismantling, restart and depot custody')
