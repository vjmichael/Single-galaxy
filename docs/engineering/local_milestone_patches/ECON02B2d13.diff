+    w.step();crews.advance(7,ship);CHECK(w.world().total_material_kg()==total);
+   }
+   CHECK(!w.world().construction_supplies(site)->carried.count(npc));
+   CHECK(!w.world().storage(site)->extra_bins.count(2));
+   CHECK(w.world().total_material_kg()==total);
+   CHECK(!crews.list_dismantle(7,ship,site)[0].active || [&](){w.step();crews.advance(7,ship);return !crews.list_dismantle(7,ship,site)[0].active;}());
+  }
+  // The persistent resource ledger must reject forged transfer endpoints.
+  // Test a copy after all connections have closed, never mutate the good save.
+  {
+   const auto forged=(folder/"forged.sqlite").string();
+   fs::copy_file(db,forged,fs::copy_options::overwrite_existing);
+   sqlite3* conn=nullptr;CHECK(sqlite3_open(forged.c_str(),&conn)==SQLITE_OK);
+   char* err=nullptr;
+   const auto changed=sqlite3_exec(conn,
+    "UPDATE resource_ledger SET destination_id='invented-cargo' WHERE rowid=(SELECT rowid "
+    "FROM resource_ledger WHERE reason='construction_logistics_t' AND "
+    "source_id LIKE 'conveyor-salvage:%' LIMIT 1)",nullptr,nullptr,&err);
