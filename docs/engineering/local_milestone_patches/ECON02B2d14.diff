+   CHECK(!w.world().construction_supplies(site)->carried.count(npc));
+   CHECK(!crew.list_machine_dismantle(7,ship,site)[0].active);
+   // A real site-local aluminum stock blocks primary recovery. The player
+   // must physically transfer it back to ship inventory, not erase it.
+   okay(action(w,ship,900,Action::Mine,silicate,30));
+   okay(action(w,ship,901,Action::RefineMineral,10,12000));
+   okay(action(w,ship,902,Action::TransferWorkshopFeed,site,1000));
+   CHECK(w.world().workshop(site)->aluminum_kg==1000);
+   bool stocked_block=false;
+   try{crew.queue_machine_dismantle(npc,2,7,ship,site);}
+   catch(const std::invalid_argument&){stocked_block=true;}
+   CHECK(stocked_block);
+   CHECK(action(w,ship,903,Action::CrewDismantleWorkshop,site,2,static_cast<int>(npc)).result!=Outcome::Applied);
+   okay(action(w,ship,904,Action::TransferWorkshopFeed,site,-1000));
+   CHECK(w.world().workshop(site)->aluminum_kg==0);
+   CHECK(w.world().total_material_kg()==total);
+   crew.queue_machine_dismantle(npc,2,7,ship,site);
+   // Cancellation cannot delete a machine or create a refund.
+   CHECK(crew.cancel_machine_dismantle(npc,7,ship,site));
+   for(int i=0;i<35;++i){w.step();crew.advance(7,ship);}
