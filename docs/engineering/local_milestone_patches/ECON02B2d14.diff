+void Crews::queue_machine_dismantle(std::uint64_t npc,int stage,PlayerId owner,EntityId ship,EntityId site){
+ validate_worker(npc,owner,ship,site);
+ if(stage!=1 && stage!=2)throw std::invalid_argument("Unknown machine stage");
+ const auto* workshop=world_.world().workshop(site);
+ const auto* store=world_.world().storage(site);
+ if(!workshop || !store || !store->equipment_positions.count(kWorkshopConveyorNode))
+  throw std::invalid_argument("No physically placed workshop machine");
+ for(const auto& [id,link]:store->links){(void)id;
+  if(link.source==kWorkshopConveyorNode || link.destination==kWorkshopConveyorNode)
+   throw std::invalid_argument("Disconnect workshop production-line conveyors first");
+ }
+ const bool unsafe=stage==1 ?
+   (!workshop->finisher_installed || workshop->finisher_npc_id || workshop->reserved_panels_kg ||
+    workshop->finisher_ticks_remaining || workshop->frames_kg || workshop->reserved_aluminum_kg ||
+    workshop->ticks_remaining) :
+   (workshop->finisher_installed || workshop->operator_npc_id || workshop->reserved_aluminum_kg ||
+    workshop->ticks_remaining || workshop->aluminum_kg || workshop->panels_kg ||
+    workshop->scrap_kg || workshop->frames_kg || workshop->reserved_panels_kg);
+ if(unsafe)throw std::invalid_argument("Unstaff machine and empty its inventories and WIP first");
+ Query occupied(db_->db,"SELECT 1 FROM sg_machine_dismantle_jobs WHERE site=? AND active=1 LIMIT 1");
+ occupied.n(1,site);if(occupied.row())throw std::invalid_argument("Machine removal already scheduled at site");
+ Query construct(db_->db,"SELECT 1 FROM sg_construction_workers WHERE npc_id=? LIMIT 1");
+ construct.n(1,npc);if(construct.row())throw std::invalid_argument("NPC assigned to construction");
+ Query teardown(db_->db,"SELECT 1 FROM sg_dismantle_jobs WHERE npc_id=? AND active=1 LIMIT 1");
+ teardown.n(1,npc);if(teardown.row())throw std::invalid_argument("NPC assigned to another dismantling job");
+ Query hauling(db_->db,"SELECT 1 FROM sg_construction_restock WHERE npc_id=? AND active=1 LIMIT 1");
+ hauling.n(1,npc);if(hauling.row())throw std::invalid_argument("NPC assigned to hauling");
+ const auto* stock=world_.world().construction_supplies(site);
+ if(stock && stock->carried.count(npc))throw std::invalid_argument("NPC must unload physical cargo first");
+ Query save(db_->db,"INSERT OR REPLACE INTO sg_machine_dismantle_jobs"
+    "(npc_id,owner,ship,site,stage,active,cancelling,last_tick,reason)"
+    " VALUES(?,?,?,?,?,1,0,-1,'Assigned to safely isolate workshop machine')");
+ save.n(1,npc);save.n(2,owner);save.n(3,ship);save.n(4,site);save.n(5,stage);save.done();
+}
+bool Crews::cancel_machine_dismantle(std::uint64_t npc,PlayerId owner,EntityId ship,EntityId site){
+ validate_site(owner,ship,site);
+ Query q(db_->db,"UPDATE sg_machine_dismantle_jobs SET cancelling=1,reason='Cancelled; worker returning cargo'"
+    " WHERE npc_id=? AND owner=? AND ship=? AND site=? AND active=1 AND cancelling=0");
+ q.n(1,npc);q.n(2,owner);q.n(3,ship);q.n(4,site);q.done();
+ return sqlite3_changes(db_->db)==1;
+}
+std::vector<MachineDismantleJob> Crews::list_machine_dismantle(PlayerId owner,EntityId ship,EntityId site)const{
+ validate_site(owner,ship,site);
+ Query q(db_->db,"SELECT npc_id,stage,x,y,labor,active,cancelling,reason FROM sg_machine_dismantle_jobs"
+    " WHERE owner=? AND ship=? AND site=? ORDER BY npc_id LIMIT 200");
+ q.n(1,owner);q.n(2,ship);q.n(3,site);
+ std::vector<MachineDismantleJob> out;
+ while(q.row())out.push_back({static_cast<std::uint64_t>(q.v(0)),static_cast<int>(q.v(1)),
+      static_cast<int>(q.v(2)),static_cast<int>(q.v(3)),static_cast<int>(q.v(4)),
+      q.v(5)!=0,q.v(6)!=0,q.t(7)});
+ return out;
+}
