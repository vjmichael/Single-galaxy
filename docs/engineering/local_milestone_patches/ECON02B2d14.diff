+ return w.world().events().back();
+}
+static void okay(const Event& e){
+ if(e.result!=Outcome::Applied)throw std::runtime_error("command "+std::to_string(e.command_id)+" rejected ("+
+                                      std::to_string(static_cast<int>(e.result))+")");
