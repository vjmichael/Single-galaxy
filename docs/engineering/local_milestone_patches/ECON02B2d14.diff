+#!/usr/bin/env python3
+"""d14: authenticated real colony HTTP, staged removal, custody, restarts."""
+import argparse, http.client, json, pathlib, socket, subprocess, sys, tempfile, time
+p=argparse.ArgumentParser()
+for n in ('host','fixture','relay'):p.add_argument('--'+n,required=True)
+a=p.parse_args()
+def port():
+    with socket.socket() as s:s.bind(('127.0.0.1',0));return s.getsockname()[1]
+class Game:
+    def __init__(self,db):
+        self.port=port()
+        self.proc=subprocess.Popen([sys.executable,a.relay,'--colony','--host-exe',a.host,'--save',str(db),
+                  '--port',str(self.port),'--tick-ms','75','--max-ticks','1200'],
+                  stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+        for _ in range(100):
+            if self.proc.poll() is not None:raise AssertionError('Colony game exited early')
+            try:
+                if self.get('/healthz')[0]==200:break
+            except (OSError,TimeoutError):pass
+            time.sleep(.05)
+        else:raise AssertionError('Colony game did not start')
+    def request(self,method,path,doc=None,headers=None):
+        c=http.client.HTTPConnection('127.0.0.1',self.port,timeout=10)
+        body=json.dumps(doc).encode() if doc is not None else None
+        h={'Host':f'127.0.0.1:{self.port}',**(headers or {})}
+        if body is not None:
+            h.setdefault('Content-Type','application/json');h.setdefault('Origin',f'http://127.0.0.1:{self.port}')
+        try:
+            c.request(method,path,body,headers=h)
+            r=c.getresponse();raw=r.read()
+            return r.status,json.loads(raw) if r.getheader('Content-Type')=='application/json' else raw.decode()
+        finally:c.close()
+    def get(self,path):return self.request('GET',path)
+    def post(self,path,doc,headers=None):return self.request('POST',path,doc,headers)
+    def close(self):
+        self.proc.terminate()
+        try:self.proc.communicate(timeout=8)
+        except subprocess.TimeoutExpired:self.proc.kill();self.proc.communicate(timeout=5)
+with tempfile.TemporaryDirectory(prefix='sg-d14-http-') as tmp:
+    db=pathlib.Path(tmp)/'world.sqlite'
+    r=subprocess.run([a.fixture,str(db)],capture_output=True,text=True,timeout=20)
+    assert r.returncode==0,r.stderr
+    game=Game(db)
+    try:
+        status,session=game.get('/session');assert status==200,(status,session)
+        token=session['token']
+        status,sites=game.get('/factory/api/sites');assert status==200 and len(sites['sites'])==1
+        site=sites['sites'][0]
+        url=f'/factory/api/crews?site={site}'
+        status,listing=game.get(url);assert status==200,(status,listing)
+        assert listing['workshopState']['installed'] and listing['workshopState']['finisher'],listing
+        npc=listing['residents'][0]
+        req={'token':token,'site':site,'npc':npc,'stage':1}
+        for fake in ({**req,'token':'forged'}, {**req,'site':999999}):
+            status,_=game.post('/factory/api/crew_machine',fake)
+            assert status in (400,403)
+        status,_=game.post('/factory/api/crew_machine',{**req,'stage':4});assert status==400
+        status,_=game.post('/factory/api/crew_machine',req,{'Origin':'https://evil.invalid'});assert status==403
+        status,_=game.post('/factory/api/crew_machine',{**req,'stage':2});assert status==400
+        status,assigned=game.post('/factory/api/crew_machine',req)
+        assert status==200 and assigned['assigned'],(status,assigned)
+        status,_=game.post('/factory/api/crew_machine',req);assert status==400
+        status,listing=game.get(url)
+        assert status==200 and listing['machineDismantling'][0]['active'],listing
+    finally:game.close()
+    game=Game(db)
+    try:
+        url=f'/factory/api/crews?site={site}'
+        done=False
+        for _ in range(140):
+            status,listing=game.get(url)
+            if status==200 and not listing['workshopState']['finisher'] and not listing['machineDismantling'][0]['active']:
+                done=True;break
+            time.sleep(.08)
+        assert done,listing
+        assert listing['workshopState']['installed'],listing
+        assert listing['supply']['depot']==1,listing
+        token=game.get('/session')[1]['token']
+        req={'token':token,'site':site,'npc':npc,'stage':2}
+        status,assigned=game.post('/factory/api/crew_machine',req)
+        assert status==200 and assigned['assigned'],(status,assigned)
+    finally:game.close()
+    game=Game(db)
+    try:
+        url=f'/factory/api/crews?site={site}'
+        done=False
+        for _ in range(160):
+            status,listing=game.get(url)
+            if status==200 and not listing['workshopState']['installed'] and not listing['machineDismantling'][0]['active']:
+                done=True;break
+            time.sleep(.08)
+        assert done,listing
+        assert listing['supply']['depot']==2,listing
+        status,_=game.post('/factory/api/crew_machine',{'token':game.get('/session')[1]['token'],
+             'site':site,'npc':npc,'stage':2})
+        assert status==400
+    finally:game.close()
+    game=Game(db)
+    try:
+        status,listing=game.get(f'/factory/api/crews?site={site}')
+        assert status==200 and listing['supply']['depot']==2 and not listing['workshopState']['installed']
+    finally:game.close()
+    print('ECON-02B2d14 PASS: real HTTP token/origin/site control, stage-order, durable NPC machine teardown')
