+    w.step();crew.advance(7,ship);CHECK(w.world().total_material_kg()==total);
+   }
+   CHECK(!w.world().construction_supplies(site)->carried.count(npc));
+   CHECK(w.world().total_material_kg()==total);
+  }
+  // Forge a construction-material receipt in an isolated copy.
+  {
