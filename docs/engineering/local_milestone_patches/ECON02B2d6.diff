+"""ECON-02B2d6 offline Chromium DOM test, with mocked API transport.
+The real transport is separately verified by ECON02B2d6ConstructionCrewHostTests.py.
+"""
+from pathlib import Path
+from playwright.sync_api import sync_playwright
+import re
+root=Path(__file__).resolve().parents[1]
+html=(root/'viewer/interactive.html').read_text()
+html=re.sub(r'<script src="[^"]+"></script>', '', html)
+with sync_playwright() as p:
+    browser=p.chromium.launch(headless=True,executable_path='/usr/bin/chromium',args=['--no-sandbox','--disable-dev-shm-usage'])
+    page=browser.new_page(viewport={'width':1150,'height':900})
+    errors=[];page.on('pageerror',lambda error:errors.append(str(error)))
+    page.set_content(html);page.locator('#colonyPanel').evaluate('e=>e.hidden=false')
+    page.add_script_tag(content=r'''
+        window.__crew={plans:[],next:1,residents:[101,102],jobs:[]};
+        window.fetch=async (path,request)=>{
+          const s=window.__crew;let doc=request&&request.body?JSON.parse(request.body):{};
+          let data={ok:true};
+          if(path==='/session')data={token:'TEST',colony_mode:true};
+          else if(path==='/factory/api/sites')data={ok:true,sites:[42]};
+          else if(path.startsWith('/factory/api/structures?site='))data={ok:true,structures:[],plans:s.plans};
+          else if(path.startsWith('/factory/api/crews?site='))data={ok:true,residents:s.residents,jobs:s.jobs};
+          else if(path==='/factory/api/structure_register'){
+            const plan={id:s.next++,site:42,completed:0,total:1,modulesRemaining:1,cancelled:false,conflicting:false,finished:false,reason:''};
+            s.plans.push(plan);data={ok:true,plan};
+          }else if(path==='/factory/api/crew_assign'){
+            let job=s.jobs.find(j=>j.plan===doc.plan);
+            if(!job){job={plan:doc.plan,completed:0,total:1,labor:0,required:2,active:true,reason:'Ready',workers:[]};s.jobs.push(job);}
+            job.workers.push({npc:doc.npc,x:0,y:0});data={ok:true,assigned:true};
+          }else if(path==='/factory/api/crew_unassign'){
+            s.jobs.forEach(j=>j.workers=j.workers.filter(w=>w.npc!==doc.npc));data={ok:true,changed:true};
+          }else if(path==='/factory/api/crew_active'){
+            s.jobs.find(j=>j.plan===doc.plan).active=doc.active;data={ok:true,changed:true};
+          }else throw Error('Unexpected route '+path);
+          return {ok:true,json:async()=>data};
+        };
+    ''')
+    page.add_script_tag(content=(root/'viewer/structures.js').read_text())
+    page.wait_for_function("document.querySelector('#structureSite').value==='42'")
+    assert page.locator('#colonyStructures').evaluate("n=>!!n.closest('#colonyPanel')")
+    page.locator('#structureAuthorize').click();page.wait_for_function('window.__crew.plans.length===1')
+    page.locator('#crewAssign').click()
+    page.wait_for_function('window.__crew.jobs.length===1 && window.__crew.jobs[0].workers.length===1')
+    page.wait_for_function("document.querySelector('#crewStatus').textContent.includes('#101')")
+    assert '#101' in page.locator('#crewStatus').inner_text()
+    page.locator('#crewPause').click();page.wait_for_function('window.__crew.jobs[0].active===false')
+    page.locator('#crewResume').click();page.wait_for_function('window.__crew.jobs[0].active===true')
+    page.locator('#crewUnassign').click();page.wait_for_function('window.__crew.jobs[0].workers.length===0')
+    assert not errors,errors
+    print('ECON-02B2d6 PASS: colony UI crew assignment, pause, resume, removal and live status')
+    browser.close()
