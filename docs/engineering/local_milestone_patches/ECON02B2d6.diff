+#!/usr/bin/env python3
+"""Real localhost -> colony C++ -> NPC crew scheduler -> SQLite -> restart.
+Transport never supplies a trusted worker identity or site ownership.
+"""
+import argparse, http.client, json, pathlib, socket, subprocess, sys, tempfile, time
+p=argparse.ArgumentParser()
+for n in ('host','fixture','relay'):p.add_argument('--'+n,required=True)
+a=p.parse_args()
+def random_port():
+    with socket.socket() as s:s.bind(('127.0.0.1',0));return s.getsockname()[1]
+class Game:
+    def __init__(self,save):
+        self.port=random_port()
+        self.child=subprocess.Popen([sys.executable,a.relay,'--colony','--host-exe',a.host,'--save',str(save),
+            '--port',str(self.port),'--tick-ms','100','--max-ticks','1200'],stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+        for i in range(100):
+            if self.child.poll() is not None:raise AssertionError('Relay stopped early')
+            try:
+                if self.get('/healthz')[0]==200:break
+            except (OSError,TimeoutError):pass
+            time.sleep(.05)
+        else:raise AssertionError('No health response')
+    def request(self,method,path,data=None,headers=None):
+        c=http.client.HTTPConnection('127.0.0.1',self.port,timeout=10)
+        body=json.dumps(data,separators=(',',':')).encode() if data is not None else None
+        h={'Host':'127.0.0.1:'+str(self.port),**(headers or {})}
+        if body is not None:
+            h.setdefault('Content-Type','application/json');h.setdefault('Origin','http://127.0.0.1:'+str(self.port))
+        try:
+            c.request(method,path,body,headers=h)
+            response=c.getresponse();raw=response.read()
+            return response.status,json.loads(raw) if response.getheader('Content-Type')=='application/json' else raw.decode()
+        finally:c.close()
+    def get(self,path):return self.request('GET',path)
+    def post(self,path,data,headers=None):return self.request('POST',path,data,headers)
+    def close(self):
+        self.child.terminate()
+        try:self.child.communicate(timeout=8)
+        except subprocess.TimeoutExpired:self.child.kill();self.child.communicate(timeout=5)
+with tempfile.TemporaryDirectory(prefix='sg-npc-crew-live-') as temp:
+    save=pathlib.Path(temp)/'w.sqlite'
+    r=subprocess.run([a.fixture,str(save)],capture_output=True,text=True,timeout=15)
+    assert r.returncode==0,r.stderr
+    game=Game(save)
+    try:
+        status,session=game.get('/session');assert status==200
+        token=session['token'];status,sites=game.get('/factory/api/sites');assert status==200 and len(sites['sites'])==1,sites
+        site=sites['sites'][0]
+        status,crew=game.get('/factory/api/crews?site='+str(site))
+        assert status==200 and len(crew['residents'])==2 and crew['jobs']==[],(status,crew)
+        status,denied=game.post('/factory/api/crew_assign',{'site':site,'token':'forged','plan':1,'npc':crew['residents'][0]})
+        assert status==403,(status,denied)
+        status,denied=game.post('/factory/api/crew_assign',{'site':site,'token':token,'plan':1,'npc':crew['residents'][0]},
+                                {'Origin':'https://evil.example'})
+        assert status==403,(status,denied)
+        status,denied=game.post('/factory/api/crew_assign',{'site':999999,'token':token,'plan':1,'npc':crew['residents'][0]})
+        assert status==400,(status,denied)
+        status,new=game.post('/factory/api/structure_register',{'token':token,'site':site,
+            'layout':'sg-colony-structure-plan-v1\n1,1,0\n2,0,0\n4,1,0\n'})
+        assert status==200,(status,new)
+        plan=new['plan']['id']
+        for npc in crew['residents']:
+            status,assigned=game.post('/factory/api/crew_assign',{'token':token,'site':site,'plan':plan,'npc':npc})
+            assert status==200,(status,assigned)
+        deadline=time.monotonic()+12
+        while time.monotonic()<deadline:
+            status,current=game.get('/factory/api/structures?site='+str(site))
+            assert status==200,(status,current)
+            if current['plans'][0]['finished']:break
+            time.sleep(.15)
+        else:raise AssertionError('NPC plan did not complete')
+        assert len(current['structures'])==3,current
+        status,info=game.get('/factory/api/crews?site='+str(site))
+        assert status==200 and len(info['jobs'])==1 and len(info['jobs'][0]['workers'])==2,(status,info)
+        status,more=game.post('/factory/api/structure_register',{'token':token,'site':site,
+             'layout':'sg-colony-structure-plan-v1\n1,5,0\n'})
+        assert status==200,(status,more)
+        next_plan=more['plan']['id']
+        # The original workers must be explicitly reassigned, never cloned.
+        status,bad=game.post('/factory/api/crew_assign',{'token':token,'site':site,'plan':next_plan,'npc':crew['residents'][0]})
+        assert status==400,(status,bad)
+        status,removed=game.post('/factory/api/crew_unassign',{'token':token,'site':site,'npc':crew['residents'][0]})
+        assert status==200 and removed['changed'],(status,removed)
+        status,assigned=game.post('/factory/api/crew_assign',{'token':token,'site':site,'plan':next_plan,'npc':crew['residents'][0]})
+        assert status==200,(status,assigned)
+        status,paused=game.post('/factory/api/crew_active',{'token':token,'site':site,'plan':next_plan,'active':False})
+        assert status==200 and paused['changed'],(status,paused)
+        time.sleep(.55)
+        status,current=game.get('/factory/api/structures?site='+str(site))
+        assert next(x for x in current['plans'] if x['id']==next_plan)['completed']==0,current
+    finally:game.close()
+    game=Game(save)
+    try:
+        status,info=game.get('/factory/api/crews?site='+str(site))
+        assert status==200 and len(info['jobs'])==2 and info['jobs'][1]['active']==False,(status,info)
+        status,current=game.get('/factory/api/structures?site='+str(site))
+        assert status==200 and len(current['structures'])==3 and current['plans'][0]['finished'],current
+        status,token_new=game.get('/session');token=token_new['token']
+        status,resumed=game.post('/factory/api/crew_active',{'token':token,'site':site,'plan':next_plan,'active':True})
+        assert status==200 and resumed['changed'],(status,resumed)
+        deadline=time.monotonic()+12
+        while time.monotonic()<deadline:
+            status,current=game.get('/factory/api/structures?site='+str(site))
+            if next(x for x in current['plans'] if x['id']==next_plan)['finished']:break
+            time.sleep(.15)
+        else:raise AssertionError('Restarted NPC crew did not finish')
+        assert len(current['structures'])==4,current
+    finally:game.close()
+    print('ECON-02B2d6 PASS: real HTTP -> named resident crew -> path/work/material receipt -> restart')
