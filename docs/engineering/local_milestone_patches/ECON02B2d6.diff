+#pragma once
+// ECON-02B2d6: existing, named resident NPCs take durable site-local jobs.
+// This host-side scheduler never writes a Simulation snapshot or fabricates a
+// resource. The existing authorized structural plan command is the only way
+// a fixture is installed and its modules consumed.
+#include "galaxy/ColonyStructurePlans.hpp"
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+namespace galaxy::construction {
+struct CrewWorker {std::uint64_t npc=0;int x=0,y=0;};
+struct CrewJob {
+    std::int64_t plan=0;EntityId site=0;
+    std::size_t completed=0,total=0;
+    std::int64_t labor=0,required=0;
+    bool active=false;
+    std::string reason;
+    std::vector<CrewWorker> workers;
+};
+class Crews {
+public:
+    Crews(const std::string& database,PersistentWorld& world,Plans& structures);
+    ~Crews();
+    Crews(const Crews&)=delete;Crews& operator=(const Crews&)=delete;
+    void assign(std::int64_t plan,std::uint64_t npc,PlayerId owner,EntityId ship,EntityId site);
+    bool unassign(std::uint64_t npc,PlayerId owner,EntityId ship,EntityId site);
+    bool set_active(std::int64_t plan,bool active,PlayerId owner,EntityId ship,EntityId site);
+    std::vector<CrewJob> list(PlayerId owner,EntityId ship,EntityId site)const;
+    // Called on the one authoritative colony simulation thread, at most once
+    // per world tick. May commit a structural step, advancing world one tick.
+    void advance(PlayerId owner,EntityId ship);
+private:
+    class Db;std::unique_ptr<Db> db_;
+    PersistentWorld& world_;Plans& structures_;
+    void validate_site(PlayerId owner,EntityId ship,EntityId site)const;
+    void validate_worker(std::uint64_t npc,PlayerId owner,EntityId ship,EntityId site)const;
+};
+} // namespace galaxy::construction
