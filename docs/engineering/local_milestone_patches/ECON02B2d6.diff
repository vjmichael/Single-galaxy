@@ -0,0 +1,217 @@
+#include "galaxy/NpcConstructionCrews.hpp"
+#include <sqlite3.h>
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdlib>
+#include <limits>
+#include <map>
+#include <queue>
+#include <stdexcept>
+#include <string>
+#include <tuple>
+namespace galaxy::construction {
+namespace {
+void sql(sqlite3* db,const char* text){char* err=nullptr;if(sqlite3_exec(db,text,nullptr,nullptr,&err)!=SQLITE_OK){std::string msg=err?err:"SQLite failure";sqlite3_free(err);throw std::runtime_error(msg);}}
+class Query {
+public:
+ Query(sqlite3* db,const char* text):db_(db){if(sqlite3_prepare_v2(db,text,-1,&s_,nullptr)!=SQLITE_OK)throw std::runtime_error(sqlite3_errmsg(db));}
+ ~Query(){sqlite3_finalize(s_);}void n(int i,std::int64_t v){if(sqlite3_bind_int64(s_,i,v)!=SQLITE_OK)throw std::runtime_error("bind failed");}
+ void str(int i,const std::string& v){if(sqlite3_bind_text(s_,i,v.c_str(),static_cast<int>(v.size()),SQLITE_TRANSIENT)!=SQLITE_OK)throw std::runtime_error("text bind failed");}
+ bool row(){const int r=sqlite3_step(s_);if(r==SQLITE_ROW)return true;if(r==SQLITE_DONE)return false;throw std::runtime_error(sqlite3_errmsg(db_));}
+ void done(){if(row())throw std::runtime_error("unexpected SQL row");}
+ std::int64_t v(int i)const{return sqlite3_column_int64(s_,i);}std::string t(int i)const{const auto* p=sqlite3_column_text(s_,i);return p?reinterpret_cast<const char*>(p):"";}
+private:sqlite3* db_;sqlite3_stmt* s_=nullptr;
+};
+using Pos=std::pair<int,int>;
+// An 8K-node bounded search is a navigation CPU budget, not a world/factory
+// area boundary. For distant destinations use a one-cell greedy step first.
+bool next_cell(const Simulation& sim,EntityId site,Pos current,Pos dest,Pos& next){
+ if(current==dest)return false;
+ const auto dist=[&](Pos p){return std::llabs(static_cast<long long>(p.first)-dest.first)+std::llabs(static_cast<long long>(p.second)-dest.second);};
+ const std::array<Pos,4> directions{{{1,0},{0,1},{-1,0},{0,-1}}};
+ std::vector<Pos> choices;
+ for(const auto& d:directions){
+  const Pos other{current.first+d.first,current.second+d.second};
+  if(std::abs(static_cast<long long>(other.first))>1000000||std::abs(static_cast<long long>(other.second))>1000000)continue;
+  if(sim.structure_edge_passable(site,current.first,current.second,other.first,other.second))choices.push_back(other);
+ }
+ std::stable_sort(choices.begin(),choices.end(),[&](Pos a,Pos b){return dist(a)<dist(b);});
+ if(choices.empty())return false;
+ if(dist(choices.front())<dist(current)){next=choices.front();return true;}
+ // Local obstacle avoidance: BFS to the nearest strictly closer reachable cell.
+ std::queue<Pos> q;std::map<Pos,Pos> parent;q.push(current);parent[current]=current;
+ for(std::size_t searched=0;!q.empty()&&searched<2048;++searched){
+  const auto pos=q.front();q.pop();
+  for(const auto& d:directions){
+   const Pos at{pos.first+d.first,pos.second+d.second};
+   if(std::abs(static_cast<long long>(at.first))>1000000||std::abs(static_cast<long long>(at.second))>1000000 || parent.count(at) ||
+      std::abs(static_cast<long long>(at.first)-current.first)>32 || std::abs(static_cast<long long>(at.second)-current.second)>32 ||
+      !sim.structure_edge_passable(site,pos.first,pos.second,at.first,at.second))continue;
+   parent.emplace(at,pos);
+   if(dist(at)<dist(current)){
+    auto p=at;while(parent.at(p)!=current)p=parent.at(p);
+    next=p;return true;
+   }
+   q.push(at);
+  }
+ }
+ return false;
+}
+std::int64_t cost(const Step& s){return s.kind==FixtureKind::Floor?1:2;}
+std::int64_t work(const Step& s){return s.kind==FixtureKind::Floor?2:4;}
+}
+class Crews::Db {
+public:
+ explicit Db(const std::string& path){
+  if(sqlite3_open_v2(path.c_str(),&db,SQLITE_OPEN_READWRITE,nullptr)!=SQLITE_OK){auto m=std::string(db?sqlite3_errmsg(db):"SQLite open failed");if(db)sqlite3_close(db);throw std::runtime_error(m);}
+  sqlite3_busy_timeout(db,5000);
+  sql(db,"PRAGMA foreign_keys=ON");
+  sql(db,"CREATE TABLE IF NOT EXISTS sg_construction_jobs("
+         "plan_id INTEGER PRIMARY KEY REFERENCES sg_structure_plans(id),"
+         "owner INTEGER NOT NULL,ship INTEGER NOT NULL,site INTEGER NOT NULL,"
+         "active INTEGER NOT NULL DEFAULT 1 CHECK(active IN (0,1)),"
+         "completed INTEGER NOT NULL DEFAULT 0 CHECK(completed>=0),"
+         "labor INTEGER NOT NULL DEFAULT 0 CHECK(labor>=0),"
+         "last_tick INTEGER NOT NULL DEFAULT -1,reason TEXT NOT NULL DEFAULT '')");
+  sql(db,"CREATE TABLE IF NOT EXISTS sg_construction_workers("
+         "npc_id INTEGER PRIMARY KEY,plan_id INTEGER NOT NULL REFERENCES sg_construction_jobs(plan_id),"
+         "x INTEGER NOT NULL DEFAULT 0,y INTEGER NOT NULL DEFAULT 0,"
+         "CHECK(x BETWEEN -1000000 AND 1000000),CHECK(y BETWEEN -1000000 AND 1000000))");
+ }
+ ~Db(){sqlite3_close(db);}sqlite3* db=nullptr;
+};
+Crews::Crews(const std::string& file,PersistentWorld& world,Plans& structures)
+ :db_(std::make_unique<Db>(file)),world_(world),structures_(structures){}
+Crews::~Crews()=default;
+void Crews::validate_site(PlayerId owner,EntityId ship,EntityId site)const{
+ const auto& w=world_.world();const auto* actor=w.find(ship);const auto* place=w.find(site);
+ const auto outpost=w.built_outposts().find(site);
+ if(!owner||!ship||!site||!actor||!place||actor->owner_id!=owner||place->owner_id!=owner||
+    !w.colony_ship(ship)||outpost==w.built_outposts().end()||outpost->second.source_colony_ship!=ship)
+  throw std::invalid_argument("Construction crew site not owned by this colony");
+}
+void Crews::validate_worker(std::uint64_t npc,PlayerId owner,EntityId ship,EntityId site)const{
+ validate_site(owner,ship,site);
+ const auto& w=world_.world();const auto it=w.npc_records().find(npc);
+ if(it==w.npc_records().end()||it->second.home_ship!=ship||it->second.location!=site||it->second.role!=NpcRole::Habitat)
+  throw std::invalid_argument("NPC must be an existing on-site habitat resident");
+ const auto* h=w.habitat(site);if(!h||h->residents<1)throw std::invalid_argument("No staffed local habitat");
+ // Aggregate roles already reserve residents; never count those as construction
+ // labor. Individual workshop operators have named reservations too.
+ std::int64_t reserved=w.assigned_policy_inspectors(site);
+ if(const auto* u=w.utility(site))reserved+=u->technicians;
+ if(const auto* c=w.clinic(site))reserved+=c->medics;
+ if(auto itc=w.communities().find(site);itc!=w.communities().end())reserved+=itc->second.attendants;
+ std::vector<std::uint64_t> eligible;
+ const auto* workshop=w.workshop(site);
+ for(const auto& [id,n]:w.npc_records())if(n.home_ship==ship&&n.location==site&&n.role==NpcRole::Habitat &&
+   (!workshop||(id!=workshop->operator_npc_id && id!=workshop->finisher_npc_id)))eligible.push_back(id);
+ if(reserved<0 || reserved>static_cast<std::int64_t>(eligible.size()))throw std::invalid_argument("No unassigned residents");
+ if(std::find(eligible.begin()+reserved,eligible.end(),npc)==eligible.end())
+  throw std::invalid_argument("NPC already reserved for another colony job");
+}
+void Crews::assign(std::int64_t plan,std::uint64_t npc,PlayerId owner,EntityId ship,EntityId site){
+ const auto state=structures_.status(plan,owner,ship,site);
+ if(state.cancelled||state.conflicting||state.finished())throw std::invalid_argument("Plan not available for crew work");
+ validate_worker(npc,owner,ship,site);
+ Query count(db_->db,"SELECT count(*) FROM sg_construction_workers WHERE plan_id=?");count.n(1,plan);
+ if(!count.row()||count.v(0)>=8)throw std::invalid_argument("Crew already has eight workers");
+ Query job(db_->db,"INSERT OR IGNORE INTO sg_construction_jobs(plan_id,owner,ship,site,completed) VALUES(?,?,?,?,?)");
+ job.n(1,plan);job.n(2,owner);job.n(3,ship);job.n(4,site);job.n(5,static_cast<std::int64_t>(state.completed));job.done();
+ Query check(db_->db,"SELECT owner,ship,site FROM sg_construction_jobs WHERE plan_id=?");check.n(1,plan);
+ if(!check.row()||check.v(0)!=static_cast<std::int64_t>(owner)||check.v(1)!=static_cast<std::int64_t>(ship)||check.v(2)!=static_cast<std::int64_t>(site))
+  throw std::invalid_argument("Construction job owned by another session");
+ Query insert(db_->db,"INSERT INTO sg_construction_workers(npc_id,plan_id) VALUES(?,?)");
+ insert.n(1,static_cast<std::int64_t>(npc));insert.n(2,plan);insert.done();
+}
+bool Crews::unassign(std::uint64_t npc,PlayerId owner,EntityId ship,EntityId site){
+ validate_site(owner,ship,site);
+ Query q(db_->db,"DELETE FROM sg_construction_workers WHERE npc_id=? AND plan_id IN (SELECT plan_id FROM sg_construction_jobs WHERE owner=? AND ship=? AND site=?)");
+ q.n(1,static_cast<std::int64_t>(npc));q.n(2,owner);q.n(3,ship);q.n(4,site);q.done();return sqlite3_changes(db_->db)==1;
+}
+bool Crews::set_active(std::int64_t plan,bool active,PlayerId owner,EntityId ship,EntityId site){
+ (void)structures_.status(plan,owner,ship,site);
+ Query q(db_->db,"UPDATE sg_construction_jobs SET active=? WHERE plan_id=? AND owner=? AND ship=? AND site=?");
+ q.n(1,active?1:0);q.n(2,plan);q.n(3,owner);q.n(4,ship);q.n(5,site);q.done();return sqlite3_changes(db_->db)==1;
+}
+std::vector<CrewJob> Crews::list(PlayerId owner,EntityId ship,EntityId site)const{
+ validate_site(owner,ship,site);std::vector<CrewJob> result;
+ Query q(db_->db,"SELECT plan_id,active,completed,labor,reason FROM sg_construction_jobs WHERE owner=? AND ship=? AND site=? ORDER BY plan_id LIMIT 200");
+ q.n(1,owner);q.n(2,ship);q.n(3,site);
+ while(q.row()){
+  CrewJob job;job.plan=q.v(0);job.site=site;job.active=q.v(1)!=0;job.completed=q.v(2);job.labor=q.v(3);job.reason=q.t(4);
+  const auto s=structures_.status(job.plan,owner,ship,site);job.completed=s.completed;job.total=s.total;
+  if(!s.finished()&&!s.cancelled&&!s.conflicting)job.required=work(Plans::parse([&](){
+   Query text(db_->db,"SELECT steps FROM sg_structure_plans WHERE id=?");text.n(1,job.plan);if(!text.row())throw std::runtime_error("Missing plan");return text.t(0);
+  }()).at(s.completed));
+  Query workers(db_->db,"SELECT npc_id,x,y FROM sg_construction_workers WHERE plan_id=? ORDER BY npc_id");workers.n(1,job.plan);
+  while(workers.row())job.workers.push_back({static_cast<std::uint64_t>(workers.v(0)),static_cast<int>(workers.v(1)),static_cast<int>(workers.v(2))});
+  result.push_back(std::move(job));
+ }
+ return result;
+}
+void Crews::advance(PlayerId owner,EntityId ship){
+ const auto tick=world_.world().tick();
+ Query jobs(db_->db,"SELECT plan_id,site,completed,labor,last_tick,active FROM sg_construction_jobs WHERE owner=? AND ship=? ORDER BY plan_id LIMIT 200");
+ jobs.n(1,owner);jobs.n(2,ship);
+ struct J{std::int64_t id;EntityId site;std::int64_t completed,labor,last_tick;bool active;};std::vector<J> pending;
+ while(jobs.row())pending.push_back({jobs.v(0),static_cast<EntityId>(jobs.v(1)),jobs.v(2),jobs.v(3),jobs.v(4),jobs.v(5)!=0});
+ for(const auto& j:pending){
+  if(!j.active||(j.last_tick>=0&&static_cast<std::uint64_t>(j.last_tick)>=tick))continue;
+  std::string reason;std::int64_t labor=j.labor;
+  try{
+   const auto status=structures_.status(j.id,owner,ship,j.site);
+   if(status.cancelled||status.conflicting||status.finished()){
+    Query stop(db_->db,"UPDATE sg_construction_jobs SET active=0,completed=?,labor=0,reason=?,last_tick=? WHERE plan_id=?");
+    stop.n(1,static_cast<std::int64_t>(status.completed));stop.str(2,status.cancelled?"Plan cancelled":status.conflicting?status.reason:"Complete");stop.n(3,tick);stop.n(4,j.id);stop.done();continue;
+   }
+   // Crash recovery: plan receipts are canonical; stale work is never reused
+   // when a structure finished before the worker-progress update committed.
+   if(status.completed!=static_cast<std::size_t>(j.completed))labor=0;
+   Query text(db_->db,"SELECT steps FROM sg_structure_plans WHERE id=?");text.n(1,j.id);
+   if(!text.row())throw std::runtime_error("Missing construction blueprint");
+   const auto task=Plans::parse(text.t(0)).at(status.completed);
+   const Pos goal{task.x,task.y};int ready=0;
+   Query workers(db_->db,"SELECT npc_id,x,y FROM sg_construction_workers WHERE plan_id=? ORDER BY npc_id");workers.n(1,j.id);
+   std::vector<CrewWorker> roster;
+   while(workers.row())roster.push_back({static_cast<std::uint64_t>(workers.v(0)),static_cast<int>(workers.v(1)),static_cast<int>(workers.v(2))});
+   if(roster.empty())reason="No assigned residents";
+   for(auto& n:roster){
+    try{validate_worker(n.npc,owner,ship,j.site);}catch(const std::exception&){reason="Crew member no longer available";continue;}
+    const Pos here{n.x,n.y};
+    if(here!=goal){Pos next{};if(next_cell(world_.world(),j.site,here,goal,next)){
+      Query move(db_->db,"UPDATE sg_construction_workers SET x=?,y=? WHERE npc_id=? AND plan_id=?");
+      move.n(1,next.first);move.n(2,next.second);move.n(3,static_cast<std::int64_t>(n.npc));move.n(4,j.id);move.done();
+      n.x=next.first;n.y=next.second;
+     }else reason="No passable route to construction site";
+    }
+    if(Pos{n.x,n.y}==goal)++ready;
+   }
+   const auto* c=world_.world().colony_ship(ship);
+   if(!c||c->modules<cost(task))reason="Insufficient construction modules";
+   if(ready==0 && reason.empty())reason="Crew travelling";
+   if(ready>0 && reason.empty()){
+    labor=std::min<std::int64_t>(work(task),labor+ready);
+    if(labor>=work(task)){
+     // Advance persisted tick BEFORE the operation. On restart, a successful
+     // world receipt is detected by status(), even if job bookkeeping was lost.
+     Query checkpoint(db_->db,"UPDATE sg_construction_jobs SET completed=?,labor=?,last_tick=?,reason='Committing structure' WHERE plan_id=?");
+     checkpoint.n(1,static_cast<std::int64_t>(status.completed));checkpoint.n(2,labor);checkpoint.n(3,tick);checkpoint.n(4,j.id);checkpoint.done();
+     const auto event=structures_.step(j.id,owner,ship,j.site);
+     if(event.result==Outcome::Applied){labor=0;reason="Built structure";}
+     else {labor=0;reason="Build command rejected: "+std::to_string(static_cast<int>(event.result));}
+    }
+   }
+   Query save(db_->db,"UPDATE sg_construction_jobs SET completed=?,labor=?,reason=?,last_tick=? WHERE plan_id=?");
+   save.n(1,static_cast<std::int64_t>(structures_.status(j.id,owner,ship,j.site).completed));save.n(2,labor);
+   save.str(3,reason);save.n(4,tick);save.n(5,j.id);save.done();
+  }catch(const std::exception& e){
+   Query save(db_->db,"UPDATE sg_construction_jobs SET reason=?,last_tick=? WHERE plan_id=?");
+   save.str(1,std::string(e.what()).substr(0,180));save.n(2,tick);save.n(3,j.id);save.done();
+  }
+  // A step may have advanced the world; one structure per logical tick max.
+  if(world_.world().tick()!=tick)break;
+ }
+}
+} // namespace galaxy::construction
