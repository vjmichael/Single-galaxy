+  rejected=false;try{(void)periods_due(0,1,0);}catch(const std::invalid_argument&){rejected=true;}
+  CHECK(rejected);
+  ColonyLifeSupport supply;
+  supply.food_kg=5;supply.water_kg=2;supply.oxygen_kg=9;
+  const auto initial=tracked_mass(supply);
+  const auto r=runway(supply,3,19);
+  CHECK(r.next_due_tick==20 && r.food_periods==1 && r.water_periods==0 &&
+        r.oxygen_periods==3 && r.first_unserved_tick==20);
+  const auto used=consume(supply,3,1);
+  CHECK(used.food_kg==3 && used.water_kg==2 && used.oxygen_kg==3);
+  CHECK(!used.fully_supplied() && used.food_supplied && !used.water_supplied && used.oxygen_supplied);
+  CHECK(supply.food_kg==2 && supply.water_kg==0 && supply.oxygen_kg==6);
+  CHECK(supply.organic_waste_kg==3 && supply.wastewater_kg==2 && supply.co2_kg==3);
+  CHECK(tracked_mass(supply)==initial);
+  const auto snapshot=supply;
+  CHECK(consume(supply,3000000000000ULL,0).fully_supplied());
+  CHECK(tracked_mass(supply)==tracked_mass(snapshot));
+  // Time and population both scale through multiplication, not person-ticking.
+  PopulationCohorts cohorts;
+  cohorts.add({11,1,2,2},1300000000000ULL);
+  CHECK(cohorts.cohort_count()==1 && cohorts.population()==1300000000000ULL);
+  ColonyLifeSupport huge;
+  huge.food_kg=6000000000000LL;huge.water_kg=6000000000000LL;
+  huge.oxygen_kg=6000000000000LL;
+  const auto massive_start=tracked_mass(huge);
+  const auto missed=periods_due(20,100); // four complete windows
+  const auto result=consume(huge,cohorts.population(),missed);
+  CHECK(missed==4 && result.fully_supplied());
+  CHECK(result.food_kg==5200000000000LL && result.water_kg==5200000000000LL);
+  CHECK(huge.food_kg==800000000000LL && huge.organic_waste_kg==5200000000000LL);
+  CHECK(tracked_mass(huge)==massive_start);
+  // Arithmetic overload is treated as a shortage without overflow or minting.
+  const auto exhausted=consume(huge,cohorts.population(),std::numeric_limits<std::uint64_t>::max());
+  CHECK(!exhausted.fully_supplied() && huge.food_kg==0);
+  CHECK(tracked_mass(huge)==massive_start);
+  // Overflow must be checked *before* deducting any resource.
+  ColonyLifeSupport at_limit;at_limit.food_kg=3;
+  at_limit.organic_waste_kg=std::numeric_limits<std::int64_t>::max();
+  rejected=false;try{(void)consume(at_limit,2);}catch(const std::overflow_error&){rejected=true;}
+  CHECK(rejected && at_limit.food_kg==3 &&
+        at_limit.organic_waste_kg==std::numeric_limits<std::int64_t>::max());
+  // Existing 20-tick live-world timing and saved ticks remain authoritative.
+  Simulation s(707);const auto ship=s.add_colony_ship(7,{0,0},60,24);
+  s.provision_colony_genesis(ship,1000,3000,1000,1000,1000);
+  const auto mass=s.total_material_kg();
+  s.steps(39);
+  CHECK(s.life_support(ship)->cycles==1);
+  CHECK(next_due(s.tick())==40);
+  const auto state=s.canonical_state();
+  auto resumed=Simulation::from_snapshot(state);
+  CHECK(resumed.canonical_state()==state);
+  s.step();resumed.step();
+  CHECK(s.canonical_state()==resumed.canonical_state());
+  CHECK(s.life_support(ship)->cycles==2);
+  CHECK(s.total_material_kg()==mass);
+  {
+   Simulation fresh(707);
+   const auto fresh_ship=fresh.add_colony_ship(7,{0,0},60,24);
+   CHECK(fresh_ship==ship);
+   fresh.provision_colony_genesis(fresh_ship,1000,3000,1000,1000,1000);
+   PersistentWorld persisted((dir/"world.sqlite").string(),std::move(fresh));
+   persisted.steps(60);
+   CHECK(persisted.world().life_support(ship)->cycles==3);
+   CHECK(persisted.world().total_material_kg()==mass);
+  }
+  {
+   PersistentWorld reopened((dir/"world.sqlite").string(),Simulation(777));
+   CHECK(reopened.world().life_support(ship)->cycles==3);
+   CHECK(reopened.world().tick()==60);
+   CHECK(next_due(reopened.world().tick())==80);
+   CHECK(reopened.world().total_material_kg()==mass);
+  }
+  fs::remove_all(dir);
+  std::cout<<"PASS ECON03c1 deterministic cohort cooldown, 1.3T population, long catch-up, "
+           <<"shortages, conservation, source compartments, save/restart\n";
+  return 0;
+ }catch(const std::exception& e){fs::remove_all(dir);std::cerr<<e.what()<<'\n';return 1;}
+}