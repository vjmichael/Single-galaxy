+        }
+        if(req.method!="POST" || req.uri.find('?')!=std::string::npos ||
+           (endpoint!="api/register"&&endpoint!="api/status"&&endpoint!="api/step"&&endpoint!="api/cancel"))
+            return json(404,error_json("Unknown route"));
+        if(header(req.headers,"origin")!=origin || header(req.headers,"x-sg-session")!=secret ||
+           (!header(req.headers,"sec-fetch-site").empty()&&header(req.headers,"sec-fetch-site")!="same-origin"))
+            return json(403,error_json("Session authorization denied"));
+        const std::string type=lower(header(req.headers,"content-type"));
+        if(type!="application/json"&&type!="application/json; charset=utf-8")return json(415,error_json("JSON required"));
+        if(req.headers.find("content-length")==req.headers.end())return json(400,error_json("Content-Length required"));
+        const std::string op=endpoint.substr(4);
+        if(op=="register"){
+            const auto input=JsonReader(req.body).single_field(true);
+            if(input.first!="layout"||input.second.size()>1048576)throw std::invalid_argument("Invalid blueprint");
+            const std::string response=game.handle("REGISTER|"+b64encode(input.second));
+            return json(response.find("\"ok\":true")==0||response.find("{\"ok\":true")==0?200:400,response);
+        }
+        const auto input=JsonReader(req.body).single_field(false);
+        if(input.first!="id")throw std::invalid_argument("Invalid plan ID");
+        const auto n=number(input.second);
+        if(n==0||n>static_cast<std::uint64_t>(std::numeric_limits<std::int64_t>::max())||
+           input.second.size()>1&&input.second[0]=='0')throw std::invalid_argument("Invalid plan ID");
+        const std::string command=op=="step"?"STEP":op=="status"?"STATUS":"CANCEL";
+        const std::string response=game.handle(command+"|"+std::to_string(n));
+        return json(response.find("{\"ok\":true")==0?200:400,response);
+    }catch(const std::length_error& e){json(413,error_json(e.what()));}
+    catch(const std::exception& e){json(400,error_json(e.what()));}
+}
+void launch_browser(const std::string& url){
+#ifdef _WIN32
+    ShellExecuteA(nullptr,"open",url.c_str(),nullptr,nullptr,SW_SHOWNORMAL);
+#else
+    const pid_t pid=fork();
+    if(pid==0){
+        const auto child=fork();
+        if(child!=0)_exit(child<0?127:0);
+        const auto devnull=open("/dev/null",O_WRONLY);
+        if(devnull>=0){dup2(devnull,1);dup2(devnull,2);close(devnull);}
+        execlp("xdg-open","xdg-open",url.c_str(),static_cast<char*>(nullptr));_exit(127);
+    }
+    if(pid>0){int result=0;waitpid(pid,&result,0);}
+#endif
+}
+}
+int main(int argc,char** argv){
+    try{
+        std::string db,assets,site;bool open_browser=true;
+        for(int i=1;i<argc;i++){
+            const std::string a=argv[i];
+            if(a=="--no-browser")open_browser=false;
+            else if((a=="--db"||a=="--site"||a=="--assets")&&i+1<argc){
+                const std::string v=argv[++i];if(a=="--db")db=v;else if(a=="--site")site=v;else assets=v;
+            }else throw std::invalid_argument("Usage: galaxy_factory_local_host --db EXISTING.sqlite [--site N] [--assets dir] [--no-browser]");
+        }
+#ifdef _WIN32
+        if(db.empty())db=choose_existing_world();
+#endif
+        if(db.empty() || !std::filesystem::is_regular_file(db) || std::filesystem::file_size(db)==0)
+            throw std::runtime_error("Existing nonempty SQLite world required; no new world is created");
+        const std::filesystem::path viewer=viewer_root(argv[0],assets);
+        for(const auto& f:{"factory.html","factory.js","factory-layout.js","factory-live.js"})
+            if(!std::filesystem::is_regular_file(viewer/f))throw std::runtime_error(std::string("Missing viewer asset: ")+f);
+        Server game(db,site.empty()?0:number(site));
+#ifdef _WIN32
+        WSADATA wsa{};if(WSAStartup(MAKEWORD(2,2),&wsa))throw std::runtime_error("Winsock startup failed");
+#else
+        signal(SIGPIPE,SIG_IGN);
+#endif
+        SocketGuard listener(socket(AF_INET,SOCK_STREAM,0));
+        if(listener.value==invalid_socket)throw std::runtime_error("Local socket create failed");
+#ifdef _WIN32
+        BOOL only_this_process=TRUE;
+        if(setsockopt(listener.value,SOL_SOCKET,SO_EXCLUSIVEADDRUSE,reinterpret_cast<const char*>(&only_this_process),sizeof(only_this_process))!=0)
+            throw std::runtime_error("Exclusive socket ownership unavailable");
+#else
+        fcntl(listener.value,F_SETFD,FD_CLOEXEC);
+#endif
+        sockaddr_in address{};address.sin_family=AF_INET;address.sin_port=0;address.sin_addr.s_addr=htonl(INADDR_LOOPBACK);
+        if(bind(listener.value,reinterpret_cast<const sockaddr*>(&address),sizeof(address))!=0||listen(listener.value,8)!=0)
+            throw std::runtime_error("Local socket bind/listen failed");
+#ifdef _WIN32
+        int n=sizeof(address);
+#else
+        socklen_t n=sizeof(address);
+#endif
+        if(getsockname(listener.value,reinterpret_cast<sockaddr*>(&address),&n)!=0)
+            throw std::runtime_error("Local socket name failed");
+        const std::string origin="http://127.0.0.1:"+std::to_string(ntohs(address.sin_port));
+        const std::string secret=hex_secret();
+        const std::string url=origin+"/session/"+secret+"/factory.html";
+        std::cout<<"SG_FACTORY_URL="<<url<<"\nFACTORY_WORLD="<<std::filesystem::absolute(db).string()<<"\n"<<std::flush;
+        if(open_browser)launch_browser(url);
+        while(true){
+            SocketGuard client(accept(listener.value,nullptr,nullptr));
+            if(client.value==invalid_socket)continue;
+            timeouts(client.value);
+            try{handle_connection(client.value,game,secret,origin,viewer);}catch(const std::exception& e){std::cerr<<"Local request error: "<<e.what()<<'\n';}
+        }
+#ifdef _WIN32
+        WSACleanup();
+#endif
+    }catch(const std::exception& e){std::cerr<<"Factory native host refused startup: "<<e.what()<<'\n';return 1;}
+}
diff --git a/tests/ECON02B2d4c3NativeHostTests.cjs b/tests/ECON02B2d4c3NativeHostTests.cjs
