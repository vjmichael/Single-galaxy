+    for(unsigned char c:s){
+        if(c=='"'||c=='\\'){out+='\\';out+=static_cast<char>(c);}
+        else if(c=='\n')out+="\\n";
+        else if(c=='\r')out+="\\r";
+        else if(c=='\t')out+="\\t";
+        else if(c<32){out+="\\u00";out+=hex[c>>4];out+=hex[c&15];}
+        else out+=static_cast<char>(c);
+    }
+    return out+'"';
