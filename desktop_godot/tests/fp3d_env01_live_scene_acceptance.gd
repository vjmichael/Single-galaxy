extends SceneTree
## FP3D-ENV-01E: real C++ child process + SQLite + Godot scene in ONE
## Windows/Linux execution. No fabricated ROCK/SHIP frames are injected.
## This checks scene graph, camera, model and native contact; headless CI
## cannot establish human-visible rendered pixels or driver/GPU acceptance.
const MAIN := preload("res://world/main.gd")
const NATIVE_SHIP := preload("res://world/native_player_session.gd")
const COLLISION_RADIUS_M := 15.201 # 10m original rock + 5.2m greybox ship + 1mm skin.
var _game
var _ship_frames: Array[Dictionary] = []
var _rock_frames: Array[Dictionary] = []
var _error := ""
var _visual_dir := ""
var _visual_records: Array[Dictionary] = []

# When SG_FP3D_VISUAL_CAPTURE_DIR is set this is a real WINDOWED-render
# acceptance, never an offscreen mock image. Screenshots are generated by
# Godot's running viewport and bound to same-tick original C++ observations.
func _capture_visible(stage: String, ship: Dictionary, rock: Dictionary = {}) -> void:
	if _visual_dir.is_empty() or not _error.is_empty():
		return
	if DisplayServer.get_name().to_lower() == "headless":
		_fail("visible acceptance attempted with headless Godot display")
		return
	await RenderingServer.frame_post_draw
	var frame: Image = root.get_texture().get_image()
	if frame == null or frame.is_empty() or frame.get_width() < 640 or frame.get_height() < 360:
		_fail("Godot window has no real usable rendered viewport for " + stage)
		return
	var samples := {}
	var xstep := maxi(1, int(frame.get_width() / 32))
	var ystep := maxi(1, int(frame.get_height() / 18))
	for y in range(0, frame.get_height(), ystep):
		for x in range(0, frame.get_width(), xstep):
			var c: Color = frame.get_pixel(x, y)
			var rgb := "%d:%d:%d" % [roundi(c.r * 255.0), roundi(c.g * 255.0), roundi(c.b * 255.0)]
			samples[rgb] = true
	if samples.size() < 4:
		_fail("Godot viewport contains fewer than four sampled colors at " + stage)
		return
	var filename := stage + ".png"
	var absolute := _visual_dir.path_join(filename)
	if frame.save_png(absolute) != OK or not FileAccess.file_exists(absolute):
		_fail("Godot window image could not be written at " + stage)
		return
	var digest := FileAccess.get_sha256(absolute)
	if digest.length() != 64:
		_fail("visible frame has no verifiable SHA-256")
		return
	_visual_records.append({
		"stage":stage, "png":filename, "sha256":digest,
		"image_width":frame.get_width(), "image_height":frame.get_height(),
		"sampled_color_count":samples.size(), "display_backend":DisplayServer.get_name(),
		"source":"Godot frame_post_draw + original C++ SHIP/ROCK",
		"ship":ship.duplicate(true), "rock":rock.duplicate(true),
		"camera_current":_game.exterior_camera.current,
		"player_camera_current":_game.player.camera.current
	})

func _save_visible_manifest() -> void:
	if _visual_dir.is_empty() or not _error.is_empty():
		return
	if _visual_records.size() != 4:
		_fail("windowed acceptance missing required dock/exterior/impact/restart frames")
		return
	var distinct := {}
	for item in _visual_records:
		distinct[str(item["sha256"])] = true
	if distinct.size() < 3:
		_fail("Godot submitted duplicated/unchanged window images")
		return
	var dest := _visual_dir.path_join("windowed-evidence.json")
	var file := FileAccess.open(dest, FileAccess.WRITE)
	if file == null:
		_fail("Cannot create visible Godot evidence manifest")
		return
	file.store_string(JSON.stringify({
		"schema":"SG-FP3D-WINDOW-01",
		"result":"automated-windowed-render-and-native-restart-verified",
		"human_gpu_visual_approval":false,
		"source":"native SQLite and genuine Godot window frame_post_draw",
		"frames":_visual_records
	}, "\t") + "\n")
	file.close()


func _initialize() -> void:
	call_deferred("_run")

func _fail(reason: String) -> void:
	_error = reason
	push_error("FP3D-ENV-01E live scene: " + reason)

func _await_condition(predicate: Callable, timeout_ms: int = 9000) -> bool:
	var start := Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < timeout_ms:
		if predicate.call():
			return true
		await create_timer(0.04).timeout
	return false

func _poll_native() -> bool:
	if not is_instance_valid(_game):
		return false
	if _game.native_player_session == null:
		return false
	_game.native_player_session.poll()
	return true

func _native_ready() -> bool:
	_poll_native()
	var n = _game.native_player_session
	return n._active and n._session > 0 and n._initial_ship_seen and n._last_contact_request == 0

func _seat_ready() -> bool:
	_poll_native()
	var n = _game.native_player_session
	return n._active and n._pending == 0 and n._seated and n._seat_sequence == 1

func _undocked() -> bool:
	_poll_native()
	var n = _game.native_player_session
	return n._active and n._pending == 0 and n._dock_state == 0

func _docked() -> bool:
	_poll_native()
	var n = _game.native_player_session
	return n._active and n._pending == 0 and n._dock_state == 1

func _flight_done() -> bool:
	_poll_native()
	var n = _game.native_player_session
	return not n._active or n._pending == 0

func _on_ship(frame: Dictionary) -> void:
	_ship_frames.append(frame.duplicate(true))

func _on_rock(frame: Dictionary) -> void:
	_rock_frames.append(frame.duplicate(true))

func _submit_visible_cursor_keyboard_flight(action: String, expected: String) -> bool:
	# Real Godot InputMap -> player intent collector -> main scene handler ->
	# SGDX supervised original C++ pipe; the game may NOT write ship physics.
	# Headless CI cannot simulate a genuine focused Windows window. That
	# human/driver gate remains independent even if this native path passes.
	if not is_instance_valid(_game) or not is_instance_valid(_game.player):
		_fail("real Godot pilot controller was not constructed")
		return false
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	Input.action_press(action)
	var intents: PackedStringArray = _game.player._collect_native_pilot_actions()
	Input.action_release(action)
	if intents.size() != 1 or intents[0] != expected:
		_fail("released-cursor keyboard action " + action +
			" did not produce exactly one authorized " + expected + " intent: " + str(intents))
		return false
	var session = _game.native_player_session
	var before_request: int = session._next_request
	_game._on_native_ship_intents(intents)
	if session._next_request != before_request + 1 or session._pending_kind != "FLIGHT":
		_fail("Godot " + expected + " intent did not enter original supervised C++ flight pipe")
		return false
	return true

func _run() -> void:
	_visual_dir = OS.get_environment("SG_FP3D_VISUAL_CAPTURE_DIR")
	if not _visual_dir.is_empty():
		if DirAccess.make_dir_recursive_absolute(_visual_dir) != OK:
			_fail("cannot create requested Windows visible-evidence directory")
			quit(1)
			return
		if DisplayServer.get_name().to_lower() == "headless":
			_fail("non-headless acceptance requires a genuine Godot window")
			quit(1)
			return
	var path := OS.get_environment("SG_FP3D_E2E_SAVE")
	if path.is_empty() or not FileAccess.file_exists(path):
		_fail("explicit original SQLite fixture missing")
		quit(1)
		return
	_game = MAIN.new()
	root.add_child(_game)
	await process_frame
	if not is_instance_valid(_game.player) or not is_instance_valid(_game.exterior_ship_visual) or \
			not is_instance_valid(_game.exterior_camera) or not is_instance_valid(_game.native_asteroid_mesh):
		_fail("real 3D ship / camera / asteroid scene nodes absent")
		quit(1)
		return
	if _game.exterior_ship_visual.get_child_count() != 4:
		_fail("expected 8m hull, two wings and mounted third-person camera")
		quit(1)
		return
	var session = _game.native_player_session
	session.ship_state_received.connect(_on_ship)
	session.asteroid_contact_received.connect(_on_rock)
	session.start(path)
	if not (await _await_condition(Callable(self, "_native_ready"))):
		_fail("original C++ host did not deliver authenticated initial POSE, SHIP and ROCK")
	elif _rock_frames.is_empty() or _rock_frames[-1]["impact_rock"] != 0:
		_fail("initial fixture forged or replayed original collision")
	else:
		# Exercise the actual Godot admission path with a live original SGDX
		# guardian whose saved stop timestamp is deliberately over 3s old.
		# A second same-role writer must NOT even be launched.
		var live_guardian: int = session.process_id()
		var attempted_overlap = NATIVE_SHIP.new()
		attempted_overlap._last_shutdown_pid = live_guardian
		attempted_overlap._last_shutdown_msec = Time.get_ticks_msec() - 10000
		if live_guardian <= 0 or attempted_overlap.process_id() != live_guardian:
			_fail("expired SGDX PID tracking lost a still-running native guardian")
		else:
			attempted_overlap.start(path)
			if attempted_overlap.is_active():
				attempted_overlap.stop("Rejected overlapping original native writer")
				_fail("Godot launched an overlapping writer despite live SGDX custody")
		if _error.is_empty():
			session.toggle_seat()
		if not (await _await_condition(Callable(self, "_seat_ready"))):
			_fail("real owner could not seat in original cockpit")
	if _error.is_empty():
		# Honor the existing 110ms original cockpit rate gate. An immediate
		# undock after SEAT ACK is correctly ignored by the production client.
		await create_timer(0.13).timeout
		if _submit_visible_cursor_keyboard_flight("ship_undock", "UND"):
			if not (await _await_condition(Callable(self, "_undocked"))):
				_fail("original ship did not complete keyboard undock")
	if _error.is_empty():
		# Real owner must be able to return to the physically near station.
		# This is the ORIGINAL C++ docking action, not Godot teleportation.
		await create_timer(0.13).timeout
		if _submit_visible_cursor_keyboard_flight("ship_dock", "DCK"):
			if not (await _await_condition(Callable(self, "_docked"))):
				_fail("original C++ keyboard return docking near station failed")
		elif _game._last_native_dock != 1 or not _game.space_preview.visible or \
				_game.ship_space.visible or not _game.exterior_camera.current or \
				_game.player.camera.current:
			_fail("real docking exposed explorable cabin instead of fixed third-person pilot")
		else:
			# Retain artifact filename for downstream pinned-package scripts.
			# Actual rendered content is now third-person at the dock.
			await _capture_visible("01-docked-cabin", _ship_frames[-1])
	if _error.is_empty():
		await create_timer(0.13).timeout
		if _submit_visible_cursor_keyboard_flight("ship_undock", "UND"):
			if not (await _await_condition(Callable(self, "_undocked"))):
				_fail("second original keyboard launch after docking failed")
	if _error.is_empty():
		_game._external_requested = false # V is not required or effective now
		_game._show_native_location(false)
		if not _game.space_preview.visible or _game.ship_space.visible or \
				not _game.exterior_camera.current or _game.player.camera.current:
			_fail("pilot-only exterior camera did not remain active without V toggle")
		else:
			await _capture_visible("02-exterior-flight", _ship_frames[-1], _rock_frames[-1])
	var collided := false
	var previous_x := -9223372036854775807
	if _error.is_empty():
		for i in range(70):
			# The original host owns every flight STEP; this intentionally
			# does NOT call main._on_native_ship_state with synthetic data.
			await create_timer(0.13).timeout
			if not _submit_visible_cursor_keyboard_flight("ship_thrust_forward", "FWD"):
				break
			if not (await _await_condition(Callable(self, "_flight_done"))):
				_fail("native flight writer did not respond")
				break
			if not session._active or _ship_frames.is_empty() or _rock_frames.is_empty():
				_fail("native host disappeared during real flight")
				break
			var sh := _ship_frames[-1]
			var rock := _rock_frames[-1]
			var x := int(sh["x_mm"])
			if x < previous_x:
				_fail("original ship moved backward during positive thrust")
				break
			previous_x = x
			if int(rock.get("impact_rock", 0)) > 0:
				collided = true
				if int(rock["impact_tick"]) != int(sh["tick"]) or \
						int(rock["ship"]) != int(sh["ship"]) or \
						int(sh["vx"]) != 0 or int(sh["vy"]) != 0 or int(sh["vz"]) != 0:
					_fail("solid contact does not match the original committed ship tick")
					break
				if not bool(rock["found"]) or int(rock["ore_tonnes"]) <= 0:
					_fail("native original rock disappeared or mass was fabricated")
					break
				var relative_m := Vector3(float(rock["dx_mm"]),float(rock["dy_mm"]),
					float(rock["dz_mm"])).length() / 1000.0
				if relative_m < COLLISION_RADIUS_M - 0.002 or relative_m > COLLISION_RADIUS_M + 0.1:
					_fail("ship is not at the first safe original hull contact")
					break
				var relative_godot: Vector3 = MAIN.native_rock_visual_offset(rock)
				if _game.native_asteroid_mesh.position.distance_to(relative_godot) > 0.002:
					_fail("rendered asteroid does not track authoritative native delta")
					break
				if absf(_game.exterior_ship_visual.rotation.y -
						MAIN.native_heading_to_godot_yaw(int(sh["heading"]))) > 0.001:
					_fail("visual hull and camera do not follow original native yaw")
					break
				if not _game.exterior_camera.current or not _game.native_asteroid_mesh.visible:
					_fail("exterior camera or solid asteroid stopped being visible")
					break
				if not _game.asteroid_label.text.contains("ORIGINAL SOLID CONTACT"):
					_fail("original collision event not displayed by actual game HUD")
					break
				# The actual scene must derive target bearing and conservative
				# 5.2m-hull clearance only from this SAME verified ship/rock tick.
				if not is_instance_valid(_game.flight_instrument_label) or \
						not _game.flight_instrument_label.text.contains("TARGET #") or \
						not _game.flight_instrument_label.text.contains("VERIFIED IMPACT"):
					_fail("read-only pilot instrument did not join real original impact receipt")
					break
				var instrument: Dictionary = MAIN.FLIGHT_INSTRUMENTS.from_verified_frames(sh, rock)
				if instrument.is_empty() or \
						absf(float(instrument["clearance_m"])) > 0.1 or \
						absf(float(instrument["bearing_deg"])) > 5.0:
					_fail("real original-world target bearing or hull clearance is inconsistent")
					break
				await _capture_visible("03-native-rock-impact", sh, rock)
				break
	if _error.is_empty() and not collided:
		_fail("no real swept collision reached after 70 original forward commands")
	# An actual source-driven LEFT/RIGHT keyboard pair must alter the original
	# C++/SQLite heading and then restore it, even when the cursor is visible.
	# Do this only AFTER capturing verified impact, so the swept-contact gate
	# remains independent of pilot steering and retains identical physics.
	if _error.is_empty() and collided:
		var before_yaw: int = int(_ship_frames[-1]["heading"])
		await create_timer(0.13).timeout
		if _submit_visible_cursor_keyboard_flight("ship_yaw_left", "LEFT"):
			if not (await _await_condition(Callable(self, "_flight_done"))):
				_fail("native left keyboard yaw had no original C++ acknowledgement")
			elif not session._active or _ship_frames.is_empty() or \
					int(_ship_frames[-1]["outcome"]) != 0 or \
					int(_ship_frames[-1]["heading"]) != (before_yaw + 15) % 360:
				_fail("released-cursor A key did not rotate real original hull by +15 degrees")
		if _error.is_empty():
			await create_timer(0.13).timeout
			if _submit_visible_cursor_keyboard_flight("ship_yaw_right", "RIGHT"):
				if not (await _await_condition(Callable(self, "_flight_done"))):
					_fail("native right keyboard yaw had no original C++ acknowledgement")
				elif not session._active or _ship_frames.is_empty() or \
						int(_ship_frames[-1]["outcome"]) != 0 or \
						int(_ship_frames[-1]["heading"]) != before_yaw:
					_fail("released-cursor D key did not restore original C++ heading")
	var committed_ship: Dictionary = _ship_frames[-1].duplicate(true) if not _ship_frames.is_empty() else {}
	var committed_rock: Dictionary = _rock_frames[-1].duplicate(true) if not _rock_frames.is_empty() else {}
	if is_instance_valid(_game) and is_instance_valid(_game.native_player_session):
		var sgdx_pid: int = _game.native_player_session.process_id()
		_game.native_player_session.stop("SGDX-03 integrated native acceptance closed", true)
		# A clean original QUIT must let SGDX write its final private receipt.
		if sgdx_pid > 0:
			for attempt in range(80):
				if not OS.is_process_running(sgdx_pid):
					break
				await create_timer(0.05).timeout
			if OS.is_process_running(sgdx_pid) and _error.is_empty():
				_fail("SGDX supervised original host failed to release after clean QUIT")
		if _error.is_empty():
			var directory := path + ".diagnostics"
			var found_real_receipt := false
			if DirAccess.dir_exists_absolute(directory):
				for file_name in DirAccess.get_files_at(directory):
					if not file_name.begins_with("process-") or not file_name.ends_with(".json"):
						continue
					var record = JSON.parse_string(FileAccess.get_file_as_string(
						directory.path_join(file_name)))
					if record is Dictionary and record.get("role", "") == "godot_ship" and \
							record.get("reason", "") == "clean_exit":
						found_real_receipt = true
						break
			if not found_real_receipt:
				_fail("Godot bypassed SGDX or clean original process evidence missing")
	# Reopen the SAME original SQLite world through a NEW real SGDX guardian.
	# The committed collision pose, finite rock and ore stock must be identical.
	# Reconnect's initial ROCK frame must NOT replay the old impact.
	if _error.is_empty() and not committed_ship.is_empty() and not committed_rock.is_empty():
		var restored = NATIVE_SHIP.new()
		restored.pose_received.connect(_game._on_native_player_pose)
		restored.ship_state_received.connect(_game._on_native_ship_state)
		restored.asteroid_contact_received.connect(_game._on_native_asteroid_contact)
		restored.connection_changed.connect(_game._on_native_player_connection)
		restored.status_changed.connect(_game._on_native_player_status)
		restored.ship_state_received.connect(_on_ship)
		restored.asteroid_contact_received.connect(_on_rock)
		_game.native_player_session = restored
		restored.start(path)
		if not (await _await_condition(Callable(self, "_native_ready"))):
			_fail("real SGDX restart did not recover original POSE, SHIP and ROCK")
		else:
			var resumed_ship := _ship_frames[-1]
			var resumed_rock := _rock_frames[-1]
			for name in ["ship", "tick", "gen", "x_mm", "y_mm", "z_mm", "vx", "vy", "vz", "dock"]:
				if int(resumed_ship[name]) != int(committed_ship[name]):
					_fail("SQLite restart changed authoritative ship field " + name)
					break
			if _error.is_empty() and (not bool(resumed_rock["found"]) or
					int(resumed_rock["rock"]) != int(committed_rock["rock"]) or
					int(resumed_rock["ore_tonnes"]) != int(committed_rock["ore_tonnes"]) or
					int(resumed_rock["cargo_tonnes"]) != int(committed_rock["cargo_tonnes"]) or
					int(resumed_rock["impact_rock"]) != 0):
				_fail("SQLite restart changed finite original asteroid/cargo or replayed collision")
			if _error.is_empty():
				_game._external_requested = false
				_game._show_native_location(false)
				if not _game.exterior_camera.current or not _game.native_asteroid_mesh.visible:
					_fail("actual Godot camera/asteroid failed after native restart")
				else:
					await _capture_visible("04-restarted-world", resumed_ship, resumed_rock)
		var restored_pid: int = restored.process_id()
		if restored.is_active():
			restored.stop("SGDX-03 native restart acceptance finished", true)
		if restored_pid > 0:
			for attempt in range(80):
				if not OS.is_process_running(restored_pid):
					break
				await create_timer(0.05).timeout
			if OS.is_process_running(restored_pid) and _error.is_empty():
				_fail("restarted SGDX guardian failed to release SQLite writer")
	if _error.is_empty():
		_save_visible_manifest()
	await process_frame
	if not _error.is_empty():
		quit(1)
	else:
		print("FP3D-UX-05 LIVE GODOT/C++ PASS: visible-cursor keyboard U/G/UP/A/D through game InputMap, SGDX native SHIP receipts, exact yaw, undock/redock, swept contact and SAME SQLite restart; physical Windows focus/GPU still separate")
		quit(0)
